    (((gaussian_pow_integrable k).const_mul (4 / 3 : ℝ)).add
      ((gaussian_pow_integrable (k + 1)).const_mul (1 / 2 : ℝ)))
    ((gaussian_pow_integrable (k + 2)).const_mul (1 / 3 : ℝ))
  simp only [Pi.add_apply] at hsub
  rw [heq, hsub,
    integral_add ((gaussian_pow_integrable k).const_mul (4 / 3 : ℝ))
      ((gaussian_pow_integrable (k + 1)).const_mul (1 / 2 : ℝ))]
  simp only [integral_const_mul]

