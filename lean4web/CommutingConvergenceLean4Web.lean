/-! Dimension-free inserted-Gram control in a singular-value basis.
The final bound has the exact 3/4 constant in the public matrix input M1.
Transport from an arbitrary rectangular Gram to this basis remains separate. -/

open Matrix
open scoped BigOperators Matrix.Norms.L2Operator

namespace CommutingConvergence

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- A column's Euclidean energy is bounded by the squared operator norm. -/
theorem matrix_column_sq_le_opNorm_sq (C : Matrix n n ℂ) (j : n) :
    (∑ i, ‖C i j‖ ^ 2) ≤ ‖C‖ ^ 2 := by
  have h := Matrix.l2_opNorm_mulVec C (PiLp.single 2 j (1 : ℂ))
  have hs : ‖(PiLp.single 2 j (1 : ℂ) : EuclideanSpace ℂ n)‖ = 1 := by simp
  rw [hs, mul_one] at h
  have hsq := pow_le_pow_left₀ (norm_nonneg _) h 2
  simpa [EuclideanSpace.norm_sq_eq, Matrix.mulVec_single, PiLp.single_apply] using hsq

/-- The row bound follows from the column bound for the adjoint. -/
theorem matrix_row_sq_le_opNorm_sq (C : Matrix n n ℂ) (i : n) :
    (∑ j, ‖C i j‖ ^ 2) ≤ ‖C‖ ^ 2 := by
  simpa [Matrix.conjTranspose_apply, Matrix.l2_opNorm_conjTranspose] using
    matrix_column_sq_le_opNorm_sq Cᴴ i

/-- Entrywise insertion bound using only row and column energy estimates. -/
theorem diagonal_insertion_bound_of_rows_cols (a : n → ℝ) (ha : ∀ i, 0 ≤ a i)
    (C : Matrix n n ℂ) (L : ℝ)
    (hrow : ∀ i, (∑ j, ‖C i j‖ ^ 2) ≤ L ^ 2)
    (hcol : ∀ j, (∑ i, ‖C i j‖ ^ 2) ≤ L ^ 2) :
    diagonalHessianCost a
      (Matrix.diagonal (fun i ↦ (a i : ℂ)) * C * Matrix.diagonal (fun i ↦ (a i : ℂ))) ≤
      (3 / 4 : ℝ) * L ^ 2 * ∑ i, a i ^ 3 := by
  have hentry (i j : n) :
      ‖(Matrix.diagonal (fun i ↦ (a i : ℂ)) * C *
          Matrix.diagonal (fun i ↦ (a i : ℂ))) i j‖ ^ 2 / (a i + a j) ≤
        ((a i ^ 3 + a j ^ 3) / 4) * ‖C i j‖ ^ 2 := by
    simp only [Matrix.mul_diagonal, Matrix.diagonal_mul, norm_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (ha i), abs_of_nonneg (ha j)]
    calc
      (a i * ‖C i j‖ * a j) ^ 2 / (a i + a j)
          = (a i ^ 2 * a j ^ 2 / (a i + a j)) * ‖C i j‖ ^ 2 := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right
        (sylvester_scalar_weight_le _ _ (ha i) (ha j)) (sq_nonneg _)
  have hsum : (∑ i, ∑ j, ((a i ^ 3 + a j ^ 3) / 4) * ‖C i j‖ ^ 2) =
      ((∑ i, a i ^ 3 * ∑ j, ‖C i j‖ ^ 2) +
        (∑ j, a j ^ 3 * ∑ i, ‖C i j‖ ^ 2)) / 4 := by
    simp_rw [add_div, add_mul, div_mul_eq_mul_div, Finset.sum_add_distrib,
      ← Finset.sum_div, ← Finset.mul_sum]
    rw [Finset.sum_comm (f := fun i j ↦ a j ^ 3 * ‖C i j‖ ^ 2)]
    simp only [← Finset.mul_sum]
  have hr : (∑ i, a i ^ 3 * ∑ j, ‖C i j‖ ^ 2) ≤ L ^ 2 * ∑ i, a i ^ 3 := by
    calc
      _ ≤ ∑ i, a i ^ 3 * L ^ 2 := Finset.sum_le_sum fun i _ ↦
        mul_le_mul_of_nonneg_left (hrow i) (pow_nonneg (ha i) 3)
      _ = _ := by rw [← Finset.sum_mul]; ring
  have hc : (∑ j, a j ^ 3 * ∑ i, ‖C i j‖ ^ 2) ≤ L ^ 2 * ∑ i, a i ^ 3 := by
    calc
      _ ≤ ∑ j, a j ^ 3 * L ^ 2 := Finset.sum_le_sum fun j _ ↦
        mul_le_mul_of_nonneg_left (hcol j) (pow_nonneg (ha j) 3)
      _ = _ := by rw [← Finset.sum_mul]; ring
  unfold diagonalHessianCost
  calc
    _ ≤ (3 / 2 : ℝ) * ∑ i, ∑ j, ((a i ^ 3 + a j ^ 3) / 4) * ‖C i j‖ ^ 2 := by
      exact mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum fun i _ ↦ Finset.sum_le_sum fun j _ ↦ hentry i j) (by norm_num)
    _ ≤ _ := by rw [hsum]; linarith

/-- M1's inserted-cost bound in a singular-value basis, with no dimension-dependent factor.
Hermitian symmetry is unnecessary for this scalar inequality. -/
theorem diagonal_insertion_bound (a : n → ℝ) (ha : ∀ i, 0 ≤ a i)
    (C : Matrix n n ℂ) :
    diagonalHessianCost a
      (Matrix.diagonal (fun i ↦ (a i : ℂ)) * C * Matrix.diagonal (fun i ↦ (a i : ℂ))) ≤
      (3 / 4 : ℝ) * ‖C‖ ^ 2 * ∑ i, a i ^ 3 :=
  diagonal_insertion_bound_of_rows_cols a ha C ‖C‖
    (matrix_row_sq_le_opNorm_sq C) (matrix_column_sq_le_opNorm_sq C)

end CommutingConvergence
end OriginalModule54


