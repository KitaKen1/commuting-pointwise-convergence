    · subst j
      rcases lt_trichotomy i k with hik|hik|hik
      · simp [hik,hik.ne,hik.ne',not_lt_of_ge hik.le]
      · subst k; simp
      · simp [hik,hik.ne,hik.ne',not_lt_of_ge hik.le]
    · rcases lt_trichotomy j k with hjk|hjk|hjk
      · simp [hij,hjk,hij.ne',hjk.ne,not_lt_of_ge hij.le,not_lt_of_ge hjk.le]
      · subst k; simp [hij,hij.ne,hij.ne',not_lt_of_ge hij.le]
      · have hki := hjk.trans hij
