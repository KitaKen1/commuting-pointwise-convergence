    _ = ∑ i,∑ j,((if i=j then w i j else 0)+
        (if i < j then w i j else 0)+(if j < i then w i j else 0)) :=
      Finset.sum_congr rfl fun i _ ↦ Finset.sum_congr rfl fun j _ ↦ hs i j
