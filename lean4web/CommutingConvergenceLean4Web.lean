namespace CommutingConvergence

noncomputable def truncatedKernel (K : ℝ → ℝ) (R : ℝ) : ℝ → ℝ :=
  (Icc (-R) R).indicator K

theorem truncatedKernel_eq_zero (K : ℝ → ℝ) (R t : ℝ) (ht : R < |t|) :
    truncatedKernel K R t = 0 := by
  apply indicator_of_notMem
  simpa only [mem_Icc, ← abs_le] using not_le.mpr ht

theorem integrable_truncatedKernel (K : ℝ → ℝ) (hK : Integrable K) (R : ℝ) :
    Integrable (truncatedKernel K R) := hK.indicator measurableSet_Icc

theorem norm_sub_truncatedKernel_le (K : ℝ → ℝ) (R t : ℝ) :
    ‖K t - truncatedKernel K R t‖ ≤ ‖K t‖ := by
  by_cases ht : t ∈ Icc (-R) R
  · simp [truncatedKernel, indicator_of_mem ht]
  · simp [truncatedKernel, indicator_of_notMem ht]

/-- Every integrable real kernel admits symmetric compact truncations with vanishing L1 error. -/
theorem truncatedKernel_l1_tendsto (K : ℝ → ℝ) (hK : Integrable K) :
    Tendsto (fun n : ℕ ↦ ∫ t, ‖K t - truncatedKernel K n t‖) atTop (𝓝 0) := by
  have ht := tendsto_integral_of_dominated_convergence
    (F := fun n : ℕ ↦ fun t : ℝ ↦ ‖K t - truncatedKernel K n t‖)
    (f := fun _ : ℝ ↦ (0 : ℝ)) (fun t ↦ ‖K t‖)
    (fun n ↦ (hK.aestronglyMeasurable.sub (integrable_truncatedKernel K hK n).aestronglyMeasurable).norm)
    hK.norm
    (fun n ↦ ae_of_all _ fun t ↦ by
      rw [Real.norm_of_nonneg (norm_nonneg _)]
      exact norm_sub_truncatedKernel_le K n t)
    (ae_of_all _ fun t ↦ by
      apply tendsto_const_nhds.congr'
      obtain ⟨N, hN⟩ := exists_nat_ge |t|
      filter_upwards [eventually_ge_atTop N] with n hn
      have hm : t ∈ Icc (-(n : ℝ)) n := abs_le.mp (hN.trans (by exact_mod_cast hn))
      simp [truncatedKernel, indicator_of_mem hm])
  simpa using ht

/-- The same tail error controls every scale and every bounded input. -/
theorem kernelPairing_truncation_dist_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (K : ℝ → ℝ) (hK : Integrable K)
    (R : ℝ) (F : ℝ → E) (C : ℝ) (hF : AEStronglyMeasurable F volume)
    (hbound : ∀ᵐ t, ‖F t‖ ≤ C) :
    dist (kernelPairing volume K F) (kernelPairing volume (truncatedKernel K R) F) ≤
      (∫ t, ‖K t - truncatedKernel K R t‖) * C :=
  kernelPairing_dist_le volume K _ F C hK (integrable_truncatedKernel K hK R) hF hbound

