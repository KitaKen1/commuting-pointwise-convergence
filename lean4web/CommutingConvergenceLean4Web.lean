    ae_all_iff.mpr fun n ↦ (hT.iterate n).quasiMeasurePreserving.ae hf
  have hg_all : ∀ᵐ x ∂μ, ∀ n : ℕ, g (S^[n] x) = g' (S^[n] x) :=
    ae_all_iff.mpr fun n ↦ (hS.iterate n).quasiMeasurePreserving.ae hg
