      (if j < k then if j < i then w i j k else 0 else 0)+
      (if k < i then if k < j then w i j k else 0 else 0)+
      (if i=j then if i < k then w i j k else 0 else 0)+
      (if j=k then if j < i then w i j k else 0 else 0)+
