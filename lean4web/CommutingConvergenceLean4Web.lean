/-! Actual pure heat identities for a selected Gaussian block with all other
positive weights fixed. The original column energy uses the adjoint Gram.
Mixed block-center derivatives and the joint variance curve are separate. -/

open Matrix Filter Set
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator Topology

namespace CommutingConvergence

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

noncomputable section

@[instance_reducible] local instance selectedGaussianHeatAddCommGroup : AddCommGroup (Matrix n n ℂ) :=
  (inferInstance : NormedAddCommGroup (Matrix n n ℂ)).toAddCommGroup
@[instance_reducible] local instance selectedGaussianHeatRealModule : Module ℝ (Matrix n n ℂ) :=
  (inferInstance : NormedSpace ℝ (Matrix n n ℂ)).toModule
@[instance_reducible] local instance selectedGaussianHeatTopology : TopologicalSpace (Matrix n n ℂ) :=
  (inferInstance : MetricSpace (Matrix n n ℂ)).toPseudoMetricSpace.toUniformSpace.toTopologicalSpace

def selectedGaussianWeights (h σ : ℝ) (u : m → ℝ) (active : m → Bool) (fixed : m → ℝ) (p : ℝ) : m → ℝ :=
  fun i ↦ if active i = true then h * gaussianHeatDensity σ (u i) p else fixed i

def selectedGaussianFirstWeights (h σ : ℝ) (u : m → ℝ) (active : m → Bool) (_fixed : m → ℝ) (p : ℝ) : m → ℝ :=
  fun i ↦ if active i = true then h * (gaussianHeatScore σ (u i) p * gaussianHeatDensity σ (u i) p) else 0

def selectedGaussianSecondWeights (h σ : ℝ) (u : m → ℝ) (active : m → Bool) (_fixed : m → ℝ) (p : ℝ) : m → ℝ :=
  fun i ↦ if active i = true then h * (gaussianHeatAcceleration σ (u i) p * gaussianHeatDensity σ (u i) p) else 0

def selectedGaussianGram (R : Matrix m n ℂ) (h σ : ℝ) (u : m → ℝ) (active : m → Bool) (fixed : m → ℝ) (p : ℝ) :
    Matrix n n ℂ := densityGram R (selectedGaussianWeights h σ u active fixed p)

def selectedGaussianGramFirst (R : Matrix m n ℂ) (h σ : ℝ) (u : m → ℝ) (active : m → Bool) (fixed : m → ℝ) (p : ℝ) :
    Matrix n n ℂ := densityGram R (selectedGaussianFirstWeights h σ u active fixed p)

def selectedGaussianGramSecond (R : Matrix m n ℂ) (h σ : ℝ) (u : m → ℝ) (active : m → Bool) (fixed : m → ℝ) (p : ℝ) :
    Matrix n n ℂ := densityGram R (selectedGaussianSecondWeights h σ u active fixed p)

def selectedGaussianEnergy (R : Matrix m n ℂ) (h σ : ℝ) (u : m → ℝ) (active : m → Bool) (fixed : m → ℝ) (p : ℝ) : ℝ :=
  (Matrix.trace (CFC.rpow (selectedGaussianGram R h σ u active fixed p) (3 / 2 : ℝ))).re

omit [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n] in
theorem selectedGaussianWeights_pos (h σ : ℝ) (u : m → ℝ) (active : m → Bool)
    (fixed : m → ℝ) (p : ℝ) (hh : 0 < h) (hσ : 0 < σ) (hfixed : ∀ i, 0 < fixed i)
    (i : m) : 0 < selectedGaussianWeights h σ u active fixed p i := by
  by_cases hi : active i = true
  · simp only [selectedGaussianWeights, hi, if_true]
    exact mul_pos hh (gaussianHeatDensity_pos σ (u i) p hσ)
  · simp only [selectedGaussianWeights, hi]
    exact hfixed i

omit [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n] in
theorem selectedGaussianWeights_nonneg (h σ : ℝ) (u : m → ℝ) (active : m → Bool)
    (fixed : m → ℝ) (p : ℝ) (hh : 0 ≤ h) (hfixed : ∀ i, 0 ≤ fixed i)
    (i : m) : 0 ≤ selectedGaussianWeights h σ u active fixed p i := by
  by_cases hi : active i = true
  · simp only [selectedGaussianWeights, hi, if_true]
    exact mul_nonneg hh (gaussianHeatDensity_nonneg σ (u i) p)
