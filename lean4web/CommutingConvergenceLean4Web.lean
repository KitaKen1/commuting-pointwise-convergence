    (Matrix.fromCols A B₁) (Matrix.fromCols A B) (hdom B₀ h₀) (hdom B₁ h₁)
  change |rectangularCubicEnergy (Matrix.fromCols A B₁) - rectangularCubicEnergy (Matrix.fromCols A B₀)| ≤ _ at he
  simp only [Fintype.sum_sum_type, Matrix.sub_apply, Matrix.fromCols_apply_inl,
    Matrix.fromCols_apply_inr, sub_self, norm_zero, mul_zero, Finset.sum_const_zero,
    zero_add, matrixColL2_fromCols_inr] at he
  apply he.trans
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  apply Finset.sum_le_sum
  intro i _
  apply Finset.sum_le_sum
  intro j _
  apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
  exact mul_le_mul_of_nonneg_right (matrixRowL2_fromCols_le A B i) (Real.sqrt_nonneg _)

