  rw [hg]

def gaussianWindowRatioBound (r : ℕ) : ℝ :=
  Classical.choose (gaussianDerivativeWindow_ratio_bounded r)

theorem gaussianWindowRatioBound_nonneg (r : ℕ) : 0 ≤ gaussianWindowRatioBound r :=
  (Classical.choose_spec (gaussianDerivativeWindow_ratio_bounded r)).1

theorem gaussianWindowRatio_abs_le (r : ℕ) (L u x : ℝ) (hL : 0 < L) :
    |gaussianWindowRatio r L u x| ≤ gaussianWindowRatioBound r := by
