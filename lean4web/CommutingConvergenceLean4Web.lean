    rcases lt_trichotomy i j with h|h|h
    · simp [h,h.ne,not_lt_of_ge h.le]
    · subst j; simp
    · simp [h,h.ne',not_lt_of_ge h.le]
  have hl : (∑ i,∑ j,if j < i then w i j else 0) =
      ∑ i,∑ j,if i < j then w i j else 0 := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [hw j i]
