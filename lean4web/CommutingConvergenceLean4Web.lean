  ext i j
  have hc : P *ᵥ (fun k ↦ E k j) = 0 := by
    ext k
    exact congrFun (congrFun hPE k) j
  exact congrFun ((matrix_sqrt_mulVec_eq_zero_iff P hP _).mpr hc) i

theorem matrix_sqrt_annihilate (P E : Matrix n n ℂ) (hP : P.PosSemidef)
    (hE : E.IsHermitian) (hPE : P * E = 0) :
    CFC.sqrt P * E = 0 ∧ E * CFC.sqrt P = 0 := by
  have h := matrix_sqrt_mul_zero P E hP hPE
  refine ⟨h, ?_⟩
  have hs := congrArg Matrix.conjTranspose h
  simpa only [Matrix.conjTranspose_mul, hE.eq,
    (CFC.sqrt_nonneg P).posSemidef.isHermitian.eq, Matrix.conjTranspose_zero] using hs

