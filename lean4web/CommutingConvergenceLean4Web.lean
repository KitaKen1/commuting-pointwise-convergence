      (3 / 4 : ℝ) * ‖L‖ ^ 2 * gramRootEnergy (Rᴴ * R) := by
  let A := CFC.sqrt (Rᴴ * R)
  have hA : A.PosSemidef := (CFC.sqrt_nonneg (Rᴴ * R)).posSemidef
  let U := hA.isHermitian.eigenvectorUnitary
  let a := hA.isHermitian.eigenvalues
