    (r : ℕ) (L b : ℝ) (hr : 2 ≤ r) (hL : 0 < L) :
    (∫ y, (∫ x, gaussianDerivativeWindow 1 L x * gaussianDerivativeWindow 1 L (y - x)) *
      gaussianDerivativeWindow (r - 2) L (b - y)) =
      L ^ r * iteratedDeriv r (gaussianHeatDensity (L ^ 2) 0) b := by
  simpa only [show 1 + 1 + (r - 2) = r by omega] using
    gaussianDerivativeWindow_triple_convolution 1 1 (r - 2) L b hL

