  have hrhi : r (S.card-1) = hi := (hagree _ (by omega)).trans hehi
  refine ⟨r, S.card-2, hr, hrlo, ?_, ?_⟩
  · have he : S.card-2+1 = S.card-1 := by omega
    simpa only [he] using hrhi
  · intro k hk x hx hxin
    have hk' : k+1 < S.card := by simp only [Finset.mem_range] at hk; omega
    have hk0 : k < S.card := by omega
    have hxwindow : x ∈ Ioo lo hi := by
      constructor
      · rw [← hrlo]
        exact lt_of_le_of_lt (hr.monotone (Nat.zero_le k)) hxin.1
      · rw [← hrhi]
        exact lt_of_lt_of_le hxin.2 (hr.monotone (by omega))
    have hxS : x ∈ S := Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
      (Finset.mem_filter.mpr ⟨hx, hxwindow⟩))
