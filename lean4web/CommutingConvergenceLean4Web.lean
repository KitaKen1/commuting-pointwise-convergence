  have h := matrix_weighted_row_sum_sq_le D i s a
  have ht : (q^2*b*|∑ j ∈ s,a j*‖D i j‖^2|)^2 ≤
      ‖D‖^2*(q^3*b^2)*(q*E) := by
    calc
      _ = q^4*b^2*(∑ j ∈ s,a j*‖D i j‖^2)^2 := by rw [mul_pow,mul_pow,sq_abs]; ring
      _ ≤ q^4*b^2*(‖D‖^2*E) := mul_le_mul_of_nonneg_left h (by positivity)
