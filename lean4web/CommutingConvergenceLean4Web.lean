/-! Bochner integration of a finite weighted Gram is integration of its real
row densities through one continuous linear map. The matrix norm here is the
operator norm, including singular arrays and empty finite index types. -/

open Matrix MeasureTheory
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator

namespace CommutingConvergence

variable {m n Ω : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]
  [MeasurableSpace Ω]

noncomputable section

theorem densityGram_real_smul (R : Matrix m n ℂ) (c : ℝ) (w : m → ℝ) :
    densityGram R (fun i ↦ c * w i) = c • densityGram R w := by
  exact (densityGramCLM R).map_smul c w

theorem densityGram_integrable (μ : Measure Ω) (R : Matrix m n ℂ)
    (w : Ω → m → ℝ) (hw : ∀ i, Integrable (fun ω ↦ w ω i) μ) :
    Integrable (fun ω ↦ densityGram R (w ω)) μ :=
  (densityGramCLM R).integrable_comp (Integrable.of_eval hw)

theorem densityGram_integral (μ : Measure Ω) (R : Matrix m n ℂ)
    (w : Ω → m → ℝ) (hw : ∀ i, Integrable (fun ω ↦ w ω i) μ) :
    (∫ ω, densityGram R (w ω) ∂μ) = densityGram R (fun i ↦ ∫ ω, w ω i ∂μ) := by
  change (∫ ω, (densityGramCLM R) (w ω) ∂μ) =
    (densityGramCLM R) (fun i ↦ ∫ ω, w ω i ∂μ)
  rw [(densityGramCLM R).integral_comp_comm (Integrable.of_eval hw)]
  congr 1
  funext i
  exact eval_integral hw i

end

end CommutingConvergence
