variable {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]
  [DecidableEq m] [DecidableEq n] [DecidableEq p]

def gaussianWindowInsertion (r : ℕ) (L : ℝ) (u : m → ℝ) (x : ℝ) : Matrix m m ℂ :=
  Matrix.diagonal (fun i ↦ (gaussianWindowRatio r L (u i) x : ℂ))

def gaussianCyclicEdge (h L : ℝ) (u : m → ℝ) (v : n → ℝ) (x y : ℝ)
    (A : Matrix m n ℂ) : Matrix m n ℂ :=
  vertexWeightedEdge (fun i ↦ h * gaussianHeatDensity (L ^ 2) (u i) x)
    (fun j ↦ h * gaussianHeatDensity (L ^ 2) (v j) y) A

def gaussianInsertedCyclicTrace (a b c : ℕ) (h L : ℝ)
    (u : m → ℝ) (v : n → ℝ) (w : p → ℝ) (x y z : ℝ)
