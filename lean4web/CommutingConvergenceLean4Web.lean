/-! Uniform quadratic Gaussian majorants survive both other coordinate charts.
The variance in the envelope is enlarged by four; this bound is for dominated
calculus, not a dimension-free energy estimate. -/
open MeasureTheory
namespace CommutingConvergence
noncomputable section

theorem gaussianPlaneDecay_swap_bound (hi x y d D : ℝ) (hhi : 0 < hi)
    (hd : |d| ≤ D) :
    gaussianPlaneDecay hi x (d - x - y) ≤
      gaussianPlaneOffsetFactor (4 * hi) D * gaussianPlaneDecay (4 * hi) x y := by
  have hp := gaussian_plane_pair_square_bound x y d D hd
  unfold gaussianPlaneDecay gaussianPlaneOffsetFactor
  rw [← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have he := div_le_div_of_nonneg_right
    (show -(4 * (x ^ 2 + (d - x - y) ^ 2)) ≤ 3 * D ^ 2 - (x ^ 2 + y ^ 2) by linarith)
    (show 0 ≤ 64 * hi by positivity)
  convert he using 1 <;> first | rfl | ring

theorem gaussianPlanePolynomial_swap_bound (lo K x y d D : ℝ)
    (hlo : 0 < lo) (hK : 0 ≤ K) (hd : |d| ≤ D) :
    gaussianPlanePolynomial lo K x (d - x - y) ≤
      4 * gaussianPlanePolynomial lo (K + D) x y := by
  have hD : 0 ≤ D := (abs_nonneg d).trans hd
  have hab := gaussian_plane_offset_abs_le x y d D hd
  have hnum : K + |x| + |d - x - y| ≤ 2 * (K + D + |x| + |y|) := by
    have := abs_nonneg x
    have := abs_nonneg y
    linarith
  have hdiv := div_le_div_of_nonneg_right hnum hlo.le
  rw [mul_div_assoc] at hdiv
  have ha : 0 ≤ (K + |x| + |d - x - y|) / lo := by positivity
  have hs := mul_self_le_mul_self ha hdiv
  unfold gaussianPlanePolynomial
  have : 0 ≤ lo⁻¹ := by positivity
  nlinarith [hs]

theorem gaussianPlanePolynomial_decay_swap_bound (lo hi K x y d D : ℝ)
    (hlo : 0 < lo) (hhi : 0 < hi) (hK : 0 ≤ K) (hd : |d| ≤ D) :
    gaussianPlanePolynomial lo K x (d - x - y) * gaussianPlaneDecay hi x (d - x - y) ≤
      (4 * gaussianPlaneOffsetFactor (4 * hi) D) *
        (gaussianPlanePolynomial lo (K + D) x y * gaussianPlaneDecay (4 * hi) x y) := by
  have hp := gaussianPlanePolynomial_swap_bound lo K x y d D hlo hK hd
  have he := gaussianPlaneDecay_swap_bound hi x y d D hhi hd
  have ht := mul_le_mul hp he (gaussianPlaneDecay_pos _ _ _).le
    (show 0 ≤ 4 * gaussianPlanePolynomial lo (K + D) x y by
      have := gaussianPlanePolynomial_pos lo (K + D) x y hlo; positivity)
  convert ht using 1 <;> first | rfl | ring

theorem gaussianPlanePolynomial_decay_cycle_bound (lo hi K x y d D : ℝ)
    (hlo : 0 < lo) (hhi : 0 < hi) (hK : 0 ≤ K) (hd : |d| ≤ D) :
    gaussianPlanePolynomial lo K (d - x - y) x * gaussianPlaneDecay hi (d - x - y) x ≤
      (4 * gaussianPlaneOffsetFactor (4 * hi) D) *
        (gaussianPlanePolynomial lo (K + D) x y * gaussianPlaneDecay (4 * hi) x y) := by
  have ht := gaussianPlanePolynomial_decay_swap_bound lo hi K x y d D hlo hhi hK hd
  have hp : gaussianPlanePolynomial lo K (d - x - y) x =
      gaussianPlanePolynomial lo K x (d - x - y) := by unfold gaussianPlanePolynomial; ring
  have he : gaussianPlaneDecay hi (d - x - y) x = gaussianPlaneDecay hi x (d - x - y) := by
    unfold gaussianPlaneDecay; congr 1; ring
  rw [hp, he]
  exact ht

