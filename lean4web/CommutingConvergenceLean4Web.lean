/-- A continuous phase representative of the normalized floor-defined time average. -/
noncomputable def phaseAverage (F : ℕ → ℕ → ℂ) (N : ℕ) (u v : ℝ) : ℂ :=
  (N : ℂ)⁻¹ * ∑ n ∈ Finset.range N,
    complexPhaseCell (F n n) (F (n+1) n) (F n (n+1)) (F (n+1) (n+1)) u v

theorem phaseAverage_continuous (F : ℕ → ℕ → ℂ) (N : ℕ) :
    Continuous (fun p : ℝ × ℝ ↦ phaseAverage F N p.1 p.2) := by
  unfold phaseAverage complexPhaseCell
  fun_prop

theorem phaseAverage_eq_time_integral (F : ℕ → ℕ → ℂ) (N : ℕ) (u v : ℝ)
    (hu : u ∈ Icc (0 : ℝ) 1) (hv : v ∈ Icc (0 : ℝ) 1) :
