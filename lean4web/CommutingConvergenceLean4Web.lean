    (hcard : menu.card ≤ M) :
    ∀ᶠ n in atTop,
      ‖latticeCyclicKernelSum R n F G H (gaussianEulerIntervalMenuKernel k menu a b β)‖ ≤
        (gaussianEulerMenuConstant k * Real.sqrt (M:ℝ)) *
          latticeMatrixCubicSize (latticeBoxIndices R n) (latticeBoxIndices R n) (reciprocalLatticeMesh n)
            (reciprocalLatticeArray n F) *
          latticeMatrixCubicSize (latticeBoxIndices R n) (latticeBoxIndices R n) (reciprocalLatticeMesh n)
