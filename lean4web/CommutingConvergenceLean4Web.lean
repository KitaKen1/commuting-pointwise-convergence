theorem finite_mesh_three_factor_cubic_holder_of_bounds (s : Finset ι) (h : ℝ) (f g k : ι → ℝ)
    (F G K : ℝ) (hf : ∀ i ∈ s, 0 ≤ f i) (hg : ∀ i ∈ s, 0 ≤ g i) (hk : ∀ i ∈ s, 0 ≤ k i)
    (hF : finiteMeshCubicRootSum s h f ≤ F) (hG : finiteMeshCubicRootSum s h g ≤ G)
    (hK : finiteMeshCubicRootSum s h k ≤ K) : h^2*(∑ i ∈ s, f i*g i*k i) ≤ F*G*K := by
  have hf0 := finiteMeshCubicRootSum_nonneg s h f hf
  have hg0 := finiteMeshCubicRootSum_nonneg s h g hg
  have hk0 := finiteMeshCubicRootSum_nonneg s h k hk
  exact (finite_mesh_three_factor_cubic_holder s h f g k hf hg hk).trans
    (mul_le_mul (mul_le_mul hF hG hg0 (hf0.trans hF)) hK hk0
      (mul_nonneg (hf0.trans hF) (hg0.trans hG)))

theorem finite_mesh_switch_bracket_cubic_bound (s : Finset ι) (h : ℝ)
    (a X Y H Q : ι → ℝ) (n₀ n₁ n₂ K : ℝ)
    (ha : ∀ i ∈ s, 0 ≤ a i) (hX : ∀ i ∈ s, 0 ≤ X i) (hY : ∀ i ∈ s, 0 ≤ Y i)
    (hH : ∀ i ∈ s, 0 ≤ H i) (hQ : ∀ i ∈ s, 0 ≤ Q i)
    (ha₃ : finiteMeshCubicRootSum s h a ≤ n₀)
    (hX₃ : finiteMeshCubicRootSum s h X ≤ K*n₀)
    (hY₃ : finiteMeshCubicRootSum s h Y ≤ K*n₀)
    (hH₃ : finiteMeshCubicRootSum s h H ≤ K*n₂)
    (hQ₃ : finiteMeshCubicRootSum s h Q ≤ K*n₁) :
    h^2*(∑ i ∈ s, a i*(2*X i*Y i+H i*Y i+Q i*X i)) ≤
      K^2*(2*n₀^3+n₀^2*(n₁+n₂)) := by
  have he₀ := finite_mesh_three_factor_cubic_holder_of_bounds s h a X Y n₀ (K*n₀) (K*n₀)
    ha hX hY ha₃ hX₃ hY₃
  have he₁ := finite_mesh_three_factor_cubic_holder_of_bounds s h a H Y n₀ (K*n₂) (K*n₀)
    ha hH hY ha₃ hH₃ hY₃
  have he₂ := finite_mesh_three_factor_cubic_holder_of_bounds s h a Q X n₀ (K*n₁) (K*n₀)
    ha hQ hX ha₃ hQ₃ hX₃
  have hid : h^2*(∑ i ∈ s, a i*(2*X i*Y i+H i*Y i+Q i*X i)) =
      2*(h^2*∑ i ∈ s, a i*X i*Y i) +
        (h^2*∑ i ∈ s, a i*H i*Y i) + (h^2*∑ i ∈ s, a i*Q i*X i) := by
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hid]
  apply (add_le_add (add_le_add (mul_le_mul_of_nonneg_left he₀ (by norm_num : (0:ℝ) ≤ 2)) he₁) he₂).trans_eq
  ring

end
end CommutingConvergence
