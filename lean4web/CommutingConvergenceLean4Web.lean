def gaussianWindowRatio (r : ℕ) (L u x : ℝ) : ℝ :=
  gaussianDerivativeWindow r L (u - x) / gaussianHeatDensity (L ^ 2) u x

theorem gaussianWindowRatio_eq_zero_center (r : ℕ) (L u x : ℝ) :
