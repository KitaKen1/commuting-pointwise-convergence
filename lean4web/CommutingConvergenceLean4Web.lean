noncomputable def matrixMulVecCLM (x : n → ℂ) : Matrix n n ℂ →L[ℝ] (n → ℂ) :=
  (show Matrix n n ℂ →ₗ[ℝ] (n → ℂ) from
    { toFun := fun P ↦ P *ᵥ x
      map_add' := by intros; simp [Matrix.add_mulVec]
      map_smul' := by intros; simp [Matrix.smul_mulVec] }).toContinuousLinearMap

