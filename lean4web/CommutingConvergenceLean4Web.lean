  by_cases hN : N = 0
  · subst N
    simpa [phaseAverage] using hC
  · have hn : (N : ℝ) ≠ 0 := by exact_mod_cast hN
    calc
      _ ≤ (N : ℝ)⁻¹ * ∑ _n ∈ Finset.range N, C := by
        simp only [phaseAverage, norm_mul, norm_inv, Complex.norm_natCast]
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        apply (norm_sum_le _ _).trans
        exact Finset.sum_le_sum fun n _ ↦
          complexPhaseCell_norm_le _ _ _ _ C u v (hF _ _) (hF _ _) (hF _ _) (hF _ _) hu hv
      _ = C := by simp [hn]

