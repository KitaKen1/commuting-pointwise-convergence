  calc
    _ = x ^ (1 / 2 : ℝ) * x ^ (1 : ℝ) := by rw [Real.sqrt_eq_rpow, Real.rpow_one]
    _ = x ^ ((1 / 2 : ℝ) + 1) :=
      (Real.rpow_add_of_nonneg hx (by norm_num) (by norm_num)).symm
    _ = _ := by congr 1; norm_num

