/-! Finite switch accounting after a common majorant has been supplied.
The discrete maximal estimate supplying that majorant remains an input. -/
open Matrix MeasureTheory
namespace CommutingConvergence
noncomputable section

variable {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]

theorem gaussianAveragedSwitchBracket_nonneg (A : Matrix m n ℂ) (B : Matrix n p ℂ)
    (C : Matrix p m ℂ) (h σ τ ρ ν : ℝ) (u : m → ℝ) (v : n → ℝ) (w : p → ℝ)
    (i : m) (j : n) : 0 ≤ gaussianAveragedSwitchBracket A B C h σ τ ρ ν u v w i j := by
  unfold gaussianAveragedSwitchBracket gaussianRowL2Density gaussianColL2Density
  positivity

theorem gaussianAveragedSwitchBracket_le_majorants (A : Matrix m n ℂ) (B : Matrix n p ℂ)
    (C : Matrix p m ℂ) (h σ τ ρ ν : ℝ) (u : m → ℝ) (v : n → ℝ) (w : p → ℝ)
    (i : m) (j : n) (X Y H Q : ℝ)
    (hX : gaussianRowL2Density A h (τ+τ) v (v j) i ≤ X)
    (hY : gaussianColL2Density A h (σ+σ) u (u i) j ≤ Y)
    (hH : gaussianColL2Density C h (σ+τ+ρ+ν) w (-u i-v j) i ≤ H)
    (hQ : gaussianRowL2Density B h (σ+τ+ρ+ν) w (-u i-v j) j ≤ Q) :
    gaussianAveragedSwitchBracket A B C h σ τ ρ ν u v w i j ≤ 2*X*Y+H*Y+Q*X := by
  have hnX := gaussianRowL2Density_nonneg A h (τ+τ) v (v j) i
  have hnY := gaussianColL2Density_nonneg A h (σ+σ) u (u i) j
  have hnH := gaussianColL2Density_nonneg C h (σ+τ+ρ+ν) w (-u i-v j) i
  have hnQ := gaussianRowL2Density_nonneg B h (σ+τ+ρ+ν) w (-u i-v j) j
  have hxy := mul_le_mul hX hY hnY (hnX.trans hX)
  have hhy := mul_le_mul hH hY hnY (hnH.trans hH)
  have hqx := mul_le_mul hQ hX hnX (hnQ.trans hQ)
  unfold gaussianAveragedSwitchBracket
  exact add_le_add (add_le_add
    (by simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hxy (by norm_num : (0:ℝ) ≤ 2)) hhy) hqx

theorem finite_weighted_switch_sum_le {ι κ : Type*} (s : Finset ι) (r : Finset κ)
    (cost : ι → ℝ) (D : ι → κ → ℝ) (A R : κ → ℝ) (K L : ℝ)
    (hK : 0 ≤ K) (hR : ∀ j ∈ r, 0 ≤ R j)
    (hcost : ∀ t ∈ s, cost t ≤ K * ∑ j ∈ r, D t j * R j)
    (hD : ∀ j ∈ r, (∑ t ∈ s, D t j) ≤ L * A j) :
    (∑ t ∈ s, cost t) ≤ K*L*∑ j ∈ r, A j * R j := by
  calc
    (∑ t ∈ s, cost t) ≤ ∑ t ∈ s, K * ∑ j ∈ r, D t j * R j :=
      Finset.sum_le_sum hcost
    _ = K * ∑ j ∈ r, (∑ t ∈ s, D t j) * R j := by
      rw [← Finset.mul_sum, Finset.sum_comm]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      rw [Finset.sum_mul]
    _ ≤ K * ∑ j ∈ r, (L*A j) * R j := by
      apply mul_le_mul_of_nonneg_left _ hK
      exact Finset.sum_le_sum (fun j hj ↦ mul_le_mul_of_nonneg_right (hD j hj) (hR j hj))
    _ = K*L*∑ j ∈ r, A j * R j := by
      simp only [mul_assoc, Finset.mul_sum]

variable [DecidableEq m] [DecidableEq n] [DecidableEq p]

/-- Actual averaged switches are summed; the common scale majorant is explicit. -/
theorem gaussianIncidentStarJumpIntegral_sum_le_of_majorant {ι : Type*} (s : Finset ι)
    (A₀ A₁ : ι → Matrix m n ℂ) (A : Matrix m n ℂ) (B : Matrix n p ℂ) (C : Matrix p m ℂ)
    (h M : ℝ) (σ τ ρ ν : ι → ℝ) (u : m → ℝ) (v : n → ℝ) (w : p → ℝ)
    (R : m → n → ℝ) (hh : 0 ≤ h)
    (hσ : ∀ t ∈ s, 0 < σ t) (hτ : ∀ t ∈ s, 0 < τ t)
    (hρ : ∀ t ∈ s, 0 < ρ t) (hν : ∀ t ∈ s, 0 < ν t)
    (h₀ : ∀ t ∈ s, ∀ i j, ‖A₀ t i j‖ ≤ ‖A i j‖)
    (h₁ : ∀ t ∈ s, ∀ i j, ‖A₁ t i j‖ ≤ ‖A i j‖)
    (hR : ∀ i j, 0 ≤ R i j)
    (hmajor : ∀ t ∈ s, ∀ i j,
      gaussianAveragedSwitchBracket A B C h (σ t) (τ t) (ρ t) (ν t) u v w i j ≤ R i j)
    (hchanges : ∀ i j, (∑ t ∈ s, ‖(A₁ t-A₀ t) i j‖) ≤ 2*M*‖A i j‖) :
    (∑ t ∈ s, gaussianIncidentStarJumpIntegral (A₀ t) (A₁ t) B C h (σ t) (τ t) (ρ t) (ν t) u v w) ≤
      6*M*h^2*∑ i, ∑ j, ‖A i j‖*R i j := by
  have hcost (t : ι) (ht : t ∈ s) :
      gaussianIncidentStarJumpIntegral (A₀ t) (A₁ t) B C h (σ t) (τ t) (ρ t) (ν t) u v w ≤
        (3*h^2) * ∑ q : m × n, ‖(A₁ t-A₀ t) q.1 q.2‖ * R q.1 q.2 := by
    apply (gaussianIncidentStarJumpIntegral_le (A₀ t) (A₁ t) A B C h (σ t) (τ t) (ρ t) (ν t)
      u v w hh (hσ t ht) (hτ t ht) (hρ t ht) (hν t ht) (h₀ t ht) (h₁ t ht)).trans
    apply mul_le_mul_of_nonneg_left _ (by positivity : 0 ≤ 3*h^2)
    rw [Fintype.sum_prod_type]
    apply Finset.sum_le_sum
    intro i _
    apply Finset.sum_le_sum
    intro j _
    exact mul_le_mul_of_nonneg_left (hmajor t ht i j) (norm_nonneg _)
  have he := finite_weighted_switch_sum_le s (Finset.univ : Finset (m × n))
    (fun t ↦ gaussianIncidentStarJumpIntegral (A₀ t) (A₁ t) B C h (σ t) (τ t) (ρ t) (ν t) u v w)
    (fun t q ↦ ‖(A₁ t-A₀ t) q.1 q.2‖) (fun q ↦ ‖A q.1 q.2‖) (fun q ↦ R q.1 q.2)
    (3*h^2) (2*M) (by positivity) (fun q _ ↦ hR q.1 q.2) hcost
    (fun q _ ↦ hchanges q.1 q.2)
  simpa only [Fintype.sum_prod_type,
    show 3*h^2*(2*M) = 6*M*h^2 from by ring] using he

end
end CommutingConvergence
