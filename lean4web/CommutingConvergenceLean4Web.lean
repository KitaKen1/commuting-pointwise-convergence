open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator
namespace CommutingConvergence
noncomputable section
variable {m n V : Type*} [Fintype m] [Fintype n] [Fintype V]
  [DecidableEq m] [DecidableEq n] [DecidableEq V]

def rowPartitionProjection (label : m → V) (v : V) : Matrix m m ℂ :=
  Matrix.diagonal (fun i ↦ if label i = v then 1 else 0)

def partitionedRow (label : m → V) (v : V) (R : Matrix m n ℂ) : Matrix m n ℂ :=
  rowPartitionProjection label v * R

def PreservesRowPartition (label : m → V) (D : Matrix m m ℂ) : Prop :=
  ∀ i j, label i ≠ label j → D i j = 0

omit [Fintype m] [Fintype V] in
theorem rowPartitionProjection_hermitian (label : m → V) (v : V) :
    (rowPartitionProjection label v).IsHermitian := by
  apply Matrix.isHermitian_diagonal_iff.mpr
  intro i
  by_cases hi : label i = v <;> simp [hi]

omit [Fintype V] in
theorem rowPartitionProjection_idempotent (label : m → V) (v : V) :
    rowPartitionProjection label v * rowPartitionProjection label v = rowPartitionProjection label v := by
  ext i j
  simp only [rowPartitionProjection, Matrix.diagonal_mul, Matrix.diagonal_apply]
  split_ifs <;> simp_all

omit [Fintype m] in
theorem rowPartitionProjection_sum (label : m → V) :
    (∑ v, rowPartitionProjection label v) = 1 := by
  ext i j
  by_cases hij : i = j
  · subst j
    simp only [Matrix.sum_apply, rowPartitionProjection, Matrix.diagonal_apply_eq, Matrix.one_apply_eq]
    rw [Finset.sum_eq_single (label i)]
    · simp
    · intro v _ hvi
      simp [Ne.symm hvi]
    · simp
  · simp [Matrix.sum_apply, rowPartitionProjection, hij]

omit [Fintype n] [DecidableEq n] [Fintype V] in
theorem partitionedRow_gram (label : m → V) (v : V) (R : Matrix m n ℂ) :
    (partitionedRow label v R)ᴴ * partitionedRow label v R = Rᴴ * rowPartitionProjection label v * R := by
  simp only [partitionedRow, Matrix.conjTranspose_mul,
    (rowPartitionProjection_hermitian label v).eq]
  rw [Matrix.mul_assoc, ← Matrix.mul_assoc (rowPartitionProjection label v),
    rowPartitionProjection_idempotent, ← Matrix.mul_assoc]

omit [Fintype n] [DecidableEq n] in
theorem partitionedRow_gram_sum (label : m → V) (R : Matrix m n ℂ) :
    (∑ v, (partitionedRow label v R)ᴴ * partitionedRow label v R) = Rᴴ * R := by
  simp_rw [partitionedRow_gram]
  rw [← Matrix.sum_mul, ← Matrix.mul_sum, rowPartitionProjection_sum, Matrix.mul_one]

omit [DecidableEq n] in
theorem partitionedRow_gram_le (label : m → V) (v : V) (R : Matrix m n ℂ) :
    (partitionedRow label v R)ᴴ * partitionedRow label v R ≤ Rᴴ * R := by
  have hnon : 0 ≤ ∑ w ∈ Finset.univ.erase v,
      (partitionedRow label w R)ᴴ * partitionedRow label w R :=
    Finset.sum_nonneg fun w _ ↦ (Matrix.posSemidef_conjTranspose_mul_self _).nonneg
  have he : Rᴴ * R = (partitionedRow label v R)ᴴ * partitionedRow label v R +
      ∑ w ∈ Finset.univ.erase v, (partitionedRow label w R)ᴴ * partitionedRow label w R := by
    rw [← partitionedRow_gram_sum label R]
    exact (Finset.add_sum_erase _ _ (Finset.mem_univ v)).symm
  rw [he]
  exact le_add_of_nonneg_right hnon

theorem rowPartitionProjection_insertion_sum (label : m → V) (D : Matrix m m ℂ)
    (hD : PreservesRowPartition label D) :
    (∑ v, rowPartitionProjection label v * D * rowPartitionProjection label v) = D := by
  ext i j
  simp only [Matrix.sum_apply, rowPartitionProjection, Matrix.diagonal_mul, Matrix.mul_diagonal]
  by_cases hij : label i = label j
  · rw [Finset.sum_eq_single (label i)]
    · simp [hij]
    · intro v _ hvi
      simp [Ne.symm hvi]
    · simp
  · rw [hD i j hij]
    simp

omit [Fintype n] [DecidableEq n] in
theorem partitionedRow_insertion_sum (label : m → V) (R : Matrix m n ℂ)
    (D : Matrix m m ℂ) (hD : PreservesRowPartition label D) :
    (∑ v, (partitionedRow label v R)ᴴ * D * partitionedRow label v R) = Rᴴ * D * R := by
  have he (v : V) : (partitionedRow label v R)ᴴ * D * partitionedRow label v R =
      Rᴴ * (rowPartitionProjection label v * D * rowPartitionProjection label v) * R := by
    simp only [partitionedRow, Matrix.conjTranspose_mul, (rowPartitionProjection_hermitian label v).eq]
    simp only [Matrix.mul_assoc]
  simp_rw [he]
  rw [← Matrix.sum_mul, ← Matrix.mul_sum, rowPartitionProjection_insertion_sum label D hD]

omit [Fintype V] in
theorem rowPartitionProjection_commutes (label : m → V) (D : Matrix m m ℂ)
    (hD : PreservesRowPartition label D) (v : V) :
    rowPartitionProjection label v * D = D * rowPartitionProjection label v := by
  ext i j
  simp only [rowPartitionProjection, Matrix.diagonal_mul, Matrix.mul_diagonal]
  by_cases hij : label i = label j
  · simp only [hij]
    ring
  · simp only [hD i j hij, mul_zero, zero_mul]

omit [Fintype V] in
theorem rowPartitionProjection_sandwich (label : m → V) (D : Matrix m m ℂ)
    (hD : PreservesRowPartition label D) (v : V) :
    rowPartitionProjection label v * D * rowPartitionProjection label v =
      rowPartitionProjection label v * D := by
  rw [Matrix.mul_assoc, ← rowPartitionProjection_commutes label D hD v,
    ← Matrix.mul_assoc, rowPartitionProjection_idempotent]

omit [Fintype n] [DecidableEq n] [Fintype V] in
theorem partitionedRow_insertion (label : m → V) (v : V) (R : Matrix m n ℂ)
    (D : Matrix m m ℂ) (hD : PreservesRowPartition label D) :
    (partitionedRow label v R)ᴴ * D * partitionedRow label v R =
      Rᴴ * rowPartitionProjection label v * D * R := by
  calc
    _ = Rᴴ * (rowPartitionProjection label v * D * rowPartitionProjection label v) * R := by
      simp only [partitionedRow, Matrix.conjTranspose_mul,
        (rowPartitionProjection_hermitian label v).eq, Matrix.mul_assoc]
    _ = _ := by rw [rowPartitionProjection_sandwich label D hD v]; simp only [Matrix.mul_assoc]

end
end CommutingConvergence
