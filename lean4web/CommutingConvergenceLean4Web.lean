def cubicSpectralWeight (x y : ℝ) : ℝ := x^2*y^2/(x+y)

theorem cubicSpectralWeight_nonneg (x y : ℝ) (hx : 0≤x) (hy : 0≤y) :
    0≤cubicSpectralWeight x y :=
  div_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _)) (add_nonneg hx hy)

theorem cubicSpectralWeight_symm (x y : ℝ) : cubicSpectralWeight x y = cubicSpectralWeight y x := by
  unfold cubicSpectralWeight
  ring

theorem cubicSpectralWeight_diag (x : ℝ) : cubicSpectralWeight x x = x^3/2 := by
  by_cases hx : x=0
  · simp [cubicSpectralWeight,hx]
  · unfold cubicSpectralWeight
    field_simp
    ring

theorem cubicSpectralWeight_ordered_lower (x y : ℝ) (hx : 0≤x) (hy : 0≤y) (hxy : y≤x) :
    x*y^2 ≤ 2*cubicSpectralWeight x y := by
  by_cases hz : x=0
  · have hyz : y=0 := by linarith
    simp [cubicSpectralWeight,hz,hyz]
  · have hp : 0<x+y := by have := lt_of_le_of_ne hx (Ne.symm hz); linarith
    unfold cubicSpectralWeight
    rw [← mul_div_assoc,le_div_iff₀ hp]
    have h := mul_nonneg (sub_nonneg.mpr hxy) (mul_nonneg hx (sq_nonneg y))
    nlinarith

variable {n : Type*} [Fintype n] [LinearOrder n]

def cubicSpectralQ (q : n→ℝ) (D : Matrix n n ℂ) : ℝ :=
  ∑ i, ∑ j, cubicSpectralWeight (q i) (q j)*‖D i j‖^2

def cubicDiagonalMass (q : n→ℝ) (D : Matrix n n ℂ) : ℝ :=
  ∑ i, (q i)^3*‖D i i‖^2

def cubicUpperMass (q : n→ℝ) (D : Matrix n n ℂ) : ℝ :=
  ∑ i, ∑ j ∈ Finset.univ.filter (i < ·), q i*(q j)^2*‖D i j‖^2

