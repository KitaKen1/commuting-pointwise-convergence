  have h0 := rectangular_star_left_jump_abs_le A₀ A₁ A Cᴴ h₀ h₁
  have h1 := rectangular_star_right_jump_abs_le B A₀ᴴ A₁ᴴ Aᴴ
    (fun j i ↦ by simpa only [Matrix.conjTranspose_apply, norm_star] using h₀ i j)
    (fun j i ↦ by simpa only [Matrix.conjTranspose_apply, norm_star] using h₁ i j)
  simp only [matrixRowL2_conjTranspose, matrixColL2_conjTranspose,
    Matrix.sub_apply, Matrix.conjTranspose_apply, ← star_sub, norm_star] at h0 h1
  apply (add_le_add h0 h1).trans_eq
  rw [Finset.sum_comm (f := fun j i ↦
    (matrixRowL2 B j + matrixColL2 A j) * matrixRowL2 A i * ‖A₁ i j - A₀ i j‖),
    ← mul_add, ← Finset.sum_add_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro j _
  simp only [Matrix.sub_apply]
  ring

end
end CommutingConvergence
