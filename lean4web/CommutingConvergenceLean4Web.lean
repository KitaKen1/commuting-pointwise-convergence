  have hK : 0 ≤ K := (abs_nonneg u).trans hu
  have hsq : u ^ 2 ≤ K ^ 2 := by
    have h := mul_self_le_mul_self (abs_nonneg u) hu
    nlinarith only [h, sq_abs u]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  exact Real.exp_le_exp.mpr (div_le_div_of_nonneg_right hsq (by positivity))

theorem gaussianHigherDerivativeEnvelope_nonneg (n : ℕ) (lo hi K p : ℝ)
    (hlo : 0 < lo) (hK : 0 ≤ K) :
