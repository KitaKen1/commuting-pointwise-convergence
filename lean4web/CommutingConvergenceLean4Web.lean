-- Source: CommutingConvergence.GaussianWeightedHeat
section OriginalModule82
set_option autoImplicit false
/-! Actual pure center/variance heat identities for Gaussian-weighted finite
Grams. Singular fixed arrays are included. Column weights are treated through
the adjoint Gram and exact rectangular energy equality. This does not yet
include mixed column derivatives, the joint variance curve, or plane integrals. -/

open Matrix Filter Set
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator Topology

namespace CommutingConvergence

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

noncomputable section

@[instance_reducible] local instance gaussianWeightedHeatAddCommGroup : AddCommGroup (Matrix n n ℂ) :=
  (inferInstance : NormedAddCommGroup (Matrix n n ℂ)).toAddCommGroup
@[instance_reducible] local instance gaussianWeightedHeatRealModule : Module ℝ (Matrix n n ℂ) :=
  (inferInstance : NormedSpace ℝ (Matrix n n ℂ)).toModule
@[instance_reducible] local instance gaussianWeightedHeatTopology : TopologicalSpace (Matrix n n ℂ) :=
  (inferInstance : MetricSpace (Matrix n n ℂ)).toPseudoMetricSpace.toUniformSpace.toTopologicalSpace

def gaussianDensityWeights (h σ : ℝ) (u : m → ℝ) (p : ℝ) : m → ℝ :=
  fun i ↦ h * gaussianHeatDensity σ (u i) p

def gaussianDensityFirstWeights (h σ : ℝ) (u : m → ℝ) (p : ℝ) : m → ℝ :=
  fun i ↦ h * (gaussianHeatScore σ (u i) p * gaussianHeatDensity σ (u i) p)

def gaussianDensitySecondWeights (h σ : ℝ) (u : m → ℝ) (p : ℝ) : m → ℝ :=
  fun i ↦ h * (gaussianHeatAcceleration σ (u i) p * gaussianHeatDensity σ (u i) p)

def gaussianWeightedGram (R : Matrix m n ℂ) (h σ : ℝ) (u : m → ℝ) (p : ℝ) :
    Matrix n n ℂ := densityGram R (gaussianDensityWeights h σ u p)

def gaussianWeightedGramFirst (R : Matrix m n ℂ) (h σ : ℝ) (u : m → ℝ) (p : ℝ) :
    Matrix n n ℂ := densityGram R (gaussianDensityFirstWeights h σ u p)

def gaussianWeightedGramSecond (R : Matrix m n ℂ) (h σ : ℝ) (u : m → ℝ) (p : ℝ) :
    Matrix n n ℂ := densityGram R (gaussianDensitySecondWeights h σ u p)

def gaussianWeightedEnergy (R : Matrix m n ℂ) (h σ : ℝ) (u : m → ℝ) (p : ℝ) : ℝ :=
  (Matrix.trace (CFC.rpow (gaussianWeightedGram R h σ u p) (3 / 2 : ℝ))).re

omit [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n] in
theorem gaussianDensityWeights_center_hasDerivAt (h σ : ℝ) (u : m → ℝ) (p : ℝ) (i : m) :
    HasDerivAt (fun q ↦ gaussianDensityWeights h σ u q i)
      (gaussianDensityFirstWeights h σ u p i) p :=
  (gaussianHeatDensity_center_hasDerivAt σ (u i) p).const_mul h

omit [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n] in
theorem gaussianDensityWeights_center_deriv_hasDerivAt (h σ : ℝ) (u : m → ℝ) (p : ℝ) (i : m) :
    HasDerivAt (deriv (fun q ↦ gaussianDensityWeights h σ u q i))
      (gaussianDensitySecondWeights h σ u p i) p := by
  have he : deriv (fun q ↦ gaussianDensityWeights h σ u q i) =
      fun q ↦ gaussianDensityFirstWeights h σ u q i :=
    funext fun q ↦ (gaussianDensityWeights_center_hasDerivAt h σ u q i).deriv
  rw [he]
  have hg := (gaussianHeatDensity_center_deriv_hasDerivAt σ (u i) p).const_mul h
  have he' : deriv (gaussianHeatDensity σ (u i)) =
      fun q ↦ gaussianHeatScore σ (u i) q * gaussianHeatDensity σ (u i) q :=
    funext (gaussianHeatDensity_center_deriv σ (u i))
  rw [he'] at hg
  exact hg

omit [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n] in
theorem gaussianDensityWeights_variance_hasDerivAt (h σ : ℝ) (u : m → ℝ) (p : ℝ)
    (hσ : 0 < σ) (i : m) :
    HasDerivAt (fun τ ↦ gaussianDensityWeights h τ u p i)
      ((1 / 2 : ℝ) * gaussianDensitySecondWeights h σ u p i) σ := by
  simpa only [gaussianDensityWeights, gaussianDensitySecondWeights,
    mul_assoc, mul_left_comm, mul_comm] using
    (gaussianHeatDensity_variance_hasDerivAt σ (u i) p hσ).const_mul h

theorem gaussianWeightedGram_center_hasDerivAt (R : Matrix m n ℂ) (h σ : ℝ)
    (u : m → ℝ) (p : ℝ) :
    HasDerivAt (gaussianWeightedGram R h σ u) (gaussianWeightedGramFirst R h σ u p) p :=
  densityGram_hasDerivAt R (gaussianDensityWeights h σ u)
    (gaussianDensityFirstWeights h σ u p) p (gaussianDensityWeights_center_hasDerivAt h σ u p)

theorem gaussianWeightedGram_center_deriv_hasDerivAt (R : Matrix m n ℂ) (h σ : ℝ)
    (u : m → ℝ) (p : ℝ) :
    HasDerivAt (deriv (gaussianWeightedGram R h σ u))
      (gaussianWeightedGramSecond R h σ u p) p :=
  densityGram_deriv_hasDerivAt R (gaussianDensityWeights h σ u)
    (gaussianDensitySecondWeights h σ u p) p
    (gaussianDensityWeights_center_deriv_hasDerivAt h σ u p)
    (Eventually.of_forall fun q i ↦ (gaussianDensityWeights_center_hasDerivAt h σ u q i).differentiableAt)

theorem gaussianWeightedGram_variance_hasDerivAt (R : Matrix m n ℂ) (h σ : ℝ)
    (u : m → ℝ) (p : ℝ) (hσ : 0 < σ) :
    HasDerivAt (fun τ ↦ gaussianWeightedGram R h τ u p)
      ((1 / 2 : ℝ) • gaussianWeightedGramSecond R h σ u p) σ := by
  have hg := densityGram_hasDerivAt R (fun τ ↦ gaussianDensityWeights h τ u p)
    ((1 / 2 : ℝ) • gaussianDensitySecondWeights h σ u p) σ
    (gaussianDensityWeights_variance_hasDerivAt h σ u p hσ)
  have he : densityGram R ((1 / 2 : ℝ) • gaussianDensitySecondWeights h σ u p) =
      (1 / 2 : ℝ) • gaussianWeightedGramSecond R h σ u p :=
    (densityGramCLM R).map_smul (1 / 2 : ℝ) (gaussianDensitySecondWeights h σ u p)
  rwa [he] at hg

theorem gaussianWeightedEnergy_center_hasDerivAt (R : Matrix m n ℂ) (h σ : ℝ)
    (u : m → ℝ) (p : ℝ) (hh : 0 < h) (hσ : 0 < σ) :
    HasDerivAt (gaussianWeightedEnergy R h σ u)
      (matrixEnergyGradientCLM (gaussianWeightedGram R h σ u p)
        (gaussianWeightedGramFirst R h σ u p)) p :=
  trace_rpow_densityGram_hasDerivAt R (gaussianDensityWeights h σ u)
    (gaussianDensityFirstWeights h σ u p) p
    (gaussianDensityWeights_center_hasDerivAt h σ u p)
    (Eventually.of_forall fun q i ↦ mul_pos hh (gaussianHeatDensity_pos σ (u i) q hσ))

theorem gaussianWeightedEnergy_variance_hasDerivAt (R : Matrix m n ℂ) (h σ : ℝ)
    (u : m → ℝ) (p : ℝ) (hh : 0 < h) (hσ : 0 < σ) :
    HasDerivAt (fun τ ↦ gaussianWeightedEnergy R h τ u p)
      ((1 / 2 : ℝ) * matrixEnergyGradientCLM (gaussianWeightedGram R h σ u p)
        (gaussianWeightedGramSecond R h σ u p)) σ := by
  have hp : ∀ᶠ τ in 𝓝 σ, ∀ i, 0 < gaussianDensityWeights h τ u p i := by
    filter_upwards [eventually_gt_nhds hσ] with τ hτ
    intro i
    exact mul_pos hh (gaussianHeatDensity_pos τ (u i) p hτ)
  have hg := trace_rpow_densityGram_hasDerivAt R (fun τ ↦ gaussianDensityWeights h τ u p)
    ((1 / 2 : ℝ) • gaussianDensitySecondWeights h σ u p) σ
    (gaussianDensityWeights_variance_hasDerivAt h σ u p hσ) hp
  have he : densityGram R ((1 / 2 : ℝ) • gaussianDensitySecondWeights h σ u p) =
      (1 / 2 : ℝ) • gaussianWeightedGramSecond R h σ u p :=
    (densityGramCLM R).map_smul (1 / 2 : ℝ) (gaussianDensitySecondWeights h σ u p)
  rw [he, map_smul, smul_eq_mul] at hg
  exact hg

theorem gaussianWeightedEnergy_center_second_deriv (R : Matrix m n ℂ) (h σ : ℝ)
    (u : m → ℝ) (p : ℝ) (hh : 0 < h) (hσ : 0 < σ) :
    deriv (deriv (gaussianWeightedEnergy R h σ u)) p =
      gramSylvesterCost (gaussianWeightedGram R h σ u p) (gaussianWeightedGramFirst R h σ u p) +
      matrixEnergyGradientCLM (gaussianWeightedGram R h σ u p)
        (gaussianWeightedGramSecond R h σ u p) := by
  have hg := trace_rpow_densityGram_second_deriv R (gaussianDensityWeights h σ u)
    (gaussianDensitySecondWeights h σ u p) p
    (gaussianDensityWeights_center_deriv_hasDerivAt h σ u p)
    (Eventually.of_forall fun q i ↦ (gaussianDensityWeights_center_hasDerivAt h σ u q i).differentiableAt)
    (Eventually.of_forall fun q i ↦ mul_pos hh (gaussianHeatDensity_pos σ (u i) q hσ))
  have hd : deriv (fun q ↦ densityGram R (gaussianDensityWeights h σ u q)) p =
      gaussianWeightedGramFirst R h σ u p :=
    (gaussianWeightedGram_center_hasDerivAt R h σ u p).deriv
  rw [hd] at hg
  exact hg

/-- The pure Gaussian heat identity, with the Hessian cost as the dissipation term. -/
theorem gaussianWeightedEnergy_heat_eq (R : Matrix m n ℂ) (h σ : ℝ)
    (u : m → ℝ) (p : ℝ) (hh : 0 < h) (hσ : 0 < σ) :
    2 * deriv (fun τ ↦ gaussianWeightedEnergy R h τ u p) σ =
      deriv (deriv (gaussianWeightedEnergy R h σ u)) p -
        gramSylvesterCost (gaussianWeightedGram R h σ u p)
          (gaussianWeightedGramFirst R h σ u p) := by
  rw [(gaussianWeightedEnergy_variance_hasDerivAt R h σ u p hh hσ).deriv,
    gaussianWeightedEnergy_center_second_deriv R h σ u p hh hσ]
  ring

def gaussianWeightedColumnEnergy (R : Matrix m n ℂ) (h σ : ℝ) (u : n → ℝ) (p : ℝ) : ℝ :=
  let C := R * Matrix.diagonal (fun i ↦ (Real.sqrt (gaussianDensityWeights h σ u p i) : ℂ))
  (Matrix.trace (CFC.rpow (Cᴴ * C) (3 / 2 : ℝ))).re

theorem gaussianWeightedColumnEnergy_eq_adjoint (R : Matrix m n ℂ) (h σ : ℝ)
    (u : n → ℝ) (p : ℝ) (hh : 0 ≤ h) :
    gaussianWeightedColumnEnergy R h σ u p = gaussianWeightedEnergy Rᴴ h σ u p := by
  have hw : ∀ i, 0 ≤ gaussianDensityWeights h σ u p i :=
    fun i ↦ mul_nonneg hh (gaussianHeatDensity_nonneg σ (u i) p)
  have hs : star (fun i ↦ (Real.sqrt (gaussianDensityWeights h σ u p i) : ℂ)) =
      fun i ↦ (Real.sqrt (gaussianDensityWeights h σ u p i) : ℂ) := by
    funext i
    simp only [Pi.star_apply, Complex.star_def, Complex.conj_ofReal]
