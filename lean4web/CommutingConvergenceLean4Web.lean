    Integrable (fun p : ℝ × ℝ ↦ G p.1 p.2 (d - p.1 - p.2)) ∧
    HasDerivAt (fun s ↦ ∫ p : ℝ × ℝ, F p.1 p.2 (s - p.1 - p.2))
      (∫ p : ℝ × ℝ, G p.1 p.2 (d - p.1 - p.2)) d := by
  let B := fun p : ℝ × ℝ ↦ (C * (4 * gaussianPlaneOffsetFactor (4 * hi) (|d| + 1))) *
    (gaussianPlanePolynomial lo (K + (|d| + 1)) p.1 p.2 * gaussianPlaneDecay (4 * hi) p.1 p.2)
