      simp only [Finset.sum_add_distrib,ho₁,ho₂,ht₁,ht₂,hd]
      change (∑ i,w i i i)+(∑ i,∑ j,∑ k,O i j k)+(∑ i,∑ j,∑ k,O i j k)+
        (∑ i,∑ j,∑ k,O i j k)+(∑ i,∑ j,∑ k,T i j k)+(∑ i,∑ j,∑ k,T i j k)+
        (∑ i,∑ j,∑ k,T i j k)=_
