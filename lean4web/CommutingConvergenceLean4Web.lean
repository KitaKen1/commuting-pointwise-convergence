    (hK : ∀ v ∈ s, MatrixSupportedOn (P v) (K v)) :
    (s.card:ℝ)⁻¹ * gramSylvesterCost Q (∑ v ∈ s, K v) ≤ ∑ v ∈ s, gramSylvesterCost (P v) (K v) := by
  by_cases hs : s.card = 0
  · simp [Finset.card_eq_zero.mp hs]
  · have hn : (s.card:ℝ) ≠ 0 := by exact_mod_cast hs
    have hcard : 0 ≤ (s.card:ℝ) := Nat.cast_nonneg _
    have hKQ (v : V) (hv : v ∈ s) : MatrixSupportedOn Q (K v) :=
      matrixSupportedOn_of_le (P v) Q (K v) (hP v hv) (hPQ v hv) (hK v hv)
    have hcost := gramSylvesterCost_finsetSum_le Q hQ s K hKQ
    have horder := Finset.sum_le_sum fun v hv ↦
      gramSylvesterCost_antitone (P v) Q (K v) (hP v hv) hQ (hPQ v hv) (hK v hv)
    have h := hcost.trans (mul_le_mul_of_nonneg_left horder hcard)
