  · subst k
    obtain ⟨C, hC, h3⟩ := gaussianHeatDensity_iteratedDeriv_bounded 3 1 0 (by norm_num)
    exact ⟨C, hC, fun x ↦ by simpa only [standardEuler_odd_eq_gaussian_derivative, Real.norm_eq_abs] using h3 x⟩

