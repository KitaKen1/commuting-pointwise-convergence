theorem phaseAverage_reconstruction (F : ℕ → ℕ → ℂ) (N : ℕ) :
    (∫ u in (0 : ℝ)..1, ∫ v in (0 : ℝ)..1, phaseWeight u v • phaseAverage F N u v) =
      (N : ℂ)⁻¹ * (∑ n ∈ Finset.range N, F n n) + (F N N - F 0 0) / (2 * (N : ℂ)) := by
  let cell (n : ℕ) (u v : ℝ) := phaseWeight u v •
    complexPhaseCell (F n n) (F (n+1) n) (F n (n+1)) (F (n+1) (n+1)) u v
  have hc (n : ℕ) : Continuous (fun p : ℝ × ℝ ↦ cell n p.1 p.2) := by
    unfold cell phaseWeight complexPhaseCell
    fun_prop
  have hi (n : ℕ) (u : ℝ) : IntervalIntegrable (cell n u) volume 0 1 :=
    ((hc n).comp (continuous_const.prodMk continuous_id)).intervalIntegrable _ _
  have ho (n : ℕ) : IntervalIntegrable (fun u ↦ ∫ v in (0 : ℝ)..1, cell n u v) volume 0 1 :=
    (intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' (hc n) 0 1).intervalIntegrable _ _
  have hscale (u v : ℝ) : phaseWeight u v • phaseAverage F N u v =
      (N : ℂ)⁻¹ * ∑ n ∈ Finset.range N, cell n u v := by
    simp [phaseAverage, cell, ← mul_smul_comm, Finset.smul_sum]
  simp_rw [hscale, intervalIntegral.integral_const_mul]
  have hinner (u : ℝ) : (∫ v in (0 : ℝ)..1, ∑ n ∈ Finset.range N, cell n u v) =
      ∑ n ∈ Finset.range N, ∫ v in (0 : ℝ)..1, cell n u v :=
    intervalIntegral.integral_finsetSum fun n _ ↦ hi n u
  simp_rw [hinner]
  rw [intervalIntegral.integral_finsetSum (fun n _ ↦ ho n)]
  exact phase_reconstruction_average (fun n ↦ F n n) (fun n ↦ F (n+1) n) (fun n ↦ F n (n+1)) N

/-- The same identity for the actual floor-defined time integral. -/
theorem floorObservable_phase_reconstruction (F : ℕ → ℕ → ℂ) (N : ℕ) :
    (∫ u in (0 : ℝ)..1, ∫ v in (0 : ℝ)..1,
      phaseWeight u v • ((N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..(N : ℝ), floorObservable F u v t)) =
      (N : ℂ)⁻¹ * (∑ n ∈ Finset.range N, F n n) + (F N N - F 0 0) / (2 * (N : ℂ)) := by
  rw [← phaseAverage_reconstruction F N]
  apply intervalIntegral.integral_congr
  intro u hu
  rw [uIcc_of_le (by norm_num)] at hu
  apply intervalIntegral.integral_congr
  intro v hv
  rw [uIcc_of_le (by norm_num)] at hv
  dsimp only
  rw [phaseAverage_eq_time_integral F N u v hu hv]

