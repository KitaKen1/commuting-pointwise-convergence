    iteratedDeriv n (gaussianHeatDensity τ x) y
  let F' : ℝ → ℝ → ℝ := fun y x ↦ iteratedDeriv m (gaussianHeatDensity σ a) x *
    iteratedDeriv (n + 1) (gaussianHeatDensity τ x) y
  let B : ℝ → ℝ := fun x ↦ (gaussianHigherGrowthPolynomial m σ a).eval |x| *
    gaussianHigherDerivativeEnvelope (n + 1) τ τ (|b| + 1) x
  have hmeas (k : ℕ) (y : ℝ) : AEStronglyMeasurable (fun x : ℝ ↦
      iteratedDeriv m (gaussianHeatDensity σ a) x *
        iteratedDeriv k (gaussianHeatDensity τ x) y) :=
    (gaussianHeatDensity_iteratedDeriv_product_integrable m k σ τ a y hσ hτ).aestronglyMeasurable
  have hd (x y : ℝ) : HasDerivAt (F · x) (F' y x) y := by
    simpa only [F, F', gaussianHeatDensity_iteratedDeriv] using
      (gaussianHeatDensity_iteratedDeriv_hasDerivAt n τ x y).const_mul
        (iteratedDeriv m (gaussianHeatDensity σ a) x)
