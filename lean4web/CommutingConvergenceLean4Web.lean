  have hh := mul_le_mul_of_nonneg_left he (sq_nonneg h)
  simpa only [← Finset.mul_sum, mul_left_comm] using hh

theorem finite_antidiagonal_mesh_cubic_root_bound (s t u : Finset ℤ) (h K : ℝ)
    (f a : ℤ → ℤ → ℝ) (hK : 0 ≤ K) (hf : ∀ i ∈ s, ∀ j, 0 ≤ f i j)
    (ha : ∀ i ∈ s, ∀ j ∈ u, 0 ≤ a i j)
    (hs : ∀ i ∈ s, Summable (fun j ↦ f i j^3))
    (hb : ∀ i ∈ s, (∑' j, f i j^3) ≤ K^3 * ∑ j ∈ u, a i j^3) :
    finiteMeshCubicRootSum (s ×ˢ t) h (fun q ↦ f q.1 (-q.1-q.2)) ≤
      K * finiteMeshCubicRootSum (s ×ˢ u) h (fun q ↦ a q.1 q.2) := by
