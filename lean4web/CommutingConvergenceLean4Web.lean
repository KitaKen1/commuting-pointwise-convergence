def latticeTripleExtension (s t u : Finset ℤ) (h : ℝ)
    (A : ℤ → ℤ → ℤ → ℂ) (x : ℝ × (ℝ × ℝ)) : ℂ :=
  if ⌊x.1/h⌋ ∈ s ∧ ⌊x.2.1/h⌋ ∈ t ∧ ⌊x.2.2/h⌋ ∈ u
  then A ⌊x.1/h⌋ ⌊x.2.1/h⌋ ⌊x.2.2/h⌋ else 0

