    (∫ x, x ^ (2 * n + 1) ∂standardGaussian) = 0 := by
  simpa [standardGaussian, centralMoment, Pi.sub_apply, Pi.pow_apply]
    using TauCeti.Probability.centralMoment_id_two_mul_add_one_gaussianReal 0 1 n

