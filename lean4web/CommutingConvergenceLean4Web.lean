  apply Set.disjoint_left.mpr
  intro x hxq hxr
  exact hqr (((latticeTripleCell_mem_iff_floor h hh q x).mp hxq).symm.trans
    ((latticeTripleCell_mem_iff_floor h hh r x).mp hxr))

