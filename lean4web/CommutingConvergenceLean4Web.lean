    _ ≤ _ := cubic_trace_diagonal_upper_bound a D hD
    _ ≤ 5*‖D‖*(cubicDiagonalMass (fun i ↦ |a i|) D/2+
        cubicUpperMass (fun i ↦ |a i|) D) := by nlinarith [mul_nonneg (norm_nonneg D) hE]
    _ ≤ _ := mul_le_mul_of_nonneg_left hAE (by positivity)

omit [Fintype n] [LinearOrder n] in
theorem hermitian_cubic_cost_bound {s : Type*} [Fintype s] [DecidableEq s]
    (M : Matrix s s ℂ) (hM : M.IsHermitian)
