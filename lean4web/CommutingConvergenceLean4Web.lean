    intro t _
    unfold phaseStep
    split_ifs <;> assumption
  simpa using intervalIntegral.norm_integral_le_of_norm_le_const h

/-- A bounded observable gives a uniform bound for every integer time and phase. -/
theorem phaseAverage_norm_le (F : ℕ → ℕ → ℂ) (C : ℝ)
    (hF : ∀ i j, ‖F i j‖ ≤ C) (N : ℕ) (u v : ℝ)
    (hu : u ∈ Icc (0 : ℝ) 1) (hv : v ∈ Icc (0 : ℝ) 1) :
    ‖phaseAverage F N u v‖ ≤ C := by
