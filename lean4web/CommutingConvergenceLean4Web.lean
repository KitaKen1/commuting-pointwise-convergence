theorem exists_strictMono_finite_endpoint_partition (T : Finset ℝ) (lo hi : ℝ)
    (hlohi : lo < hi) :
    ∃ (r : ℕ → ℝ) (N : ℕ), StrictMono r ∧ r 0 = lo ∧ r (N+1) = hi ∧
      ∀ k ∈ Finset.range (N+1), ∀ x ∈ T, x ∉ Ioo (r k) (r (k+1)) := by
  classical
