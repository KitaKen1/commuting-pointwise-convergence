theorem matrixSupportedOn_of_le (P Q K : Matrix n n ℂ) (hP : P.PosSemidef)
    (hPQ : P ≤ Q) (hK : MatrixSupportedOn P K) : MatrixSupportedOn Q K := by
  intro x hx
  apply hK x
  apply (matrixVectorQuadratic_eq_zero_iff P hP x).mp
  apply le_antisymm _ (matrixVectorQuadratic_nonneg P hP x)
  have h := matrixVectorQuadratic_mono P Q hPQ x
