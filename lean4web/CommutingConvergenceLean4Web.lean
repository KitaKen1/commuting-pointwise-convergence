  obtain ⟨hXE, hEX⟩ := matrixSupportedOn_annihilate P X E hXP hPE hE.isHermitian
  have heq := spectralSylvesterSolve_spec (CFC.sqrt P) (CFC.sqrt_nonneg P).posSemidef K hKA
  have heqQ : CFC.sqrt (P + E) * X + X * CFC.sqrt (P + E) = K := by
    rw [matrix_sqrt_add_projection P E hP hE hEE hPE]
    simpa only [Matrix.add_mul, Matrix.mul_add, hXE, hEX, add_zero] using heq
  exact (spectralSylvesterSolve_unique (CFC.sqrt (P + E))
