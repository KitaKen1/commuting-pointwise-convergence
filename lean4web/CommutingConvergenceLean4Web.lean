/-! The finite three-factor Holder step, with the exact squared-mesh normalization. -/
namespace CommutingConvergence
noncomputable section
variable {ι : Type*}

def finiteCubicRootSum (s : Finset ι) (f : ι → ℝ) : ℝ :=
  (∑ i ∈ s, f i^3) ^ (1/3:ℝ)

def finiteMeshCubicRootSum (s : Finset ι) (h : ℝ) (f : ι → ℝ) : ℝ :=
  (h^2 * ∑ i ∈ s, f i^3) ^ (1/3:ℝ)

theorem finiteCubicRootSum_nonneg (s : Finset ι) (f : ι → ℝ) (hf : ∀ i ∈ s, 0 ≤ f i) :
    0 ≤ finiteCubicRootSum s f := by
  exact Real.rpow_nonneg (Finset.sum_nonneg fun i hi ↦ pow_nonneg (hf i hi) 3) _

theorem finiteMeshCubicRootSum_nonneg (s : Finset ι) (h : ℝ) (f : ι → ℝ)
    (hf : ∀ i ∈ s, 0 ≤ f i) : 0 ≤ finiteMeshCubicRootSum s h f := by
  exact Real.rpow_nonneg (mul_nonneg (sq_nonneg h)
    (Finset.sum_nonneg fun i hi ↦ pow_nonneg (hf i hi) 3)) _

theorem finiteMeshCubicRootSum_eq (s : Finset ι) (h : ℝ) (f : ι → ℝ)
    (hf : ∀ i ∈ s, 0 ≤ f i) :
    finiteMeshCubicRootSum s h f = (h^2)^(1/3:ℝ)*finiteCubicRootSum s f := by
  exact Real.mul_rpow (sq_nonneg h) (Finset.sum_nonneg fun i hi ↦ pow_nonneg (hf i hi) 3)

