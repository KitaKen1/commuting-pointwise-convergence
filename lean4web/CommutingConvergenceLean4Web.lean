  have hlo : lo ∈ S := by simp [S]
  have hhi : hi ∈ S := by simp [S]
  have hbounds (x : ℝ) (hx : x ∈ S) : lo ≤ x ∧ x ≤ hi := by
    simp only [S, Finset.mem_insert, Finset.mem_filter] at hx
    rcases hx with rfl | rfl | ⟨_, hx⟩
    · exact ⟨le_rfl, hlohi.le⟩
    · exact ⟨hlohi.le, le_rfl⟩
    · exact ⟨hx.1.le, hx.2.le⟩
  have hcard : 2 ≤ S.card := by
    have hsub : ({lo, hi} : Finset ℝ) ⊆ S := by
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact hlo
      · exact hhi
    have hc := Finset.card_le_card hsub
    simpa [hlohi.ne] using hc
  have hpos : 0 < S.card := by omega
  let e := S.orderEmbOfFin rfl
  have helo : e ⟨0, hpos⟩ = lo := by
    rw [Finset.orderEmbOfFin_zero rfl hpos]
    exact le_antisymm (Finset.min'_le S lo hlo)
      (hbounds _ (Finset.min'_mem S (Finset.card_pos.mp hpos))).1
  have hehi : e ⟨S.card-1, by omega⟩ = hi := by
    rw [Finset.orderEmbOfFin_last rfl hpos]
    exact le_antisymm (hbounds _ (Finset.max'_mem S (Finset.card_pos.mp hpos))).2
      (Finset.le_max' S hi hhi)
  let r : ℕ → ℝ := fun n ↦ if hn : n < S.card then e ⟨n, hn⟩
    else hi + (n:ℝ) - (S.card:ℝ) + 1
  have hagree (n : ℕ) (hn : n < S.card) : r n = e ⟨n, hn⟩ := by simp [r, hn]
  have hr : StrictMono r := by
    apply strictMono_nat_of_lt_succ
    intro n
    by_cases hn : n < S.card
    · by_cases hn' : n+1 < S.card
      · rw [hagree n hn, hagree (n+1) hn']
        exact e.strictMono (show (⟨n, hn⟩ : Fin S.card) < ⟨n+1, hn'⟩ from Nat.lt_succ_self n)
      · have hncard : n+1 = S.card := by omega
        have he := (hbounds _ (Finset.orderEmbOfFin_mem S rfl ⟨n, hn⟩)).2
        have hrnext : r (n+1) = hi+1 := by
