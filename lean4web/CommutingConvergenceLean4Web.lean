theorem ae_tendsto_of_uniform_approximation
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [CompleteSpace E]
    (a : ℕ → X → E) (b : ℕ → ℕ → X → E) (δ : ℕ → ℝ)
    (hδ : Tendsto δ atTop (𝓝 0))
    (hb : ∀ k, ∀ᵐ x ∂μ, CauchySeq (fun n ↦ b k n x))
    (hclose : ∀ᵐ x ∂μ, ∀ k n, dist (a n x) (b k n x) ≤ δ k) :
    ∀ᵐ x ∂μ, ∃ L : E, Tendsto (fun n ↦ a n x) atTop (𝓝 L) := by
  have hb_all : ∀ᵐ x ∂μ, ∀ k, CauchySeq (fun n ↦ b k n x) := ae_all_iff.mpr hb
  filter_upwards [hb_all, hclose] with x hx hcx
  apply cauchySeq_tendsto_of_complete
  apply cauchySeq_of_uniform_approximation
  intro ε hε
  obtain ⟨k, hk⟩ := (hδ.eventually_lt_const hε).exists
  exact ⟨fun n ↦ b k n x, hx k, fun n ↦ (hcx k n).trans hk.le⟩

end CommutingConvergence
