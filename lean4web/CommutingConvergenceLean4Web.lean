    exact pow_nonneg (hf q.1 (Finset.mem_product.1 hq).1 _) 3
  have ha' : 0 ≤ h^2 * ∑ q ∈ s ×ˢ u, a q.1 q.2^3 := by
    apply mul_nonneg (sq_nonneg h)
    apply Finset.sum_nonneg
    intro q hq
    exact pow_nonneg (ha q.1 (Finset.mem_product.1 hq).1 q.2 (Finset.mem_product.1 hq).2) 3
  have hroot : (K^3)^(1/3:ℝ) = K := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hK]
    norm_num
