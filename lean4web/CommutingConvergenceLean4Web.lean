section OriginalModule214
set_option autoImplicit false
/-! The actual Gaussian center-average on free coordinates d,x,y.
The plane point is (x,y,d-x-y). Integrability is established before Fubini. -/

open MeasureTheory
namespace CommutingConvergence
noncomputable section

def gaussianCenterWeight (σ τ ρ a b : ℝ) (d : ℝ) (p : ℝ × ℝ) : ℝ :=
  gaussianHeatDensity ρ 0 d * (gaussianHeatDensity σ a p.1 * gaussianHeatDensity τ b p.2)

def gaussianCenterAverage (σ τ ρ a b : ℝ) (f : ℝ → ℝ → ℝ → ℝ) : ℝ :=
  ∫ q : ℝ × (ℝ × ℝ), gaussianCenterWeight σ τ ρ a b q.1 q.2 *
    f q.2.1 q.2.2 (q.1-q.2.1-q.2.2)

theorem gaussianCenterWeight_nonneg (σ τ ρ a b d : ℝ) (p : ℝ × ℝ) :
    0 ≤ gaussianCenterWeight σ τ ρ a b d p := by
  unfold gaussianCenterWeight
  exact mul_nonneg (gaussianHeatDensity_nonneg _ _ _)
    (mul_nonneg (gaussianHeatDensity_nonneg _ _ _) (gaussianHeatDensity_nonneg _ _ _))

theorem gaussianCenterWeight_continuous (σ τ ρ a b : ℝ) :
    Continuous (fun q : ℝ × (ℝ × ℝ) ↦ gaussianCenterWeight σ τ ρ a b q.1 q.2) := by
  unfold gaussianCenterWeight gaussianHeatDensity
  fun_prop

theorem gaussianCenterWeight_integrable (σ τ ρ a b : ℝ)
    (hσ : 0 < σ) (hτ : 0 < τ) (hρ : 0 < ρ) :
    Integrable (fun q : ℝ × (ℝ × ℝ) ↦ gaussianCenterWeight σ τ ρ a b q.1 q.2) := by
  exact (gaussianHeatDensity_center_integrable ρ 0 hρ.le).mul_prod
    ((gaussianHeatDensity_center_integrable σ a hσ.le).mul_prod
      (gaussianHeatDensity_center_integrable τ b hτ.le))

theorem gaussianCenterWeight_integral (σ τ ρ a b : ℝ)
    (hσ : 0 < σ) (hτ : 0 < τ) (hρ : 0 < ρ) :
    (∫ q : ℝ × (ℝ × ℝ), gaussianCenterWeight σ τ ρ a b q.1 q.2) = 1 := by
  unfold gaussianCenterWeight
  change (∫ q : ℝ × (ℝ × ℝ), gaussianHeatDensity ρ 0 q.1 *
    (gaussianHeatDensity σ a q.2.1 * gaussianHeatDensity τ b q.2.2)
      ∂volume.prod (volume.prod volume)) = 1
  rw [integral_prod_mul (gaussianHeatDensity ρ 0)
      (fun p : ℝ × ℝ ↦ gaussianHeatDensity σ a p.1 * gaussianHeatDensity τ b p.2)
      (μ := volume) (ν := volume.prod volume),
    integral_prod_mul (gaussianHeatDensity σ a) (gaussianHeatDensity τ b)
      (μ := volume) (ν := volume), gaussianHeatDensity_center_integral _ _ hρ,
    gaussianHeatDensity_center_integral _ _ hσ, gaussianHeatDensity_center_integral _ _ hτ]
  norm_num

theorem gaussian_pair_bounded_integrable (σ τ a b : ℝ) (f : ℝ × ℝ → ℝ)
    (hσ : 0 < σ) (hτ : 0 < τ) (hf : Continuous f) (C : ℝ) (hb : ∀ p, |f p| ≤ C) :
    Integrable (fun p : ℝ × ℝ ↦
      (gaussianHeatDensity σ a p.1 * gaussianHeatDensity τ b p.2) * f p) := by
  have hw := (gaussianHeatDensity_center_integrable σ a hσ.le).mul_prod
    (gaussianHeatDensity_center_integrable τ b hτ.le)
  have hc : Continuous (fun p : ℝ × ℝ ↦
      (gaussianHeatDensity σ a p.1 * gaussianHeatDensity τ b p.2) * f p) := by
    unfold gaussianHeatDensity
    fun_prop
  apply (hw.const_mul C).mono' hc.aestronglyMeasurable
  apply Filter.Eventually.of_forall
  intro p
  simp only [Real.norm_eq_abs, abs_mul,
    abs_of_nonneg (gaussianHeatDensity_nonneg σ a p.1),
    abs_of_nonneg (gaussianHeatDensity_nonneg τ b p.2)]
  exact (mul_le_mul_of_nonneg_left (hb p)
    (mul_nonneg (gaussianHeatDensity_nonneg _ _ _) (gaussianHeatDensity_nonneg _ _ _))).trans_eq
      (mul_comm _ _)

theorem gaussianCenterAverage_bounded_integrable (σ τ ρ a b : ℝ) (f : ℝ → ℝ → ℝ → ℝ)
    (hσ : 0 < σ) (hτ : 0 < τ) (hρ : 0 < ρ)
    (hf : Continuous (fun q : ℝ × (ℝ × ℝ) ↦ f q.2.1 q.2.2 (q.1-q.2.1-q.2.2)))
    (C : ℝ) (hb : ∀ x y z, |f x y z| ≤ C) :
    Integrable (fun q : ℝ × (ℝ × ℝ) ↦ gaussianCenterWeight σ τ ρ a b q.1 q.2 *
      f q.2.1 q.2.2 (q.1-q.2.1-q.2.2)) := by
  apply ((gaussianCenterWeight_integrable σ τ ρ a b hσ hτ hρ).const_mul C).mono'
    ((gaussianCenterWeight_continuous σ τ ρ a b).mul hf).aestronglyMeasurable
  apply Filter.Eventually.of_forall
  intro q
  simp only [Pi.mul_apply, Real.norm_eq_abs, abs_mul,
    abs_of_nonneg (gaussianCenterWeight_nonneg σ τ ρ a b _ _)]
  exact (mul_le_mul_of_nonneg_left (hb _ _ _)
    (gaussianCenterWeight_nonneg σ τ ρ a b _ _)).trans_eq (mul_comm _ _)

/-- This is precisely the plane integral followed by the Gaussian d-average. -/
theorem gaussianCenterAverage_eq_plane_integral (σ τ ρ a b : ℝ) (f : ℝ → ℝ → ℝ → ℝ)
    (hi : Integrable (fun q : ℝ × (ℝ × ℝ) ↦ gaussianCenterWeight σ τ ρ a b q.1 q.2 *
      f q.2.1 q.2.2 (q.1-q.2.1-q.2.2))) :
    gaussianCenterAverage σ τ ρ a b f = ∫ d, gaussianHeatDensity ρ 0 d *
      ∫ p : ℝ × ℝ, gaussianHeatDensity σ a p.1 * gaussianHeatDensity τ b p.2 *
        f p.1 p.2 (d-p.1-p.2) := by
  unfold gaussianCenterAverage
  change Integrable _ (volume.prod volume) at hi
  change (∫ q : ℝ × (ℝ × ℝ), gaussianCenterWeight σ τ ρ a b q.1 q.2 *
    f q.2.1 q.2.2 (q.1-q.2.1-q.2.2) ∂volume.prod volume) = _
  rw [integral_prod _ hi]
  congr 1
  funext d
  rw [← integral_const_mul]
  congr 1
  funext p
  unfold gaussianCenterWeight
  ring

theorem gaussianHeatDensity_translate_center (σ c d x y : ℝ) :
    gaussianHeatDensity σ c (d-x-y) = gaussianHeatDensity σ (c+x+y) d := by
  unfold gaussianHeatDensity
  congr 3
  ring

theorem gaussianHeatDensity_reflect_sum (σ c x y : ℝ) :
    gaussianHeatDensity σ (c+x+y) 0 = gaussianHeatDensity σ (-c-x) y := by
  unfold gaussianHeatDensity
  congr 3
  ring

/-- The third coordinate has mean -a-b and variance sigma+tau+rho. -/
theorem gaussianCenterAverage_third_density (σ τ ρ ν a b c : ℝ)
    (hσ : 0 < σ) (hτ : 0 < τ) (hρ : 0 < ρ) (hν : 0 < ν) :
    gaussianCenterAverage σ τ ρ a b (fun _ _ z ↦ gaussianHeatDensity ν c z) =
      gaussianHeatDensity (σ+τ+ρ+ν) c (-a-b) := by
  have hf : Continuous (fun q : ℝ × (ℝ × ℝ) ↦ gaussianHeatDensity ν c (q.1-q.2.1-q.2.2)) := by
    unfold gaussianHeatDensity
    fun_prop
  have hb (x y z : ℝ) : |gaussianHeatDensity ν c z| ≤ (Real.sqrt (2*Real.pi*ν))⁻¹ := by
    rw [abs_of_nonneg (gaussianHeatDensity_nonneg _ _ _)]
    exact gaussianHeatDensity_le_peak _ _ _ hν
  have hi := gaussianCenterAverage_bounded_integrable σ τ ρ a b _ hσ hτ hρ hf _ hb
  unfold gaussianCenterAverage
  change Integrable _ (volume.prod volume) at hi
  change (∫ q : ℝ × (ℝ × ℝ), gaussianCenterWeight σ τ ρ a b q.1 q.2 *
    gaussianHeatDensity ν c (q.1-q.2.1-q.2.2) ∂volume.prod volume) = _
  rw [integral_prod_symm _ hi]
  have hd (p : ℝ × ℝ) :
      (∫ d, gaussianCenterWeight σ τ ρ a b d p * gaussianHeatDensity ν c (d-p.1-p.2)) =
        (gaussianHeatDensity σ a p.1 * gaussianHeatDensity τ b p.2) *
          gaussianHeatDensity (ρ+ν) (c+p.1+p.2) 0 := by
    simp_rw [gaussianHeatDensity_translate_center]
    unfold gaussianCenterWeight
    have he : (fun d ↦ gaussianHeatDensity ρ 0 d *
        (gaussianHeatDensity σ a p.1 * gaussianHeatDensity τ b p.2) * gaussianHeatDensity ν (c+p.1+p.2) d) =
        fun d ↦ (gaussianHeatDensity σ a p.1 * gaussianHeatDensity τ b p.2) *
          (gaussianHeatDensity ρ 0 d * gaussianHeatDensity ν (c+p.1+p.2) d) := by funext d; ring
    rw [he, integral_const_mul, gaussianHeatDensity_product_integral _ _ _ _ hρ hν,
      gaussianHeatDensity_symm (ρ+ν) 0 (c+p.1+p.2)]
  simp_rw [hd, gaussianHeatDensity_reflect_sum]
  have hp := gaussian_pair_bounded_integrable σ τ a b
    (fun p ↦ gaussianHeatDensity (ρ+ν) (-c-p.1) p.2) hσ hτ (by
      unfold gaussianHeatDensity; fun_prop) _ (fun p ↦ by
      rw [abs_of_nonneg (gaussianHeatDensity_nonneg _ _ _)]
      exact gaussianHeatDensity_le_peak _ _ _ (add_pos hρ hν))
  change Integrable _ (volume.prod volume) at hp
  change (∫ p : ℝ × ℝ, (gaussianHeatDensity σ a p.1 * gaussianHeatDensity τ b p.2) *
    gaussianHeatDensity (ρ+ν) (-c-p.1) p.2 ∂volume.prod volume) = _
  rw [integral_prod _ hp]
  have hy (x : ℝ) : (∫ y, (gaussianHeatDensity σ a x * gaussianHeatDensity τ b y) *
      gaussianHeatDensity (ρ+ν) (-c-x) y) =
        gaussianHeatDensity σ a x * gaussianHeatDensity (τ+(ρ+ν)) b (-c-x) := by
    simp_rw [mul_assoc]
    rw [integral_const_mul, gaussianHeatDensity_product_integral _ _ _ _ hτ (add_pos hρ hν)]
  simp_rw [hy]
  have he (x : ℝ) : gaussianHeatDensity (τ+(ρ+ν)) b (-c-x) =
      gaussianHeatDensity (τ+(ρ+ν)) (-b-c) x := by
    unfold gaussianHeatDensity
    congr 3
    ring
  simp_rw [he]
  rw [gaussianHeatDensity_product_integral _ _ _ _ hσ (by positivity)]
  unfold gaussianHeatDensity
  congr 3 <;> ring

theorem gaussianCenterAverage_const_mul (σ τ ρ a b k : ℝ) (f : ℝ → ℝ → ℝ → ℝ) :
    gaussianCenterAverage σ τ ρ a b (fun x y z ↦ k * f x y z) =
      k * gaussianCenterAverage σ τ ρ a b f := by
  unfold gaussianCenterAverage
  calc
    _ = ∫ q : ℝ × (ℝ × ℝ), k * (gaussianCenterWeight σ τ ρ a b q.1 q.2 *
        f q.2.1 q.2.2 (q.1-q.2.1-q.2.2)) := by
      congr 1
      funext q
      ring
    _ = _ := integral_const_mul _ _

theorem gaussianCenterAverage_const (σ τ ρ a b k : ℝ)
    (hσ : 0 < σ) (hτ : 0 < τ) (hρ : 0 < ρ) :
    gaussianCenterAverage σ τ ρ a b (fun _ _ _ ↦ k) = k := by
  unfold gaussianCenterAverage
  rw [integral_mul_const, gaussianCenterWeight_integral _ _ _ _ _ hσ hτ hρ, one_mul]

theorem gaussianCenterAverage_finsetSum {ι : Type*} (σ τ ρ a b : ℝ) (s : Finset ι)
    (f : ι → ℝ → ℝ → ℝ → ℝ)
    (hi : ∀ j ∈ s, Integrable (fun q : ℝ × (ℝ × ℝ) ↦ gaussianCenterWeight σ τ ρ a b q.1 q.2 *
      f j q.2.1 q.2.2 (q.1-q.2.1-q.2.2))) :
    gaussianCenterAverage σ τ ρ a b (fun x y z ↦ ∑ j ∈ s, f j x y z) =
      ∑ j ∈ s, gaussianCenterAverage σ τ ρ a b (f j) := by
  unfold gaussianCenterAverage
  simp_rw [Finset.mul_sum]
  rw [integral_finsetSum _ hi]

theorem gaussianCenterAverage_density_integrable (σ τ ρ ν a b c : ℝ)
    (coord : ℝ → ℝ → ℝ → ℝ)
    (hσ : 0 < σ) (hτ : 0 < τ) (hρ : 0 < ρ) (hν : 0 < ν)
    (hc : Continuous (fun q : ℝ × (ℝ × ℝ) ↦ coord q.2.1 q.2.2 (q.1-q.2.1-q.2.2))) :
    Integrable (fun q : ℝ × (ℝ × ℝ) ↦ gaussianCenterWeight σ τ ρ a b q.1 q.2 *
      gaussianHeatDensity ν c (coord q.2.1 q.2.2 (q.1-q.2.1-q.2.2))) := by
  refine gaussianCenterAverage_bounded_integrable σ τ ρ a b
    (fun x y z ↦ gaussianHeatDensity ν c (coord x y z)) hσ hτ hρ ?_
    (Real.sqrt (2*Real.pi*ν))⁻¹ ?_
  · have hg : Continuous (gaussianHeatDensity ν c) := by
      unfold gaussianHeatDensity
      fun_prop
    exact hg.comp hc
  · intro x y z
    rw [abs_of_nonneg (gaussianHeatDensity_nonneg _ _ _)]
    exact gaussianHeatDensity_le_peak _ _ _ hν

theorem gaussianCenterAverage_first_density (σ τ ρ ν a b c : ℝ)
    (hσ : 0 < σ) (hτ : 0 < τ) (hρ : 0 < ρ) (hν : 0 < ν) :
    gaussianCenterAverage σ τ ρ a b (fun x _ _ ↦ gaussianHeatDensity ν c x) =
      gaussianHeatDensity (σ+ν) c a := by
  unfold gaussianCenterAverage gaussianCenterWeight
  change (∫ q : ℝ × (ℝ × ℝ), gaussianHeatDensity ρ 0 q.1 *
    (gaussianHeatDensity σ a q.2.1 * gaussianHeatDensity τ b q.2.2) * gaussianHeatDensity ν c q.2.1
      ∂volume.prod (volume.prod volume)) = _
  have he : (fun q : ℝ × (ℝ × ℝ) ↦ gaussianHeatDensity ρ 0 q.1 *
      (gaussianHeatDensity σ a q.2.1 * gaussianHeatDensity τ b q.2.2) * gaussianHeatDensity ν c q.2.1) =
      fun q ↦ gaussianHeatDensity ρ 0 q.1 *
        ((gaussianHeatDensity σ a q.2.1 * gaussianHeatDensity ν c q.2.1) * gaussianHeatDensity τ b q.2.2) := by
    funext q
    ring
  rw [he, integral_prod_mul (gaussianHeatDensity ρ 0)
    (fun p : ℝ × ℝ ↦ (gaussianHeatDensity σ a p.1 * gaussianHeatDensity ν c p.1) * gaussianHeatDensity τ b p.2)
    (μ := volume) (ν := volume.prod volume),
    integral_prod_mul (fun x ↦ gaussianHeatDensity σ a x * gaussianHeatDensity ν c x)
      (gaussianHeatDensity τ b) (μ := volume) (ν := volume),
    gaussianHeatDensity_product_integral _ _ _ _ hσ hν,
    gaussianHeatDensity_center_integral _ _ hρ, gaussianHeatDensity_center_integral _ _ hτ,
    one_mul, mul_one, gaussianHeatDensity_symm]

theorem gaussianCenterAverage_second_density (σ τ ρ ν a b c : ℝ)
    (hσ : 0 < σ) (hτ : 0 < τ) (hρ : 0 < ρ) (hν : 0 < ν) :
    gaussianCenterAverage σ τ ρ a b (fun _ y _ ↦ gaussianHeatDensity ν c y) =
      gaussianHeatDensity (τ+ν) c b := by
  unfold gaussianCenterAverage gaussianCenterWeight
  change (∫ q : ℝ × (ℝ × ℝ), gaussianHeatDensity ρ 0 q.1 *
    (gaussianHeatDensity σ a q.2.1 * gaussianHeatDensity τ b q.2.2) * gaussianHeatDensity ν c q.2.2
      ∂volume.prod (volume.prod volume)) = _
  simp_rw [mul_assoc]
  rw [integral_prod_mul (gaussianHeatDensity ρ 0)
    (fun p : ℝ × ℝ ↦ gaussianHeatDensity σ a p.1 * (gaussianHeatDensity τ b p.2 * gaussianHeatDensity ν c p.2))
    (μ := volume) (ν := volume.prod volume),
    integral_prod_mul (gaussianHeatDensity σ a)
      (fun y ↦ gaussianHeatDensity τ b y * gaussianHeatDensity ν c y) (μ := volume) (ν := volume),
    gaussianHeatDensity_product_integral _ _ _ _ hτ hν,
    gaussianHeatDensity_center_integral _ _ hρ, gaussianHeatDensity_center_integral _ _ hσ,
    one_mul, one_mul, gaussianHeatDensity_symm]

end
end CommutingConvergence
end OriginalModule214


-- Source: CommutingConvergence.MatrixEntryGradient
section OriginalModule215
set_option autoImplicit false
/-! Entrywise bounds and the Hilbert--Schmidt gradient for rectangular energy.
No invertibility, common support, or fixed-rank hypothesis is used. -/

open Matrix
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator
namespace CommutingConvergence
noncomputable section

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

def rectangularTracePair (R D : Matrix m n ℂ) : ℝ := (Matrix.trace (Rᴴ * D)).re

def matrixRowL2 (R : Matrix m n ℂ) (i : m) : ℝ := Real.sqrt (∑ j, ‖R i j‖ ^ 2)
def matrixColL2 (R : Matrix m n ℂ) (j : n) : ℝ := Real.sqrt (∑ i, ‖R i j‖ ^ 2)

omit [DecidableEq m] [DecidableEq n] in
theorem rectangularTracePair_comm (R D : Matrix m n ℂ) :
    rectangularTracePair R D = rectangularTracePair D R := by
  have h := congrArg Complex.re (Matrix.trace_conjTranspose (Dᴴ * R))
  simpa only [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose,
    Complex.star_def, Complex.conj_re, rectangularTracePair] using h

omit [DecidableEq m] [DecidableEq n] in
theorem rectangularTracePair_eq_entries (R D : Matrix m n ℂ) :
    rectangularTracePair R D = ∑ i, ∑ j, (star (R i j) * D i j).re := by
  simp only [rectangularTracePair, Matrix.trace, Matrix.diag, Matrix.mul_apply,
    Matrix.conjTranspose_apply, Complex.re_sum]
  exact Finset.sum_comm

omit [DecidableEq m] [DecidableEq n] in
theorem rectangularTracePair_abs_le_entries (R D : Matrix m n ℂ) :
    |rectangularTracePair R D| ≤ ∑ i, ∑ j, ‖R i j‖ * ‖D i j‖ := by
  rw [rectangularTracePair_eq_entries]
  calc
    _ ≤ ∑ i, |∑ j, (star (R i j) * D i j).re| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i, ∑ j, |(star (R i j) * D i j).re| :=
      Finset.sum_le_sum fun i _ ↦ Finset.abs_sum_le_sum_abs _ _
    _ ≤ _ := Finset.sum_le_sum fun i _ ↦ Finset.sum_le_sum fun j _ ↦ by
      simpa only [norm_mul, norm_star] using Complex.abs_re_le_norm (star (R i j) * D i j)

omit [Fintype n] [DecidableEq m] [DecidableEq n] in
theorem columnGram_diagonal_re_eq_column_sq (R : Matrix m n ℂ) (j : n) :
    ((Rᴴ * R) j j).re = ∑ i, ‖R i j‖ ^ 2 := by
  simp only [Matrix.mul_apply, Matrix.conjTranspose_apply, Complex.re_sum,
    Complex.star_def, ← Complex.normSq_eq_conj_mul_self, Complex.ofReal_re,
    Complex.normSq_eq_norm_sq]

omit [DecidableEq m] in
theorem sqrt_columnGram_column_sq (R : Matrix m n ℂ) (j : n) :
    (∑ k, ‖CFC.sqrt (Rᴴ * R) k j‖ ^ 2) = ∑ i, ‖R i j‖ ^ 2 := by
  let S := CFC.sqrt (Rᴴ * R)
  have hS : S.IsHermitian := (CFC.sqrt_nonneg (Rᴴ * R)).posSemidef.isHermitian
  have hs : S * S = Rᴴ * R := CFC.sqrt_mul_sqrt_self _
    (Matrix.posSemidef_conjTranspose_mul_self R).nonneg
  rw [← columnGram_diagonal_re_eq_column_sq S j, hS.eq, hs,
    columnGram_diagonal_re_eq_column_sq]

omit [DecidableEq m] in
/-- The entry-gradient bound in the saved rank-change lemma. -/
theorem rectangular_root_gradient_entry_le (R : Matrix m n ℂ) (i : m) (j : n) :
    ‖(R * CFC.sqrt (Rᴴ * R)) i j‖ ≤ matrixRowL2 R i * matrixColL2 R j := by
  calc
    _ ≤ ∑ k, ‖R i k * CFC.sqrt (Rᴴ * R) k j‖ := by
      rw [Matrix.mul_apply]
      exact norm_sum_le _ _
    _ = ∑ k, ‖R i k‖ * ‖CFC.sqrt (Rᴴ * R) k j‖ := by simp only [norm_mul]
    _ ≤ Real.sqrt (∑ k, ‖R i k‖ ^ 2) * Real.sqrt (∑ k, ‖CFC.sqrt (Rᴴ * R) k j‖ ^ 2) :=
      Real.sum_mul_le_sqrt_mul_sqrt _ _ _
    _ = _ := by rw [sqrt_columnGram_column_sq]; rfl

omit [DecidableEq m] in
theorem matrixEnergyGradientCLM_rectangular_tangent (R D : Matrix m n ℂ) :
    matrixEnergyGradientCLM (Rᴴ * R) (Dᴴ * R + Rᴴ * D) =
      3 * rectangularTracePair (R * CFC.sqrt (Rᴴ * R)) D := by
  let S := CFC.sqrt (Rᴴ * R)
  have hS : S.IsHermitian := (CFC.sqrt_nonneg (Rᴴ * R)).posSemidef.isHermitian
  have h1 : (Matrix.trace (S * (Dᴴ * R))).re = rectangularTracePair D (R * S) := by
    rw [← Matrix.mul_assoc, Matrix.trace_mul_cycle, Matrix.trace_mul_comm]
    rfl
  have h2 : (Matrix.trace (S * (Rᴴ * D))).re = rectangularTracePair (R * S) D := by
    simp only [rectangularTracePair, Matrix.conjTranspose_mul, hS.eq, Matrix.mul_assoc]
  rw [matrixEnergyGradientCLM_apply, Matrix.mul_add, Matrix.trace_add, Complex.add_re]
  change (3 / 2 : ℝ) * ((Matrix.trace (S * (Dᴴ * R))).re + (Matrix.trace (S * (Rᴴ * D))).re) = _
  rw [h1, h2, rectangularTracePair_comm D]
  ring

omit [DecidableEq m] in
theorem rectangular_energy_tangent_abs_le_entries (R D : Matrix m n ℂ) :
    |matrixEnergyGradientCLM (Rᴴ * R) (Dᴴ * R + Rᴴ * D)| ≤
      3 * ∑ i, ∑ j, matrixRowL2 R i * matrixColL2 R j * ‖D i j‖ := by
  rw [matrixEnergyGradientCLM_rectangular_tangent, abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 3)]
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  exact (rectangularTracePair_abs_le_entries (R * CFC.sqrt (Rᴴ * R)) D).trans
    (Finset.sum_le_sum fun i _ ↦ Finset.sum_le_sum fun j _ ↦
      mul_le_mul_of_nonneg_right (rectangular_root_gradient_entry_le R i j) (norm_nonneg _))

end
end CommutingConvergence
end OriginalModule215


-- Source: CommutingConvergence.RectangularEnergyFTC
section OriginalModule216
set_option autoImplicit false
/-! Integrating the first derivative along rectangular paths, including
rank changes. Affine switches have a continuous derivative automatically. -/

open Matrix Set MeasureTheory
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator
namespace CommutingConvergence
noncomputable section
variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

@[instance_reducible] local instance switchPathAdd : AddCommGroup (Matrix m n ℂ) :=
  (inferInstance : NormedAddCommGroup (Matrix m n ℂ)).toAddCommGroup
@[instance_reducible] local instance switchPathModule : Module ℝ (Matrix m n ℂ) :=
  (inferInstance : NormedSpace ℝ (Matrix m n ℂ)).toModule
@[instance_reducible] local instance switchPathTopology : TopologicalSpace (Matrix m n ℂ) :=
  (inferInstance : MetricSpace (Matrix m n ℂ)).toPseudoMetricSpace.toUniformSpace.toTopologicalSpace

def matrixAffineSegment (R₀ R₁ : Matrix m n ℂ) (t : ℝ) : Matrix m n ℂ :=
  (1 - t) • R₀ + t • R₁

omit [DecidableEq m] in
