section OriginalModule81
set_option autoImplicit false
/-! Column-weighted rectangular Grams use the fixed kernel of the adjoint.
Exact energy equality transports the actual first and second derivatives
back to the original column Gram, whose kernel need not be fixed. -/

open Matrix Filter Set
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator Topology

namespace CommutingConvergence

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

noncomputable section

@[instance_reducible] local instance : AddCommGroup (Matrix m m ℂ) :=
  (inferInstance : NormedAddCommGroup (Matrix m m ℂ)).toAddCommGroup
@[instance_reducible] local instance : Module ℝ (Matrix m m ℂ) :=
  (inferInstance : NormedSpace ℝ (Matrix m m ℂ)).toModule
@[instance_reducible] local instance : TopologicalSpace (Matrix m m ℂ) :=
  (inferInstance : MetricSpace (Matrix m m ℂ)).toPseudoMetricSpace.toUniformSpace.toTopologicalSpace

def columnScaleGram (R : Matrix m n ℂ) (d : ℝ → n → ℂ) (t : ℝ) : Matrix m m ℂ :=
  (R * Matrix.diagonal (d t)) * (R * Matrix.diagonal (d t))ᴴ

omit [Fintype m] [DecidableEq m] in
theorem columnScaleGram_eq_rowScaleGram_adjoint (R : Matrix m n ℂ) (d : ℝ → n → ℂ)
    (t : ℝ) : columnScaleGram R d t = rowScaleGram Rᴴ (fun s i ↦ star (d s i)) t := by
  change columnScaleGram R d t = rowScaleGram Rᴴ (fun s ↦ star (d s)) t
  simp only [columnScaleGram, rowScaleGram, Matrix.conjTranspose_mul,
    Matrix.diagonal_conjTranspose, Matrix.conjTranspose_conjTranspose, star_star]

/-- The original Gram's energy is differentiated using the fixed-kernel opposite Gram. -/
theorem trace_rpow_columnScaleGram_hasDerivAt (R : Matrix m n ℂ) (d : ℝ → n → ℂ)
    (K : Matrix m m ℂ) (t : ℝ) (hP : HasDerivAt (columnScaleGram R d) K t)
    (hd : ∀ᶠ s in 𝓝 t, ∀ i, d s i ≠ 0) :
    HasDerivAt (fun s ↦ (Matrix.trace (CFC.rpow
      ((R * Matrix.diagonal (d s))ᴴ * (R * Matrix.diagonal (d s))) (3 / 2 : ℝ))).re)
      (matrixEnergyGradientCLM (columnScaleGram R d t) K) t := by
  have he : columnScaleGram R d = rowScaleGram Rᴴ (fun s i ↦ star (d s i)) :=
    funext (columnScaleGram_eq_rowScaleGram_adjoint R d)
  have h := trace_rpow_rowScaleGram_hasDerivAt Rᴴ (fun s i ↦ star (d s i)) K t
    (by rwa [← he]) (hd.mono fun s hs i ↦ star_ne_zero.mpr (hs i))
  have h' : HasDerivAt (fun s ↦
      (Matrix.trace (CFC.rpow (columnScaleGram R d s) (3 / 2 : ℝ))).re)
      (matrixEnergyGradientCLM (columnScaleGram R d t) K) t := by
    simpa only [← he] using h
  apply h'.congr_of_eventuallyEq
  exact Eventually.of_forall fun s ↦ trace_rpow_rectangular_grams_eq (R * Matrix.diagonal (d s))

theorem trace_rpow_columnScaleGram_second_deriv (R : Matrix m n ℂ) (d : ℝ → n → ℂ)
    (J : Matrix m m ℂ) (t : ℝ) (hD : HasDerivAt (deriv (columnScaleGram R d)) J t)
    (hDiff : ∀ᶠ s in 𝓝 t, DifferentiableAt ℝ (columnScaleGram R d) s)
    (hd : ∀ᶠ s in 𝓝 t, ∀ i, d s i ≠ 0) :
    deriv (deriv (fun s ↦ (Matrix.trace (CFC.rpow
      ((R * Matrix.diagonal (d s))ᴴ * (R * Matrix.diagonal (d s))) (3 / 2 : ℝ))).re)) t =
      gramSylvesterCost (columnScaleGram R d t) (deriv (columnScaleGram R d) t) +
        matrixEnergyGradientCLM (columnScaleGram R d t) J := by
  have he : columnScaleGram R d = rowScaleGram Rᴴ (fun s i ↦ star (d s i)) :=
    funext (columnScaleGram_eq_rowScaleGram_adjoint R d)
  have heTrace : (fun s ↦ (Matrix.trace (CFC.rpow
      ((R * Matrix.diagonal (d s))ᴴ * (R * Matrix.diagonal (d s))) (3 / 2 : ℝ))).re) =
      (fun s ↦ (Matrix.trace (CFC.rpow (columnScaleGram R d s) (3 / 2 : ℝ))).re) :=
    funext fun s ↦ trace_rpow_rectangular_grams_eq (R * Matrix.diagonal (d s))
  rw [heTrace]
  have h := trace_rpow_rowScaleGram_second_deriv Rᴴ (fun s i ↦ star (d s i)) J t
    (by rwa [← he]) (by rwa [← he]) (hd.mono fun s hs i ↦ star_ne_zero.mpr (hs i))
  simpa only [← he] using h

end

end CommutingConvergence
