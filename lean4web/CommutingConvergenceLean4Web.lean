  have ho₂ : (∑ i,∑ j,∑ k,if k < i then if k < j then w i j k else 0 else 0) = ∑ i,∑ j,∑ k,O i j k := by
    calc
      _ = ∑ i,∑ j,∑ k,O k i j := by
        apply Finset.sum_congr rfl
        intro i _
        apply Finset.sum_congr rfl
        intro j _
        apply Finset.sum_congr rfl
        intro k _
        exact congrArg (fun z : ℂ ↦ if k < i then if k < j then z else 0 else 0) (hw k i j).symm
