  have hdiag : unitaryConj (star U) A = Matrix.diagonal (fun i ↦ (a i : ℂ)) :=
    hA.isHermitian.conjStarAlgAut_star_eigenvectorUnitary
  have hBA : Bᴴ * B = unitaryConj (star U) (Rᴴ * R) := by
    simp only [B, unitaryConj, Unitary.conjStarAlgAut_star_apply,
      Matrix.conjTranspose_mul, Matrix.star_eq_conjTranspose, Matrix.mul_assoc]
  have hgram : Bᴴ * B = Matrix.diagonal (fun i ↦ (a i : ℂ) ^ 2) := by
    rw [hBA]
