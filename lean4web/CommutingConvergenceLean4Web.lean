/-- Cyclicity supplies the factor one half directly from the Sylvester equation. -/
theorem trace_sylvester_weight (A X K : Matrix n n ℂ) (heq : A * X + X * A = K) :
    (Matrix.trace ((A * A) * X)).re = (1 / 2 : ℝ) * (Matrix.trace (A * K)).re := by
  have h := congrArg (fun M : Matrix n n ℂ ↦ (Matrix.trace (A * M)).re) heq
  have hc : Matrix.trace (A * (X * A)) = Matrix.trace (A * (A * X)) := by
    rw [← Matrix.mul_assoc A X A, Matrix.trace_mul_comm (A * X) A]
  simp only [Matrix.mul_add, Matrix.trace_add, Complex.add_re] at h
  rw [hc, ← Matrix.mul_assoc] at h
  linarith

/-- The gradient formula is an actual derivative within the positive cone. -/
theorem gramRootEnergy_hasFDerivWithinAt_posDef (P : Matrix n n ℂ) (hP : P.PosDef) :
    HasFDerivWithinAt gramRootEnergy (matrixEnergyGradientCLM P)
      {Q : Matrix n n ℂ | 0 ≤ Q} P := by
  let A := CFC.sqrt P
  let S := spectralSylvesterCLM A (CFC.sqrt_nonneg P).posSemidef.isHermitian
  have hr := matrix_sqrt_hasFDerivWithinAt_posDef P hP
  have hm := (hasFDerivWithinAt_id (𝕜 := ℝ) P {Q : Matrix n n ℂ | 0 ≤ Q}).mul' hr
