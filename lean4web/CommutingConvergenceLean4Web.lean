  unfold gaussianEdgeArray gaussianTwoSidedArray gaussianBlockSqrtWeight
  simp only [ite_true, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (show 0 ≤ gaussianHeatSqrtWeight h σ (u i) x from Real.sqrt_nonneg _),
    abs_of_nonneg (show 0 ≤ gaussianHeatSqrtWeight h τ (v j) y from Real.sqrt_nonneg _)]
  ring

omit [Fintype m] [Fintype n] [Fintype p] [DecidableEq m] [DecidableEq n] [DecidableEq p] in
theorem gaussianEdgeArray_norm_sq_entry (A : Matrix m n ℂ) (h σ τ : ℝ)
    (u : m → ℝ) (v : n → ℝ) (x y : ℝ) (hh : 0 ≤ h) (i : m) (j : n) :
    ‖gaussianEdgeArray A h σ τ u v x y i j‖ ^ 2 =
      (h * gaussianHeatDensity σ (u i) x) * (h * gaussianHeatDensity τ (v j) y) * ‖A i j‖ ^ 2 := by
  rw [gaussianEdgeArray_norm_entry, mul_pow, mul_pow,
    gaussianHeatSqrtWeight_sq _ _ _ _ hh, gaussianHeatSqrtWeight_sq _ _ _ _ hh]

omit [Fintype m] [Fintype p] [DecidableEq m] [DecidableEq n] [DecidableEq p] in
theorem gaussianEdgeArray_rowL2 (A : Matrix m n ℂ) (h σ τ : ℝ)
    (u : m → ℝ) (v : n → ℝ) (x y : ℝ) (hh : 0 ≤ h) (i : m) :
