      _ ≤ ‖2 * gaussianHeatDensity 1 0 x‖ + ‖iteratedDeriv 2 (gaussianHeatDensity 1 0) x‖ := norm_sub_le _ _
      _ = 2 * |gaussianHeatDensity 1 0 x| + |iteratedDeriv 2 (gaussianHeatDensity 1 0) x| := by
        simp [norm_mul, Real.norm_eq_abs]
