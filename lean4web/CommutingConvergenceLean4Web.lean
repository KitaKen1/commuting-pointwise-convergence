  · intro n hn m hm he
    omega
  · intro k hk
    have hk' := Finset.mem_Icc.1 hk
    refine ⟨(k-(j-(N:ℤ))).toNat, ?_, ?_⟩
    · simp only [Finset.mem_range]
      omega
    · omega
  · intro n hn
    rfl

theorem finite_integer_support_in_block (s : Finset ℤ) (j : ℤ) :
    ∃ N : ℕ, s ⊆ Finset.Icc (j-(N:ℤ)) (j+(N:ℤ)) := by
  refine ⟨s.sup (fun k ↦ (k-j).natAbs), ?_⟩
