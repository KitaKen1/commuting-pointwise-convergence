  · change matrixMulVecCLM x (∫ ω, K ω ∂μ) = 0
    rw [← (matrixMulVecCLM x).integral_comp_comm hKi]
    exact integral_eq_zero_of_ae (hae.mono fun _ h ↦ h.1)
  · change matrixAdjointMulVecCLM x (∫ ω, K ω ∂μ) = 0
    rw [← (matrixAdjointMulVecCLM x).integral_comp_comm hKi]
    exact integral_eq_zero_of_ae (hae.mono fun _ h ↦ h.2)

