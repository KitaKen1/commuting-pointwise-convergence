theorem commuting_measurable_inverses_l2_convergence
    (T S Ti Si : X → X) (hTm : Measurable T) (hSm : Measurable S)
    (hTim : Measurable Ti) (hSim : Measurable Si)
    (hTiT : Function.LeftInverse Ti T) (hTTi : Function.RightInverse Ti T)
    (hSiS : Function.LeftInverse Si S) (hSSi : Function.RightInverse Si S)
    (hT : MeasurePreserving T μ μ) (hS : MeasurePreserving S μ μ)
    (hTS : Function.Commute T S) (f g : X → ℂ) (hf : MemLp f 2 μ) (hg : MemLp g 2 μ) :
    ∀ᵐ x ∂μ, ∃ L : ℂ,
      Tendsto (fun N ↦ doubleAverage T S f g N x) atTop (𝓝 L) ∧
      Tendsto (fun N : ℕ ↦ (N:ℂ)⁻¹ * ∑ n ∈ Finset.range N,
        f (T^[n+1] x) * g (S^[n+1] x)) atTop (𝓝 L) := by
  let Te : X ≃ᵐ X :=
    { toFun := T
      invFun := Ti
      left_inv := hTiT
      right_inv := hTTi
      measurable_toFun := hTm
      measurable_invFun := hTim }
  let Se : X ≃ᵐ X :=
    { toFun := S
      invFun := Si
      left_inv := hSiS
      right_inv := hSSi
      measurable_toFun := hSm
      measurable_invFun := hSim }
  filter_upwards [commuting_pointwise_l2 μ Te Se hT hS hTS f g hf hg,
    ae_l2_doubleAverage_shift_iff μ T S hT hS f g hf hg] with x hx hs
  obtain ⟨L,hL⟩ := hx
  exact ⟨L,hL,(hs L).mpr hL⟩

