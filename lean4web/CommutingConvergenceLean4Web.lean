-- Source: CommutingConvergence.MatrixGramSupport
section OriginalModule46
set_option autoImplicit false
/-! Kernel-based support statements for the finite complex matrices in input M1.
These lemmas allow rank-deficient Grams. No inverse or lower eigenvalue bound is used. -/

open Matrix
open scoped ComplexOrder

namespace CommutingConvergence

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m]

/-- An inserted matrix and its adjoint both annihilate the kernel of the base Gram. -/
def MatrixSupportedOn (P K : Matrix n n ℂ) : Prop :=
  ∀ x, P *ᵥ x = 0 → K *ᵥ x = 0 ∧ Kᴴ *ᵥ x = 0

omit [DecidableEq m] in
/-- For a Gram, support can be checked directly on the rectangular row matrix. -/
theorem matrixSupportedOn_gram_iff (R : Matrix m n ℂ) (K : Matrix n n ℂ) :
    MatrixSupportedOn (Rᴴ * R) K ↔
      ∀ x, R *ᵥ x = 0 → K *ᵥ x = 0 ∧ Kᴴ *ᵥ x = 0 := by
  simp only [MatrixSupportedOn, Matrix.conjTranspose_mul_self_mulVec_eq_zero]

omit [DecidableEq m] in
/-- All inserted Grams, even for non-Hermitian insertions, have the required two-sided support. -/
theorem inserted_gram_supported (R : Matrix m n ℂ) (D : Matrix m m ℂ) :
    MatrixSupportedOn (Rᴴ * R) (Rᴴ * D * R) := by
  rw [matrixSupportedOn_gram_iff]
  intro x hx
  constructor
  · simp [← Matrix.mulVec_mulVec, hx]
  · simp [Matrix.conjTranspose_mul, Matrix.mul_assoc, ← Matrix.mulVec_mulVec, hx]

/-- Nonzero diagonal row scaling preserves the kernel, with no bound on the diagonal entries. -/
theorem rowScale_mulVec_eq_zero_iff (R : Matrix m n ℂ) (d : m → ℂ)
    (hd : ∀ i, d i ≠ 0) (x : n → ℂ) :
    (Matrix.diagonal d * R) *ᵥ x = 0 ↔ R *ᵥ x = 0 := by
  rw [← Matrix.mulVec_mulVec]
  constructor
  · intro h
    funext i
    have hi := congrFun h i
    simpa only [Matrix.mulVec_diagonal, Pi.zero_apply, mul_eq_zero, hd i, false_or] using hi
  · intro h
    simp [h]

/-- The exact common-kernel property needed when a positive Gaussian row is narrowed or shifted. -/
theorem rowScale_gram_kernel (R : Matrix m n ℂ) (d : m → ℂ)
    (hd : ∀ i, d i ≠ 0) :
    LinearMap.ker (((Matrix.diagonal d * R)ᴴ * (Matrix.diagonal d * R)).mulVecLin) =
      LinearMap.ker R.mulVecLin := by
  rw [Matrix.ker_mulVecLin_conjTranspose_mul_self]
  ext x
  simp only [LinearMap.mem_ker, Matrix.mulVecLin_apply]
  exact rowScale_mulVec_eq_zero_iff R d hd x

/-- The family of Grams has one common kernel although its rank may be smaller than `n`. -/
theorem rowScale_grams_common_kernel {I : Type*} (R : Matrix m n ℂ)
    (d : I → m → ℂ) (hd : ∀ ω i, d ω i ≠ 0) (ω τ : I) :
    LinearMap.ker (((Matrix.diagonal (d ω) * R)ᴴ * (Matrix.diagonal (d ω) * R)).mulVecLin) =
      LinearMap.ker (((Matrix.diagonal (d τ) * R)ᴴ * (Matrix.diagonal (d τ) * R)).mulVecLin) := by
  rw [rowScale_gram_kernel R _ (hd ω), rowScale_gram_kernel R _ (hd τ)]

/-- A narrowed-row insertion is supported on the original Gram as well as its own Gram. -/
theorem rowScale_insertion_supported_on_original (R : Matrix m n ℂ) (d : m → ℂ)
    (D : Matrix m m ℂ) :
    MatrixSupportedOn (Rᴴ * R)
      ((Matrix.diagonal d * R)ᴴ * D * (Matrix.diagonal d * R)) := by
  rw [matrixSupportedOn_gram_iff]
  intro x hx
  have hscaled : (Matrix.diagonal d * R) *ᵥ x = 0 := by
    simp [← Matrix.mulVec_mulVec, hx]
  exact (matrixSupportedOn_gram_iff _ _).mp (inserted_gram_supported _ D) x hscaled

end CommutingConvergence
end OriginalModule46


-- Source: CommutingConvergence.DiagonalSylvester
section OriginalModule47
set_option autoImplicit false
/-! Explicit Sylvester inversion and the spectral quadratic cost for M1.
The weights `a i` represent square roots of eigenvalues, and may vanish.
Identifying this cost with the Hessian of `trace (P^(3/2))` is a later step. -/

open Matrix
open scoped BigOperators

namespace CommutingConvergence

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Matrix entries involving the zero-eigenvalue subspace vanish on both sides. -/
def DiagonalSupported (a : n → ℝ) (K : Matrix n n ℂ) : Prop :=
  ∀ i j, a i = 0 ∨ a j = 0 → K i j = 0

/-- The inverse of `X ↦ diag(a) X + X diag(a)` on supported directions. -/
noncomputable def diagonalSylvesterSolve (a : n → ℝ) (K : Matrix n n ℂ) : Matrix n n ℂ :=
  fun i j ↦ K i j / ((a i + a j : ℝ) : ℂ)

/-- The nonnegative quadratic form appearing in the supported Hessian. -/
noncomputable def diagonalHessianCost (a : n → ℝ) (K : Matrix n n ℂ) : ℝ :=
  (3 / 2 : ℝ) * ∑ i, ∑ j, ‖K i j‖ ^ 2 / (a i + a j)

omit [Fintype n] [DecidableEq n] in
theorem diagonalSylvesterSolve_supported (a : n → ℝ) (K : Matrix n n ℂ)
    (hK : DiagonalSupported a K) : DiagonalSupported a (diagonalSylvesterSolve a K) := by
  intro i j hij
  simp [diagonalSylvesterSolve, hK i j hij]

omit [Fintype n] [DecidableEq n] in
/-- The Sylvester inverse preserves the real space of Hermitian directions. -/
theorem diagonalSylvesterSolve_isHermitian (a : n → ℝ) (K : Matrix n n ℂ)
    (hK : K.IsHermitian) : (diagonalSylvesterSolve a K).IsHermitian := by
  apply Matrix.IsHermitian.ext
  intro i j
  change star (K j i / ((a j + a i : ℝ) : ℂ)) =
    K i j / ((a i + a j : ℝ) : ℂ)
  calc
    _ = star (K j i) / star ((a j + a i : ℝ) : ℂ) := star_div₀ _ _
    _ = K i j / ((a i + a j : ℝ) : ℂ) :=
      congrArg₂ (fun x y : ℂ ↦ x / y) (hK.apply i j) (by simp [add_comm])

/-- Singular entries cause no division error: the corresponding supported numerator is zero. -/
theorem diagonalSylvesterSolve_spec (a : n → ℝ) (ha : ∀ i, 0 ≤ a i)
    (K : Matrix n n ℂ) (hK : DiagonalSupported a K) :
    Matrix.diagonal (fun i ↦ (a i : ℂ)) * diagonalSylvesterSolve a K +
      diagonalSylvesterSolve a K * Matrix.diagonal (fun i ↦ (a i : ℂ)) = K := by
  ext i j
  simp only [Matrix.add_apply, Matrix.diagonal_mul, Matrix.mul_diagonal,
    diagonalSylvesterSolve]
  by_cases h : a i + a j = 0
  · have hi : a i = 0 := by have := ha i; have := ha j; linarith
    simp [hK i j (Or.inl hi)]
  · have hc : (a i : ℂ) + (a j : ℂ) ≠ 0 := by exact_mod_cast h
    push_cast
    field_simp [hc]

/-- The solution is unique on the fixed support, even when the full Sylvester map is singular. -/
theorem diagonalSylvesterSolve_unique (a : n → ℝ) (ha : ∀ i, 0 ≤ a i)
    (K X : Matrix n n ℂ) (hX : DiagonalSupported a X)
    (hsolve : Matrix.diagonal (fun i ↦ (a i : ℂ)) * X +
      X * Matrix.diagonal (fun i ↦ (a i : ℂ)) = K) :
    X = diagonalSylvesterSolve a K := by
  ext i j
  have he := congrFun (congrFun hsolve i) j
  simp only [Matrix.add_apply, Matrix.diagonal_mul, Matrix.mul_diagonal] at he
  change X i j = K i j / ((a i + a j : ℝ) : ℂ)
  by_cases h : a i + a j = 0
  · have hi : a i = 0 := by have := ha i; have := ha j; linarith
    simp [h, hX i j (Or.inl hi)]
  · apply (eq_div_iff (by exact_mod_cast h : ((a i + a j : ℝ) : ℂ) ≠ 0)).mpr
    push_cast
    linear_combination he

omit [DecidableEq n] in
theorem diagonalHessianCost_nonneg (a : n → ℝ) (ha : ∀ i, 0 ≤ a i)
    (K : Matrix n n ℂ) : 0 ≤ diagonalHessianCost a K := by
  unfold diagonalHessianCost
  apply mul_nonneg (by norm_num)
  exact Finset.sum_nonneg fun i _ ↦ Finset.sum_nonneg fun j _ ↦
    div_nonneg (sq_nonneg _) (add_nonneg (ha i) (ha j))

omit [DecidableEq n] in
theorem diagonalHessianCost_smul (a : n → ℝ) (K : Matrix n n ℂ) (c : ℝ) :
    diagonalHessianCost a (c • K) = c ^ 2 * diagonalHessianCost a K := by
  simp only [diagonalHessianCost, Matrix.smul_apply, norm_smul, Real.norm_eq_abs,
    mul_pow, sq_abs, mul_div_assoc]
  simp only [← Finset.mul_sum]
  ring

/-- The scalar estimate behind the dimension-free inserted-Gram bound, including zero weights. -/
theorem sylvester_scalar_weight_le (x y : ℝ) (hx : 0 ≤ x) (hy : 0 ≤ y) :
    x ^ 2 * y ^ 2 / (x + y) ≤ (x ^ 3 + y ^ 3) / 4 := by
  by_cases h : x + y = 0
  · have hx0 : x = 0 := by linarith
    have hy0 : y = 0 := by linarith
    simp [hx0, hy0]
  · have hpos : 0 < x + y := lt_of_le_of_ne (add_nonneg hx hy) (Ne.symm h)
    apply (div_le_iff₀ hpos).mpr
    have hprod := mul_nonneg (sq_nonneg (x - y))
      (show 0 ≤ x ^ 2 + 3 * x * y + y ^ 2 by positivity)
    nlinarith

end CommutingConvergence
end OriginalModule47


-- Source: CommutingConvergence.MatrixSupportTransport
section OriginalModule48
set_option autoImplicit false
/-! Two-sided support is unchanged by unitary coordinates.  This connects the explicit
zero-eigenvalue conditions of `DiagonalSylvester` to the intrinsic kernel condition. -/

open Matrix Unitary

namespace CommutingConvergence

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Conjugation as a bundled star algebra equivalence. -/
noncomputable abbrev unitaryConj (U : Matrix.unitaryGroup n ℂ) :=
  Unitary.conjStarAlgAut ℂ (Matrix n n ℂ) U

theorem unitary_mulVec_eq_zero_iff (U : Matrix.unitaryGroup n ℂ) (x : n → ℂ) :
    (U : Matrix n n ℂ) *ᵥ x = 0 ↔ x = 0 := by
  constructor
  · intro h
    have hh := congrArg (fun y ↦ (star U : Matrix n n ℂ) *ᵥ y) h
    simpa only [Matrix.mulVec_mulVec, Unitary.coe_star_mul_self,
      Matrix.one_mulVec, Matrix.mulVec_zero] using hh
  · rintro rfl
    exact Matrix.mulVec_zero _

theorem unitaryConj_mulVec_eq_zero_iff (U : Matrix.unitaryGroup n ℂ)
    (P : Matrix n n ℂ) (x : n → ℂ) :
    unitaryConj U P *ᵥ x = 0 ↔ P *ᵥ ((star U : Matrix n n ℂ) *ᵥ x) = 0 := by
  simp only [unitaryConj, Unitary.conjStarAlgAut_apply, ← Matrix.mulVec_mulVec,
    unitary_mulVec_eq_zero_iff]

theorem matrixSupportedOn_unitaryConj (U : Matrix.unitaryGroup n ℂ)
    (P K : Matrix n n ℂ) (hK : MatrixSupportedOn P K) :
    MatrixSupportedOn (unitaryConj U P) (unitaryConj U K) := by
  intro x hx
  rw [unitaryConj_mulVec_eq_zero_iff] at hx
  obtain ⟨h1, h2⟩ := hK _ hx
  constructor
  · exact (unitaryConj_mulVec_eq_zero_iff U K x).mpr h1
  · change star (unitaryConj U K) *ᵥ x = 0
    rw [← map_star]
    exact (unitaryConj_mulVec_eq_zero_iff U Kᴴ x).mpr h2

theorem matrixSupportedOn_unitaryConj_iff (U : Matrix.unitaryGroup n ℂ)
    (P K : Matrix n n ℂ) :
    MatrixSupportedOn (unitaryConj U P) (unitaryConj U K) ↔ MatrixSupportedOn P K := by
  constructor
  · intro h
    have hh := matrixSupportedOn_unitaryConj (star U) _ _ h
    simpa only [unitaryConj, ← Unitary.conjStarAlgAut_mul_apply,
      star_mul_self, map_one, StarAlgEquiv.one_apply] using hh
  · exact matrixSupportedOn_unitaryConj U P K

/-- The coordinate support condition is exactly the intrinsic two-sided kernel condition. -/
theorem matrixSupportedOn_diagonal_iff (a : n → ℝ) (K : Matrix n n ℂ) :
    MatrixSupportedOn (Matrix.diagonal (fun i ↦ (a i : ℂ))) K ↔ DiagonalSupported a K := by
  constructor
  · intro h i j hij
    rcases hij with hi | hj
    · have hz : Matrix.diagonal (fun i ↦ (a i : ℂ)) *ᵥ Pi.single i 1 = 0 := by
        simp [hi]
      have he := congrFun (h _ hz).2 j
      simpa using he
    · have hz : Matrix.diagonal (fun i ↦ (a i : ℂ)) *ᵥ Pi.single j 1 = 0 := by
        simp [hj]
      have he := congrFun (h _ hz).1 i
      simpa using he
  · intro h x hx
    have hxi (i : n) : (a i : ℂ) * x i = 0 := by
      simpa only [Matrix.mulVec_diagonal, Pi.zero_apply] using congrFun hx i
    constructor
    · ext i
      apply Finset.sum_eq_zero
      intro j _
      by_cases hj : a j = 0
      · simp [h i j (Or.inr hj)]
      · have hjc : (a j : ℂ) ≠ 0 := by exact_mod_cast hj
        simp [(mul_eq_zero.mp (hxi j)).resolve_left hjc]
    · ext i
      apply Finset.sum_eq_zero
      intro j _
      by_cases hj : a j = 0
      · simp [Matrix.conjTranspose_apply, h j i (Or.inl hj)]
      · have hjc : (a j : ℂ) ≠ 0 := by exact_mod_cast hj
        simp [(mul_eq_zero.mp (hxi j)).resolve_left hjc]

/-- Diagonalizing the base matrix also diagonalizes its support test. -/
theorem matrixSupportedOn_eigenbasis_iff (P K : Matrix n n ℂ) (hP : P.IsHermitian) :
    MatrixSupportedOn P K ↔
      DiagonalSupported hP.eigenvalues (unitaryConj (star hP.eigenvectorUnitary) K) := by
  rw [← matrixSupportedOn_unitaryConj_iff (star hP.eigenvectorUnitary) P K]
  have hdiag := hP.conjStarAlgAut_star_eigenvectorUnitary
  change unitaryConj (star hP.eigenvectorUnitary) P =
    Matrix.diagonal (fun i ↦ (hP.eigenvalues i : ℂ)) at hdiag
  rw [hdiag, matrixSupportedOn_diagonal_iff]

/-- Cyclicity removes the coordinate change from the trace. -/
theorem trace_unitaryConj (U : Matrix.unitaryGroup n ℂ) (K : Matrix n n ℂ) :
    Matrix.trace (unitaryConj U K) = Matrix.trace K := by
  rw [unitaryConj, Unitary.conjStarAlgAut_apply, Matrix.trace_mul_cycle,
    Unitary.coe_star_mul_self, Matrix.one_mul]

end CommutingConvergence
end OriginalModule48


-- Source: CommutingConvergence.SpectralSylvester
section OriginalModule49
set_option autoImplicit false
/-! Sylvester inversion for arbitrary positive semidefinite matrices, including singular ones.
Only supported directions are inverted. No lower spectral bound is imposed. -/

open Matrix Unitary
open scoped ComplexOrder

namespace CommutingConvergence

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Explicit spectral inverse, transported back to the original coordinates. -/
noncomputable def spectralSylvesterSolve (A : Matrix n n ℂ) (hA : A.IsHermitian)
    (K : Matrix n n ℂ) : Matrix n n ℂ :=
  unitaryConj hA.eigenvectorUnitary
    (diagonalSylvesterSolve hA.eigenvalues (unitaryConj (star hA.eigenvectorUnitary) K))

theorem spectralSylvesterSolve_coordinates (A : Matrix n n ℂ) (hA : A.IsHermitian)
