-- Source: CommutingConvergence.JumpBudget
section OriginalModule260
set_option autoImplicit false
/-!
A qualitative shortcut: sublinear maximal increment budgets imply convergence.
We do not need a full r-variation inequality, or a quantitative r -> 2 estimate.

The non-Cauchy sequence construction is the standard one also used in
roos-j/lean-nct, LeanNct/Auto/Tao.lean (Apache-2.0, commit 412a206c).
The budget and convergence-in-measure argument below are separate from its norm-variation theorem.
-/
open MeasureTheory Filter
open scoped BigOperators Topology ENNReal

namespace CommutingConvergence

variable {E : Type*} [PseudoMetricSpace E]

/-- Every increasing positive chain of `m` increments is dominated by `B m`.
The disjoint-interval maximal function `J_m` from the report would supply such a budget. -/
def ControlsChainSums (a : ℕ → E) (B : ℕ → ℝ) : Prop :=
  ∀ m (t : Fin (m + 1) → ℕ), StrictMono t → (∀ j, 0 < t j) →
    ∑ j : Fin m, dist (a (t j.succ)) (a (t j.castSucc)) ≤ B m

/-- It suffices that a normalized budget tends to zero along one subsequence. -/
theorem cauchySeq_of_sublinear_budget (a : ℕ → E) (B : ℕ → ℝ)
    (hcontrol : ControlsChainSums a B)
    (φ : ℕ → ℕ) (hφ : StrictMono φ)
    (hzero : Tendsto (fun k ↦ B (φ k) / (φ k : ℝ)) atTop (𝓝 0)) :
    CauchySeq a := by
  rw [Metric.cauchySeq_iff']
  intro ε hε
  by_contra htail
  push Not at htail
  have hstep (N : ℕ) : ∃ m, N < m ∧ ε ≤ dist (a m) (a N) := by
    obtain ⟨m, hm, hd⟩ := htail N
    refine ⟨m, ?_, hd⟩
    have hne : N ≠ m := by
      intro heq
      subst m
      simp only [dist_self] at hd
      exact (not_le_of_gt hε) hd
    exact lt_of_le_of_ne hm hne
  choose next hnext using hstep
  let k : ℕ → ℕ := fun i ↦ next^[i] 1
  have hksucc (i : ℕ) : k i < k (i + 1) := by
    change next^[i] 1 < next^[i.succ] 1
    rw [Function.iterate_succ_apply']
    exact (hnext _).1
  have hk : StrictMono k := strictMono_nat_of_lt_succ hksucc
  have hkpos (i : ℕ) : 0 < k i := by
    have hstart : k 0 = 1 := by simp [k]
    exact lt_of_lt_of_le (by simp [hstart]) (hk.monotone (Nat.zero_le i))
  have hkjump (i : ℕ) : ε ≤ dist (a (k (i + 1))) (a (k i)) := by
    change ε ≤ dist (a (next^[i.succ] 1)) (a (next^[i] 1))
    rw [Function.iterate_succ_apply']
    exact (hnext _).2
  have hlinear (m : ℕ) : (m : ℝ) * ε ≤ B m := by
    let t : Fin (m + 1) → ℕ := fun j ↦ k j
    have ht : StrictMono t := fun i j hij ↦ hk hij
    have hlower : (m : ℝ) * ε ≤
        ∑ j : Fin m, dist (a (t j.succ)) (a (t j.castSucc)) := by
      calc
        (m : ℝ) * ε = ∑ _j : Fin m, ε := by simp
        _ ≤ _ := Finset.sum_le_sum fun j _ ↦ hkjump j
    exact hlower.trans (hcontrol m t ht (fun j ↦ hkpos j))
  have hevent : ∀ᶠ j in atTop, 0 < φ j := hφ.tendsto_atTop.eventually (eventually_gt_atTop 0)
  obtain ⟨j, hjpos, hjlt⟩ := (hevent.and (hzero.eventually_lt_const hε)).exists
  have hjpos' : (0 : ℝ) < φ j := by exact_mod_cast hjpos
  have hge : ε ≤ B (φ j) / (φ j : ℝ) := by
    apply (le_div_iff₀ hjpos').2
    simpa [mul_comm] using hlinear (φ j)
  exact (not_lt_of_ge hge) hjlt

/-- A normalized budget converging in measure implies a.e. convergence of the original sequence.
All estimates for the actual averages still have to be supplied in `hcontrol` and `hzero`. -/
theorem ae_tendsto_of_budget_inMeasure
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [CompleteSpace E]
    (a : ℕ → X → E) (B : ℕ → X → ℝ)
    (hcontrol : ∀ᵐ x ∂μ, ControlsChainSums (fun n ↦ a n x) (fun m ↦ B m x))
    (hzero : TendstoInMeasure μ (fun m x ↦ B m x / (m : ℝ)) atTop 0) :
    ∀ᵐ x ∂μ, ∃ L : E, Tendsto (fun n ↦ a n x) atTop (𝓝 L) := by
  obtain ⟨φ, hφ, hφzero⟩ := hzero.exists_seq_tendsto_ae
  filter_upwards [hcontrol, hφzero] with x hx hxzero
  exact cauchySeq_tendsto_of_complete
    (cauchySeq_of_sublinear_budget _ _ hx φ hφ hxzero)

/-- In particular, any positive `Lp` exponent suffices for normalized-budget decay. -/
theorem ae_tendsto_of_budget_eLpNorm
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [CompleteSpace E]
    (a : ℕ → X → E) (B : ℕ → X → ℝ) {p : ℝ≥0∞} (hp : p ≠ 0)
    (hcontrol : ∀ᵐ x ∂μ, ControlsChainSums (fun n ↦ a n x) (fun m ↦ B m x))
    (hB : ∀ m, AEStronglyMeasurable (fun x ↦ B m x / (m : ℝ)) μ)
    (hzero : Tendsto (fun m ↦ eLpNorm (fun x ↦ B m x / (m : ℝ)) p μ)
      atTop (𝓝 0)) :
    ∀ᵐ x ∂μ, ∃ L : E, Tendsto (fun n ↦ a n x) atTop (𝓝 L) := by
  apply ae_tendsto_of_budget_inMeasure μ a B hcontrol
  apply tendstoInMeasure_of_tendsto_eLpNorm hp
  simpa only [sub_zero] using hzero

end CommutingConvergence
end OriginalModule260


-- Source: CommutingConvergence.FiniteMaximal
section OriginalModule261
set_option autoImplicit false
open MeasureTheory Set
open scoped ENNReal

namespace CommutingConvergence

variable {X I : Type*}

/-- The maximum is inside the integral: candidates may be chosen depending on the point. -/
noncomputable def finiteMaximal (F : I → X → ℝ≥0∞) (s : Finset I) (x : X) : ℝ≥0∞ :=
  ⨆ i ∈ s, F i x

theorem finiteMaximal_mono (F : I → X → ℝ≥0∞) {s t : Finset I} (h : s ⊆ t) :
    finiteMaximal F s ≤ finiteMaximal F t := by
  intro x
  exact iSup_le fun i ↦ iSup_le fun hi ↦ le_iSup_of_le i (le_iSup_of_le (h hi) le_rfl)

theorem finiteMaximal_directed (F : I → X → ℝ≥0∞) :
    Directed (· ≤ ·) (finiteMaximal F) := by
  classical
  intro s t
  exact ⟨s ∪ t, finiteMaximal_mono F Finset.subset_union_left,
    finiteMaximal_mono F Finset.subset_union_right⟩

theorem iSup_finiteMaximal (F : I → X → ℝ≥0∞) (x : X) :
    (⨆ s : Finset I, finiteMaximal F s x) = ⨆ i, F i x :=
  (iSup_eq_iSup_finset (fun i ↦ F i x)).symm

variable [MeasurableSpace X]

theorem aemeasurable_finiteMaximal [Countable I] (μ : Measure X)
    (F : I → X → ℝ≥0∞) (hF : ∀ i, AEMeasurable (F i) μ) (s : Finset I) :
    AEMeasurable (finiteMaximal F s) μ :=
  .iSup fun i ↦ .iSup fun _ ↦ hF i

/-- Uniform integral bounds for every finite maximum control the whole countable supremum.
Bounds for each individual candidate alone would not suffice. -/
theorem lintegral_iSup_le_of_finiteMaximal [Countable I] (μ : Measure X)
    (F : I → X → ℝ≥0∞) (hF : ∀ i, AEMeasurable (F i) μ) (C : ℝ≥0∞)
    (h : ∀ s : Finset I, ∫⁻ x, finiteMaximal F s x ∂μ ≤ C) :
    ∫⁻ x, ⨆ i, F i x ∂μ ≤ C := by
  simp_rw [← iSup_finiteMaximal F]
  rw [lintegral_iSup_directed (aemeasurable_finiteMaximal μ F hF) (finiteMaximal_directed F)]
  exact iSup_le h

end CommutingConvergence
end OriginalModule261


-- Source: CommutingConvergence.JumpEnvelope
section OriginalModule262
set_option autoImplicit false
open MeasureTheory Filter
open scoped BigOperators ENNReal Topology

namespace CommutingConvergence

abbrev PositiveChain (m : ℕ) :=
  {t : Fin (m+1) → ℕ // StrictMono t ∧ ∀ j, 0 < t j}

noncomputable def chainIncrementSum (a : ℕ → ℂ) {m : ℕ} (t : PositiveChain m) : ℝ :=
  ∑ j : Fin m, dist (a (t.1 j.succ)) (a (t.1 j.castSucc))

noncomputable def jumpEnvelope (a : ℕ → ℂ) (m : ℕ) : ℝ≥0∞ :=
  ⨆ t : PositiveChain m, ENNReal.ofReal (chainIncrementSum a t)

theorem chainIncrementSum_nonneg (a : ℕ → ℂ) {m : ℕ} (t : PositiveChain m) :
    0 ≤ chainIncrementSum a t := Finset.sum_nonneg fun _ _ ↦ dist_nonneg

theorem chainIncrementSum_le_envelope (a : ℕ → ℂ) {m : ℕ} (t : PositiveChain m) :
