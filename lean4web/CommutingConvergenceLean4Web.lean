variable {n Ω : Type*} [Fintype n] [DecidableEq n] [MeasurableSpace Ω]

/-- Evaluation of a real scalar quadratic form is a continuous real linear map. -/
noncomputable def matrixVectorQuadraticCLM (x : n → ℂ) : Matrix n n ℂ →L[ℝ] ℝ :=
  (show Matrix n n ℂ →ₗ[ℝ] ℝ from
    { toFun := fun P ↦ (star x ⬝ᵥ P *ᵥ x).re
      map_add' := by intros; simp [Matrix.add_mulVec, dotProduct_add]
      map_smul' := by intros; simp [Matrix.smul_mulVec, dotProduct_smul] }).toContinuousLinearMap

omit [DecidableEq n] in
theorem matrixVectorQuadratic_nonneg (P : Matrix n n ℂ) (hP : P.PosSemidef)
    (x : n → ℂ) : 0 ≤ matrixVectorQuadraticCLM x P :=
  (RCLike.nonneg_iff.mp (hP.dotProduct_mulVec_nonneg x)).1

omit [DecidableEq n] in
theorem matrixVectorQuadratic_eq_zero_iff (P : Matrix n n ℂ) (hP : P.PosSemidef)
    (x : n → ℂ) : matrixVectorQuadraticCLM x P = 0 ↔ P *ᵥ x = 0 := by
  change (star x ⬝ᵥ P *ᵥ x).re = 0 ↔ P *ᵥ x = 0
  rw [← hP.dotProduct_mulVec_zero_iff (x := x)]
  constructor
  · intro h
    exact Complex.ext h (RCLike.nonneg_iff.mp (hP.dotProduct_mulVec_nonneg x)).2
  · intro h
    rw [h]
    rfl

