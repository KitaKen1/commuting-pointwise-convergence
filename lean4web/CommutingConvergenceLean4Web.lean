  intro l _
  exact continuous_const.mul ((Complex.continuous_ofReal.comp
    (normalizedDilation_continuous (b l) _ (standardEulerKernel_continuous k hk))).sub
      (Complex.continuous_ofReal.comp
        (normalizedDilation_continuous (a l) _ (standardEulerKernel_continuous k hk))))

theorem gaussianEulerIntervalMenuKernel_bounded {ι : Type*} (k : ℕ) (hk : k < 2)
    (menu : Finset ι) (a b : ι → ℝ) (β : ι → ℂ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x, ‖gaussianEulerIntervalMenuKernel k menu a b β x‖ ≤ C := by
  obtain ⟨C, hC, hK⟩ := standardEulerKernel_bounded k hk
  refine ⟨∑ l ∈ menu, ‖β l‖ * (|(b l)⁻¹| + |(a l)⁻¹|) * C, ?_, fun x ↦ ?_⟩
  · exact Finset.sum_nonneg fun l _ ↦ by positivity
  · unfold gaussianEulerIntervalMenuKernel
    apply (norm_sum_le _ _).trans
    apply Finset.sum_le_sum
    intro l _
    rw [norm_mul]
    have hb : ‖(normalizedDilation (b l) (standardEulerKernel k) x : ℂ)‖ ≤ |(b l)⁻¹| * C := by
      simpa only [Complex.norm_real] using normalizedDilation_norm_le (b l) _ C hK x
    have ha : ‖(normalizedDilation (a l) (standardEulerKernel k) x : ℂ)‖ ≤ |(a l)⁻¹| * C := by
      simpa only [Complex.norm_real] using normalizedDilation_norm_le (a l) _ C hK x
    exact (mul_le_mul_of_nonneg_left ((norm_sub_le _ _).trans (add_le_add hb ha))
