    ← Real.rpow_mul hG, ← Real.rpow_mul hK] at he''
  norm_num only at he''
  unfold finiteCubicRootSum
  simpa only [mul_assoc] using he.trans
    (mul_le_mul_of_nonneg_left he'' (Real.rpow_nonneg
      (Finset.sum_nonneg fun i hi ↦ pow_nonneg (hf i hi) 3) _))

theorem finite_mesh_three_factor_cubic_holder (s : Finset ι) (h : ℝ) (f g k : ι → ℝ)
    (hf : ∀ i ∈ s, 0 ≤ f i) (hg : ∀ i ∈ s, 0 ≤ g i) (hk : ∀ i ∈ s, 0 ≤ k i) :
    h^2*(∑ i ∈ s, f i*g i*k i) ≤
      finiteMeshCubicRootSum s h f*finiteMeshCubicRootSum s h g*finiteMeshCubicRootSum s h k := by
  rw [finiteMeshCubicRootSum_eq s h f hf, finiteMeshCubicRootSum_eq s h g hg,
    finiteMeshCubicRootSum_eq s h k hk]
