          · exact le_rfl
          · exact (hb j hj).trans hx
        · simp only [select, ite_eq_right hx]
          refine ⟨Finset.mem_insert_of_mem hm, ?_⟩
          intro j hj
          rcases Finset.mem_insert.mp hj with rfl | hj
          · exact le_of_not_ge hx
          · exact hb j hj
