      _ ≤ |x| * |(gaussianScorePolynomial v (n + 1)).eval x| +
          (|v| * (n + 1 : ℕ)) * |(gaussianScorePolynomial v n).eval x| := by
        simpa only [abs_mul, abs_of_nonneg (Nat.cast_nonneg (n + 1) :
          (0 : ℝ) ≤ (n + 1 : ℕ))] using
