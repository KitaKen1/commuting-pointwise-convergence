    (hP : P.PosSemidef) (hE : E.PosSemidef) (hEE : E * E = E) (hPE : P * E = 0)
    (hKP : MatrixSupportedOn P K) :
    spectralSylvesterCLM (CFC.sqrt (P + E)) (CFC.sqrt_nonneg (P + E)).posSemidef.isHermitian K =
