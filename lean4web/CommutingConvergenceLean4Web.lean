    (hexp : ∃ a : ℝ, 0 < a ∧ Integrable (fun x : ℝ ↦ Real.exp (a * |x|)) μ)
    (F : ℝ → ℝ) (hF : MemLp F 2 μ) (ε : ℝ) (hε : 0 < ε) :
    ∃ P : Polynomial ℝ, lpNorm (fun x ↦ F x - P.eval x) 2 μ < ε := by
  obtain ⟨P, hP⟩ := (polynomialEvalLp_denseRange hexp).exists_dist_lt (hF.toLp F) hε
