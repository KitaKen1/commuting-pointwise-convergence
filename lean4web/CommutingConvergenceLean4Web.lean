  rw [Submodule.dense_iff_topologicalClosure_eq_top, Submodule.topologicalClosure_eq_top_iff,
    Submodule.eq_bot_iff]
  intro G hG
  apply (Lp.eq_zero_iff_ae_eq_zero).mpr
  apply TauCeti.ae_eq_zero_of_forall_moment_eq_zero_of_exists_integrable_exp hexp (Lp.memLp G)
  intro n
  have h0 := (Submodule.mem_orthogonal _ _).mp hG (E (X ^ n)) ⟨X ^ n, rfl⟩
  rw [L2.inner_def] at h0
  rw [← h0]
  apply integral_congr_ae
  filter_upwards [TauCeti.coeFn_polynomialEvalLp ℝ hmom (X ^ n)] with x hx
  change E (X ^ n) x = _ at hx
  rw [hx]
  simp [RCLike.inner_apply, mul_comm]

