    (C : ℝ) (hF : Continuous F) (hC : 0 ≤ C) (hbound : ∀ x, ‖F x‖ ≤ C)
    (hsupp : ∀ x ∉ latticeTripleSupportBox R, F x = 0) :
    Tendsto (fun n ↦ ∫ x, latticeTripleBoxSample R n F x) atTop (𝓝 (∫ x, F x)) := by
  apply tendsto_integral_of_dominated_convergence
    ((latticeTripleSupportBox R).indicator (fun _ ↦ C))
    (fun n ↦ (latticeTripleBoxSample_measurable R n F).aestronglyMeasurable)
    (latticeTripleSupportBox_indicator_const_integrable R C)
    (fun n ↦ Eventually.of_forall (latticeTripleBoxSample_norm_bound R n F C hC hbound))
  exact Eventually.of_forall (latticeTripleBoxSample_tendsto R F hF hsupp)

theorem latticeTripleBoxSample_riemann_tendsto (R : ℤ) (F : ℝ × (ℝ × ℝ) → ℂ)
    (C : ℝ) (hF : Continuous F) (hC : 0 ≤ C) (hbound : ∀ x, ‖F x‖ ≤ C)
    (hsupp : ∀ x ∉ latticeTripleSupportBox R, F x = 0) :
    Tendsto (fun n ↦ (reciprocalLatticeMesh n)^3 •
      ∑ q ∈ latticeBoxIndices R n ×ˢ (latticeBoxIndices R n ×ˢ latticeBoxIndices R n),
        F (reciprocalLatticeMesh n*(q.1:ℝ),
          (reciprocalLatticeMesh n*(q.2.1:ℝ), reciprocalLatticeMesh n*(q.2.2:ℝ))))
      atTop (𝓝 (∫ x, F x)) := by
  have ht := latticeTripleBoxSample_integral_tendsto R F C hF hC hbound hsupp
  simpa only [latticeTripleBoxSample,
    latticeTripleExtension_integral _ _ _ _ _ (reciprocalLatticeMesh_pos _)] using ht

theorem triple_integral_eq_iterated (F : ℝ × (ℝ × ℝ) → ℂ)
    (hF : Integrable F volume) :
    (∫ x, F x) = ∫ a, ∫ b, ∫ c, F (a,(b,c)) := by
  have hp : Integrable F (volume.prod volume) := by
    simpa only [Measure.volume_eq_prod] using hF
  calc
    (∫ x, F x) = ∫ a, ∫ bc, F (a,bc) := by
      rw [Measure.volume_eq_prod]
      exact integral_prod F hp
    _ = ∫ a, ∫ b, ∫ c, F (a,(b,c)) := by
      apply integral_congr_ae
      filter_upwards [hp.prod_right_ae] with a ha
      rw [Measure.volume_eq_prod] at ha ⊢
      exact integral_prod (fun bc ↦ F (a,bc)) ha

end
end CommutingConvergence
