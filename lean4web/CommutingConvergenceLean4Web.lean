theorem ae_matrix_mulVec_eq_zero_of_integral (μ : Measure Ω) (P : Ω → Matrix n n ℂ)
    (hP : ∀ᵐ ω ∂μ, (P ω).PosSemidef) (hPi : Integrable P μ)
