    rw [hc0] at h ⊢
    have hab := mul_nonneg ha (sq_nonneg b)
    nlinarith [sq_nonneg b]
  · have hcp : 0 < c := lt_of_le_of_ne hc (Ne.symm hc0)
    have h := hq c (-b)
    have hp : 0 ≤ c * (a * c - b ^ 2) := by nlinarith only [h]
    have hd := (mul_nonneg_iff_of_pos_left hcp).mp hp
