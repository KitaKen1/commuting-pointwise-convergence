    (Metric.ball_mem_nhds b (by norm_num : (0 : ℝ) < 1))
    (Eventually.of_forall (fun y ↦ hmeas n y))
    (gaussianHeatDensity_iteratedDeriv_product_integrable m n σ τ a b hσ hτ)
    (hmeas (n + 1) b) (Eventually.of_forall hb)
    (integrable_polynomial_abs_mul_gaussianHigherDerivativeEnvelope
