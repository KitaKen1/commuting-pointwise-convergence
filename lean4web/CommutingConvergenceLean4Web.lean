  simpa only [hM.eq] using three_partitioned_row_cost_common_metric label M D hD

theorem hermitian_projected_cost_common_metric (label : n → Fin 3)
    (M D : Matrix n n ℂ) (hM : M.IsHermitian) (hD : PreservesRowPartition label D) :
    (1/3:ℝ) * gramSylvesterCost (M*M) (M*D*M) ≤
