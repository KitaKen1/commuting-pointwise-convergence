theorem rectangular_incident_stars_jump_abs_le (A₀ A₁ A : Matrix m n ℂ)
    (B : Matrix n p ℂ) (C : Matrix p m ℂ)
    (h₀ : ∀ i j, ‖A₀ i j‖ ≤ ‖A i j‖) (h₁ : ∀ i j, ‖A₁ i j‖ ≤ ‖A i j‖) :
    |rectangularCubicEnergy (Matrix.fromCols A₁ Cᴴ) - rectangularCubicEnergy (Matrix.fromCols A₀ Cᴴ)| +
      |rectangularCubicEnergy (Matrix.fromCols B A₁ᴴ) - rectangularCubicEnergy (Matrix.fromCols B A₀ᴴ)| ≤
      3 * ∑ i, ∑ j, ‖(A₁-A₀) i j‖ *
        (2 * matrixRowL2 A i * matrixColL2 A j + matrixColL2 C i * matrixColL2 A j +
