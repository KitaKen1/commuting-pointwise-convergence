    (u : m → ℝ) (v : n → ℝ) (w : p → ℝ) (x y z : ℝ)
    (A : Matrix m n ℂ) (B : Matrix n p ℂ) (C : Matrix p m ℂ)
    (hh : 0 ≤ h) (hL : 0 < L) :
    gaussianInsertedCyclicTrace a b c h L u v w x y z A B C =
      (h : ℂ) ^ 3 * ∑ i, ∑ j, ∑ k,
        ((gaussianDerivativeWindow a L (u i - x) *
          gaussianDerivativeWindow b L (v j - y) *
