-- Source: CommutingConvergence.LatticeCellNorm
section OriginalModule21
set_option autoImplicit false
/-! The actual plane step extension of finite complex arrays has precisely
the discrete mesh cubic norm. There is no cardinality factor. -/
open MeasureTheory Set Filter
open scoped ENNReal
namespace CommutingConvergence
noncomputable section

def latticeCellExtension (s t : Finset ℤ) (h : ℝ) (A : ℤ → ℤ → ℂ) (x : ℝ × ℝ) : ℂ :=
  if ⌊x.1/h⌋ ∈ s ∧ ⌊x.2/h⌋ ∈ t then A ⌊x.1/h⌋ ⌊x.2/h⌋ else 0

theorem latticeCellExtension_measurable (s t : Finset ℤ) (h : ℝ) (A : ℤ → ℤ → ℂ) :
    Measurable (latticeCellExtension s t h A) := by
  have hm : Measurable (fun x : ℝ × ℝ ↦ (⌊x.1/h⌋, ⌊x.2/h⌋)) := by fun_prop
  exact (measurable_of_countable (fun q : ℤ × ℤ ↦
    if q.1 ∈ s ∧ q.2 ∈ t then A q.1 q.2 else 0)).comp hm

theorem latticeCellExtension_on_cell (s t : Finset ℤ) (h : ℝ) (A : ℤ → ℤ → ℂ)
    (hh : 0 < h) (q : ℤ × ℤ) {x : ℝ × ℝ} (hx : x ∈ latticePlaneCell h q) :
    latticeCellExtension s t h A x = if q ∈ s ×ˢ t then A q.1 q.2 else 0 := by
  have he := (latticePlaneCell_mem_iff_floor h hh q x).mp hx
  have h₁ := congrArg Prod.fst he
  have h₂ := congrArg Prod.snd he
  change ⌊x.1/h⌋ = q.1 at h₁
  change ⌊x.2/h⌋ = q.2 at h₂
  simp only [latticeCellExtension, h₁, h₂, Finset.mem_product]

theorem latticeCellExtension_cube_eq_sum (s t : Finset ℤ) (h : ℝ) (A : ℤ → ℤ → ℂ)
    (hh : 0 < h) (x : ℝ × ℝ) :
    ENNReal.ofReal (‖latticeCellExtension s t h A x‖^3) =
      ∑ q ∈ s ×ˢ t, (latticePlaneCell h q).indicator
        (fun _ ↦ ENNReal.ofReal (‖A q.1 q.2‖^3)) x := by
  classical
  let j : ℤ × ℤ := (⌊x.1/h⌋, ⌊x.2/h⌋)
  have hxj : x ∈ latticePlaneCell h j := (latticePlaneCell_mem_iff_floor h hh j x).mpr rfl
  rw [latticeCellExtension_on_cell s t h A hh j hxj]
  by_cases hj : j ∈ s ×ˢ t
  · rw [ite_eq_left hj, Finset.sum_eq_single j]
    · simp only [indicator_of_mem hxj]
    · intro q hq hqj
      have hxq : x ∉ latticePlaneCell h q := by
        intro hxq
        exact hqj ((latticePlaneCell_mem_iff_floor h hh q x).mp hxq).symm
      exact indicator_of_notMem hxq _
    · exact fun hnot ↦ (hnot hj).elim
  · rw [ite_eq_right hj]
    simp only [norm_zero, zero_pow (by decide : (3:ℕ) ≠ 0), ENNReal.ofReal_zero]
    symm
    apply Finset.sum_eq_zero
    intro q hq
    apply indicator_of_notMem
    intro hxq
    have he := (latticePlaneCell_mem_iff_floor h hh q x).mp hxq
    change j = q at he
    rw [← he] at hq
    exact hj hq

theorem latticeCellExtension_lintegral_cube (s t : Finset ℤ) (h : ℝ) (A : ℤ → ℤ → ℂ)
    (hh : 0 < h) :
    (∫⁻ x, ENNReal.ofReal (‖latticeCellExtension s t h A x‖^3)) =
      ENNReal.ofReal (h^2*∑ q ∈ s ×ˢ t, ‖A q.1 q.2‖^3) := by
  simp_rw [latticeCellExtension_cube_eq_sum s t h A hh]
  rw [lintegral_finsetSum _ (fun q _ ↦ measurable_const.indicator (latticePlaneCell_measurable h q))]
  simp_rw [lintegral_indicator (latticePlaneCell_measurable h _), lintegral_const,
    Measure.restrict_apply_univ, latticePlaneCell_volume h hh.le]
  rw [Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg
    (fun q _ ↦ mul_nonneg (sq_nonneg h) (pow_nonneg (norm_nonneg _) 3))]
  apply Finset.sum_congr rfl
  intro q _
  rw [ENNReal.ofReal_mul (sq_nonneg h), mul_comm]

theorem latticeCellExtension_eLpNorm_three (s t : Finset ℤ) (h : ℝ) (A : ℤ → ℤ → ℂ)
    (hh : 0 < h) :
    eLpNorm (latticeCellExtension s t h A) 3 volume = ENNReal.ofReal (latticeMatrixCubicSize s t h A) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num : (3:ℝ≥0∞) ≠ 0)
    (by norm_num : (3:ℝ≥0∞) ≠ ∞)
    (latticeCellExtension_measurable s t h A).aestronglyMeasurable]
  norm_num only [ENNReal.toReal_ofNat, ENNReal.rpow_ofNat]
  have he (x : ℝ × ℝ) : ‖latticeCellExtension s t h A x‖ₑ^3 =
      ENNReal.ofReal (‖latticeCellExtension s t h A x‖^3) := by
    rw [← ofReal_norm, ENNReal.ofReal_pow (norm_nonneg _) 3]
  simp_rw [he]
  rw [latticeCellExtension_lintegral_cube s t h A hh]
  unfold latticeMatrixCubicSize finiteMeshCubicRootSum
  exact (ENNReal.ofReal_rpow_of_nonneg
    (mul_nonneg (sq_nonneg h) (Finset.sum_nonneg (s := s ×ˢ t)
      fun q _ ↦ pow_nonneg (norm_nonneg (A q.1 q.2)) 3))
    (by norm_num : (0:ℝ) ≤ 1/3))

theorem latticeCellExtension_memLp_three (s t : Finset ℤ) (h : ℝ) (A : ℤ → ℤ → ℂ)
    (hh : 0 < h) : MemLp (latticeCellExtension s t h A) 3 volume := by
  rw [memLp_iff]
  rw [latticeCellExtension_eLpNorm_three s t h A hh]
  exact ENNReal.ofReal_lt_top

theorem latticeCellExtension_integral_cube (s t : Finset ℤ) (h : ℝ) (A : ℤ → ℤ → ℂ)
    (hh : 0 < h) :
    (∫ x, ‖latticeCellExtension s t h A x‖^3) = h^2*∑ q ∈ s ×ˢ t, ‖A q.1 q.2‖^3 := by
  have hm : Measurable (fun x ↦ ‖latticeCellExtension s t h A x‖^3) :=
    (latticeCellExtension_measurable s t h A).norm.pow_const 3
  rw [integral_eq_lintegral_of_nonneg_ae
    (Eventually.of_forall fun x ↦ pow_nonneg (norm_nonneg _) 3) hm.aestronglyMeasurable,
    latticeCellExtension_lintegral_cube s t h A hh, ENNReal.toReal_ofReal]
  exact mul_nonneg (sq_nonneg h) (Finset.sum_nonneg fun q _ ↦ pow_nonneg (norm_nonneg _) 3)

end
end CommutingConvergence
end OriginalModule21


-- Source: CommutingConvergence.LatticeSampling
section OriginalModule22
set_option autoImplicit false
/-! Actual floor sampling: one-cell geometric error and convergence of
continuous plane inputs for any positive mesh sequence tending to zero. -/
open MeasureTheory Set Filter
open scoped Topology
namespace CommutingConvergence
noncomputable section

def floorLatticePoint (h : ℝ) (x : ℝ × ℝ) : ℝ × ℝ :=
  (h*(⌊x.1/h⌋:ℝ), h*(⌊x.2/h⌋:ℝ))

def floorLatticeSample (h : ℝ) (F : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ := F ∘ floorLatticePoint h

theorem floor_lattice_coordinate_error (h x : ℝ) (hh : 0 < h) :
    0 ≤ x-h*(⌊x/h⌋:ℝ) ∧ x-h*(⌊x/h⌋:ℝ) < h := by
  have hl := (mul_le_mul_of_nonneg_left (Int.floor_le (x/h)) hh.le)
  have hu := (mul_lt_mul_of_pos_left (Int.lt_floor_add_one (x/h)) hh)
  rw [mul_div_cancel₀ x hh.ne'] at hl hu
  constructor <;> linarith

theorem floorLatticePoint_dist_le (h : ℝ) (x : ℝ × ℝ) (hh : 0 < h) :
    dist (floorLatticePoint h x) x ≤ h := by
  rw [Prod.dist_eq]
  apply max_le
  · have he := floor_lattice_coordinate_error h x.1 hh
    change dist (h*(⌊x.1/h⌋:ℝ)) x.1 ≤ h
    rw [dist_comm, Real.dist_eq, abs_of_nonneg he.1]
    exact he.2.le
  · have he := floor_lattice_coordinate_error h x.2 hh
    change dist (h*(⌊x.2/h⌋:ℝ)) x.2 ≤ h
    rw [dist_comm, Real.dist_eq, abs_of_nonneg he.1]
    exact he.2.le

theorem floorLatticePoint_measurable (h : ℝ) : Measurable (floorLatticePoint h) := by
  unfold floorLatticePoint
  fun_prop

theorem floorLatticePoint_tendsto (mesh : ℕ → ℝ) (hm : ∀ n, 0 < mesh n)
    (hlim : Tendsto mesh atTop (𝓝 0)) (x : ℝ × ℝ) :
    Tendsto (fun n ↦ floorLatticePoint (mesh n) x) atTop (𝓝 x) := by
  apply Metric.tendsto_nhds.mpr
  intro ε hε
  filter_upwards [(tendsto_order.mp hlim).2 ε hε] with n hn
  exact lt_of_le_of_lt (floorLatticePoint_dist_le (mesh n) x (hm n)) hn

theorem floorLatticeSample_measurable (h : ℝ) (F : ℝ × ℝ → ℂ) (hF : Measurable F) :
    Measurable (floorLatticeSample h F) := hF.comp (floorLatticePoint_measurable h)

theorem floorLatticeSample_tendsto (mesh : ℕ → ℝ) (hm : ∀ n, 0 < mesh n)
    (hlim : Tendsto mesh atTop (𝓝 0)) (F : ℝ × ℝ → ℂ) (hF : Continuous F) (x : ℝ × ℝ) :
    Tendsto (fun n ↦ floorLatticeSample (mesh n) F x) atTop (𝓝 (F x)) :=
  (hF.tendsto x).comp (floorLatticePoint_tendsto mesh hm hlim x)

theorem vanishing_mesh_eventually_scale_condition (mesh : ℕ → ℝ)
    (hlim : Tendsto mesh atTop (𝓝 0)) (lo : ℝ) (hlo : 0 < lo) :
    ∀ᶠ n in atTop, (mesh n)^2 ≤ lo/6 := by
  have ht : Tendsto (fun n ↦ (mesh n)^2) atTop (𝓝 0) := by simpa using hlim.pow 2
  exact ((tendsto_order.mp ht).2 (lo/6) (by positivity)).mono fun _ hn ↦ hn.le

end
end CommutingConvergence
end OriginalModule22


-- Source: CommutingConvergence.LatticeBoxSampling
section OriginalModule23
set_option autoImplicit false
/-! An explicit finite box truncation aligned with meshes 1/(n+1).
Finite indices and the continuous support box coincide exactly. -/
open MeasureTheory Set Filter
open scoped Topology ENNReal
namespace CommutingConvergence
noncomputable section

def reciprocalLatticeMesh (n : ℕ) : ℝ := 1/((n:ℝ)+1)

def latticeBoxIndices (R : ℤ) (n : ℕ) : Finset ℤ :=
  Finset.Ico (-R*((n:ℤ)+1)) (R*((n:ℤ)+1))

def latticeSupportBox (R : ℤ) : Set (ℝ × ℝ) := Ico (-(R:ℝ)) (R:ℝ) ×ˢ Ico (-(R:ℝ)) (R:ℝ)

def latticeBoxSample (R : ℤ) (n : ℕ) (F : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ :=
  latticeCellExtension (latticeBoxIndices R n) (latticeBoxIndices R n) (reciprocalLatticeMesh n)
    (fun i j ↦ F (reciprocalLatticeMesh n*(i:ℝ), reciprocalLatticeMesh n*(j:ℝ)))

theorem reciprocalLatticeMesh_pos (n : ℕ) : 0 < reciprocalLatticeMesh n := by
  unfold reciprocalLatticeMesh
  positivity

theorem reciprocalLatticeMesh_tendsto : Tendsto reciprocalLatticeMesh atTop (𝓝 0) :=
  tendsto_one_div_add_atTop_nhds_zero_nat

theorem latticeBoxIndices_floor_mem_iff (R : ℤ) (n : ℕ) (x : ℝ) :
    ⌊x/reciprocalLatticeMesh n⌋ ∈ latticeBoxIndices R n ↔ x ∈ Ico (-(R:ℝ)) (R:ℝ) := by
  rw [latticeBoxIndices, Finset.mem_Ico, Int.le_floor, Int.floor_lt]
  simp only [Int.cast_mul, Int.cast_neg, Int.cast_add, Int.cast_natCast, Int.cast_one,
    reciprocalLatticeMesh, one_div, div_inv_eq_mul, mem_Ico]
  have hp : 0 < (n:ℝ)+1 := by positivity
  constructor
  · intro hx
    exact ⟨(mul_le_mul_iff_left₀ hp).mp hx.1, (mul_lt_mul_iff_left₀ hp).mp hx.2⟩
  · intro hx
    exact ⟨(mul_le_mul_iff_left₀ hp).mpr hx.1, (mul_lt_mul_iff_left₀ hp).mpr hx.2⟩

theorem latticeBoxSample_eq_indicator (R : ℤ) (n : ℕ) (F : ℝ × ℝ → ℂ) :
    latticeBoxSample R n F = (latticeSupportBox R).indicator (floorLatticeSample (reciprocalLatticeMesh n) F) := by
  funext x
  simp only [latticeBoxSample, latticeCellExtension, latticeBoxIndices_floor_mem_iff,
    latticeSupportBox, mem_prod, indicator, floorLatticeSample, Function.comp_apply,
    floorLatticePoint]

theorem latticeSupportBox_measurable (R : ℤ) : MeasurableSet (latticeSupportBox R) :=
  measurableSet_Ico.prod measurableSet_Ico

theorem latticeSupportBox_volume_lt_top (R : ℤ) : volume (latticeSupportBox R) < ∞ := by
  rw [latticeSupportBox, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
    Real.volume_Ico]
  exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top

theorem latticeBoxSample_measurable (R : ℤ) (n : ℕ) (F : ℝ × ℝ → ℂ) :
    Measurable (latticeBoxSample R n F) := latticeCellExtension_measurable _ _ _ _

theorem latticeBoxSample_zero_outside (R : ℤ) (n : ℕ) (F : ℝ × ℝ → ℂ)
    (x : ℝ × ℝ) (hx : x ∉ latticeSupportBox R) : latticeBoxSample R n F x = 0 := by
  rw [latticeBoxSample_eq_indicator]
  exact indicator_of_notMem hx _

theorem latticeBoxSample_norm_le (R : ℤ) (n : ℕ) (F : ℝ × ℝ → ℂ) (C : ℝ)
    (hC : 0 ≤ C) (hF : ∀ x, ‖F x‖ ≤ C) (x : ℝ × ℝ) : ‖latticeBoxSample R n F x‖ ≤ C := by
  rw [latticeBoxSample_eq_indicator]
  by_cases hx : x ∈ latticeSupportBox R
  · rw [indicator_of_mem hx]
    exact hF _
  · rw [indicator_of_notMem hx]
    simpa only [norm_zero] using hC

theorem latticeBoxSample_tendsto (R : ℤ) (F : ℝ × ℝ → ℂ) (hF : Continuous F)
    (hsupp : ∀ x ∉ latticeSupportBox R, F x = 0) (x : ℝ × ℝ) :
    Tendsto (fun n ↦ latticeBoxSample R n F x) atTop (𝓝 (F x)) := by
  by_cases hx : x ∈ latticeSupportBox R
  · have ht := floorLatticeSample_tendsto reciprocalLatticeMesh reciprocalLatticeMesh_pos
      reciprocalLatticeMesh_tendsto F hF x
    simpa only [latticeBoxSample_eq_indicator, indicator_of_mem hx] using ht
  · simpa only [latticeBoxSample_zero_outside R _ F x hx, hsupp x hx] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (0:ℂ)) atTop (𝓝 0))

end
end CommutingConvergence
end OriginalModule23


-- Source: CommutingConvergence.PlaneRectangleBoundary
section OriginalModule24
set_option autoImplicit false
/-! Rectangle-algebra fibers have null boundaries. A finite selector with these
fibers is locally constant almost everywhere, so actual floor sampling eventually
uses exactly the original label. No global continuity of the selector is assumed. -/
open MeasureTheory Set Filter
open scoped Topology
namespace CommutingConvergence
noncomputable section

theorem realIntervalGenerators_frontier_volume_zero {s : Set ℝ}
    (hs : s ∈ realIntervalGenerators) : volume (frontier s) = 0 := by
  rcases hs with rfl | ⟨a,b,hab,rfl⟩
  · simp
  · rcases hab.eq_or_lt with h | h
    · subst b
      simp
    · rw [frontier_Ioc h]
      exact Set.Finite.measure_zero (toFinite _) volume

theorem planeRectangleAlgebra_frontier_volume_zero {s : Set (ℝ × ℝ)}
    (hs : s ∈ planeRectangleAlgebra) : volume (frontier s) = 0 := by
  induction hs with
  | base s hs =>
    rcases hs with ⟨u,hu,v,hv,rfl⟩
    rw [frontier_prod_eq]
    apply measure_union_null
    · rw [Measure.volume_eq_prod, Measure.prod_prod, realIntervalGenerators_frontier_volume_zero hv,
        mul_zero]
    · rw [Measure.volume_eq_prod, Measure.prod_prod, realIntervalGenerators_frontier_volume_zero hu,
        zero_mul]
  | empty => simp
  | compl s _ ih => simpa only [frontier_compl] using ih
  | union s t _ _ ihs iht =>
    apply measure_mono_null (frontier_union_subset s t)
    exact measure_union_null (measure_mono_null inter_subset_left ihs)
      (measure_mono_null inter_subset_right iht)

theorem rectangle_fiber_eventually_eq {κ : Type*} (select : ℝ × ℝ → κ)
    (p : ℝ × ℝ) (hp : p ∉ frontier (select ⁻¹' {select p})) :
    ∀ᶠ y in 𝓝 p, select y = select p := by
  have hi : p ∈ interior (select ⁻¹' {select p}) := by
    by_contra hn
    exact hp ⟨subset_closure (by simp), hn⟩
  filter_upwards [mem_interior_iff_mem_nhds.mp hi] with y hy
  exact hy

theorem plane_rectangle_selector_ae_locally_constant {κ : Type*} [Fintype κ]
    (select : ℝ × ℝ → κ) (hs : ∀ q, select ⁻¹' {q} ∈ planeRectangleAlgebra) :
    ∀ᵐ p ∂volume, ∀ᶠ y in 𝓝 p, select y = select p := by
  have hq : ∀ q : κ, ∀ᵐ p ∂volume, p ∉ frontier (select ⁻¹' {q}) := by
    intro q
    exact ae_iff.mpr (by simpa using planeRectangleAlgebra_frontier_volume_zero (hs q))
  filter_upwards [ae_all_iff.mpr hq] with p hp
  exact rectangle_fiber_eventually_eq select p (hp (select p))

theorem plane_rectangle_selector_floor_eventually_eq {κ : Type*} [Fintype κ]
    (select : ℝ × ℝ → κ) (hs : ∀ q, select ⁻¹' {q} ∈ planeRectangleAlgebra) :
    ∀ᵐ p ∂volume, ∀ᶠ n in atTop,
      select (floorLatticePoint (reciprocalLatticeMesh n) p) = select p := by
  filter_upwards [plane_rectangle_selector_ae_locally_constant select hs] with p hp
  exact (floorLatticePoint_tendsto reciprocalLatticeMesh reciprocalLatticeMesh_pos
    reciprocalLatticeMesh_tendsto p).eventually hp

end
