theorem finite_menu_exists_positive_lower_bound {ι : Type*}
    (menu : Finset ι) (a : ι → ℝ) (ha : ∀ l ∈ menu, 0 < a l) :
    ∃ lo : ℝ, 0 < lo ∧ ∀ l ∈ menu, lo ≤ a l := by
  classical
  revert ha
  induction menu using Finset.induction_on with
  | empty =>
    intro _
    exact ⟨1, by norm_num, by simp⟩
  | @insert l menu hl ih =>
    intro ha
    obtain ⟨lo, hlo, hlow⟩ := ih (fun q hq ↦ ha q (Finset.mem_insert_of_mem hq))
    refine ⟨min lo (a l), lt_min hlo (ha l (Finset.mem_insert_self _ _)), ?_⟩
    intro q hq
    rcases Finset.mem_insert.mp hq with rfl | hq
    · exact min_le_right _ _
    · exact (min_le_left _ _).trans (hlow q hq)

