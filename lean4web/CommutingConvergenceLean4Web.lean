    _ = ∑ i ∈ Finset.range N, ∫ _ in (a + h * i)..(a + h * (i + 1)),
        f (a + h * i) := by
      apply Finset.sum_congr rfl
      intro i _
      simp only [intervalIntegral.integral_const, smul_eq_mul]
      ring
    _ ≤ ∑ i ∈ Finset.range N, ∫ x in (a + h * i)..(a + h * (i + 1)), g x := by
      apply Finset.sum_le_sum
      intro i _
      apply intervalIntegral.integral_mono_on (by nlinarith)
        intervalIntegrable_const hg.intervalIntegrable
      intro x hx
      exact unimodalMeshEnvelope_dominates f p h M (a + h * i) x hf hM hL hR
        hx.1 (by nlinarith [hx.2])
    _ = ∫ x in a..(a + h * N), g x := by
      simpa only [Nat.cast_add, Nat.cast_one, Nat.cast_zero, mul_zero, add_zero] using
        intervalIntegral.sum_integral_adjacent_intervals
          (a := fun i : ℕ ↦ a + h * i) (n := N) (fun _ _ ↦ hg.intervalIntegrable)
    _ ≤ ∫ x, g x := by
      rw [intervalIntegral.integral_of_le (by nlinarith [mul_nonneg hh (Nat.cast_nonneg N : (0:ℝ) ≤ N)] : a ≤ a + h * N)]
      exact setIntegral_le_integral hg (ae_of_all _ hg0)
    _ = _ := unimodalMeshEnvelope_integral f p h M hi hh

end
