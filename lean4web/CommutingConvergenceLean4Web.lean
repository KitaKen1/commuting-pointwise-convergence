      _ = Matrix.trace (Rᴴ * ((R * CFC.sqrt P) * B)) := Matrix.trace_mul_comm _ _
      _ = Matrix.trace ((P * CFC.sqrt P) * B) := by
        simp only [P, Matrix.mul_assoc]
      _ = _ := by rw [hcomm, Matrix.mul_assoc]
