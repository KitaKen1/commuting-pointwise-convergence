  have hcomm : P * CFC.sqrt P = CFC.sqrt P * P := by
    calc
      _ = (CFC.sqrt P * CFC.sqrt P) * CFC.sqrt P := by rw [hs]
      _ = CFC.sqrt P * (CFC.sqrt P * CFC.sqrt P) := Matrix.mul_assoc _ _ _
      _ = _ := by rw [hs]
  have hc : Matrix.trace (CFC.sqrt P * (B * P)) =
