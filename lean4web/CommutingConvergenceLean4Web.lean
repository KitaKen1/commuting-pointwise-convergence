    (x : n → ℂ) : matrixVectorQuadraticCLM x P ≤ matrixVectorQuadraticCLM x Q := by
  have h := matrixVectorQuadratic_nonneg (Q - P) (sub_nonneg.mpr hPQ).posSemidef x
  simpa only [map_sub, sub_nonneg] using h

