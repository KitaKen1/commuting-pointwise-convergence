    (hh : 0 ≤ h) (hσ : 0 < σ) :
    ∑ i ∈ Finset.range N, h * gaussianHeatDensity σ (a + h * i) p ≤
      1 + 2 * h * (Real.sqrt (2 * Real.pi * σ))⁻¹ := by
  have he := gaussian_grid_mass_le_one_add_peak h σ p a N hh hσ
  have hn : 0 ≤ h * (Real.sqrt (2 * Real.pi * σ))⁻¹ := by positivity
