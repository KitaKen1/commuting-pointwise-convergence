    (∫ x in (0 : ℝ)..1, (realHermite n).eval x) =
      ((realHermite (n + 1)).eval 1 - (realHermite (n + 1)).eval 0) / (n + 1 : ℕ) := by
  have hn : (n : ℝ) + 1 ≠ 0 := by positivity
  have hd (x : ℝ) : HasDerivAt
      (fun y ↦ (realHermite (n + 1)).eval y / (n + 1 : ℕ)) ((realHermite n).eval x) x := by
    simpa [realHermite_derivative_succ, nsmul_eq_mul, mul_div_cancel_left₀ _ hn] using
