omit [Fintype m] [Fintype n] [Fintype p] [DecidableEq m] [DecidableEq n] [DecidableEq p] in
theorem gaussianEdgeArray_norm_entry (A : Matrix m n ℂ) (h σ τ : ℝ)
    (u : m → ℝ) (v : n → ℝ) (x y : ℝ) (i : m) (j : n) :
