-- Source: CommutingConvergence.GaussianScorePolynomials
section OriginalModule42
set_option autoImplicit false
/-! Variance-aware Hermite polynomials in the unnormalized center score.
The parameter `v` is inverse variance.  No square roots or nonzero-variance
assumptions are needed for this polynomial algebra.  The lowering proof follows
the attributed TauCeti Hermite lowering argument, with the variance retained. -/

open Polynomial

namespace CommutingConvergence

noncomputable def gaussianScorePolynomial (v : ℝ) : ℕ → Polynomial ℝ
  | 0 => 1
  | n + 1 => X * gaussianScorePolynomial v n -
      C v * (gaussianScorePolynomial v n).derivative

theorem gaussianScorePolynomial_zero (v : ℝ) : gaussianScorePolynomial v 0 = 1 := rfl

theorem gaussianScorePolynomial_succ (v : ℝ) (n : ℕ) :
    gaussianScorePolynomial v (n + 1) = X * gaussianScorePolynomial v n -
      C v * (gaussianScorePolynomial v n).derivative := rfl

theorem gaussianScorePolynomial_one (v : ℝ) : gaussianScorePolynomial v 1 = X := by
  simp [gaussianScorePolynomial]

theorem gaussianScorePolynomial_two (v : ℝ) :
    gaussianScorePolynomial v 2 = X ^ 2 - C v := by
  simp [gaussianScorePolynomial, pow_two]

theorem gaussianScorePolynomial_three (v : ℝ) :
    gaussianScorePolynomial v 3 = X ^ 3 - C (3 * v) * X := by
  rw [gaussianScorePolynomial_succ, gaussianScorePolynomial_two]
  simp [derivative_pow, map_mul, map_ofNat]
  ring

theorem gaussianScorePolynomial_four (v : ℝ) :
    gaussianScorePolynomial v 4 = X ^ 4 - C (6 * v) * X ^ 2 + C (3 * v ^ 2) := by
  rw [gaussianScorePolynomial_succ, gaussianScorePolynomial_three]
  simp [derivative_pow, map_mul, map_ofNat, map_pow]
  ring

theorem gaussianScorePolynomial_five (v : ℝ) :
    gaussianScorePolynomial v 5 = X ^ 5 - C (10 * v) * X ^ 3 + C (15 * v ^ 2) * X := by
  rw [gaussianScorePolynomial_succ, gaussianScorePolynomial_four]
  simp [derivative_pow, map_mul, map_ofNat, map_pow]
  ring

theorem gaussianScorePolynomial_derivative_succ (v : ℝ) (n : ℕ) :
    (gaussianScorePolynomial v (n + 1)).derivative =
      (n + 1) • gaussianScorePolynomial v n := by
  induction n with
  | zero => simp [gaussianScorePolynomial]
  | succ n ih =>
    rw [gaussianScorePolynomial_succ]
    simp only [derivative_sub, derivative_mul, derivative_X, one_mul,
      derivative_C, zero_mul, zero_add, ih, derivative_smul]
    rw [gaussianScorePolynomial_succ v n]
    ring_nf

/-- At unit variance this is exactly the previously attributed Hermite family. -/
theorem gaussianScorePolynomial_one_eq_realHermite (n : ℕ) :
    gaussianScorePolynomial 1 n = realHermite n := by
  induction n with
  | zero => simp [gaussianScorePolynomial, realHermite, hermite_zero]
  | succ n ih =>
    simp only [gaussianScorePolynomial_succ, ih, map_one, one_mul]
    simp only [realHermite, hermite_succ, Polynomial.map_sub,
      Polynomial.map_mul, map_X, ← derivative_map]

/-- Transfer the attributed TauCeti parity theorem to our real polynomial. -/
theorem realHermite_eval_neg (n : ℕ) (x : ℝ) :
    (realHermite n).eval (-x) = (-1) ^ n * (realHermite n).eval x := by
  simpa [realHermite, Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map] using
    (Polynomial.hermite_aeval_neg n x)

end CommutingConvergence
end OriginalModule42


