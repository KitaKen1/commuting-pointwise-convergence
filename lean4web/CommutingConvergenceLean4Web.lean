    (F : ℝ → ℝ) (hF : MemLp F 2 μ) (P : Polynomial ℝ) :
    dist (hF.toLp F) (TauCeti.polynomialEvalLp ℝ hmom P) =
      lpNorm (fun x ↦ F x - P.eval x) 2 μ := by
  rw [dist_eq_norm]
  unfold TauCeti.polynomialEvalLp
  dsimp only [LinearMap.coe_mk, AddHom.coe_mk]
  rw [← MemLp.toLp_sub, Lp.norm_toLp]
