      _ = Matrix.trace ((CFC.sqrt (R * Rᴴ) * R) * B * Rᴴ) := by
        simp only [Matrix.mul_assoc]
      _ = Matrix.trace ((R * CFC.sqrt P) * B * Rᴴ) := by
