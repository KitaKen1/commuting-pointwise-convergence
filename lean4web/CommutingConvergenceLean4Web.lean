    Continuous (standardEulerKernel k) := by
  rcases (show k = 0 ∨ k = 1 by omega) with h0 | h1
  · subst k
    rw [show standardEulerKernel 0 = (fun x ↦ 2 * gaussianHeatDensity 1 0 x -
      iteratedDeriv 2 (gaussianHeatDensity 1 0) x) from funext standardEuler_even_eq_gaussian_derivatives]
    have hD : Continuous (gaussianHeatDensity 1 0) :=
      continuous_iff_continuousAt.mpr fun x ↦ (gaussianHeatDensity_center_hasDerivAt 1 0 x).continuousAt
    exact (hD.const_mul 2).sub (gaussianHeatDensity_iteratedDeriv_continuous 2 1 0)
  · subst k
    rw [show standardEulerKernel 1 = iteratedDeriv 3 (gaussianHeatDensity 1 0) from
      funext standardEuler_odd_eq_gaussian_derivative]
    exact gaussianHeatDensity_iteratedDeriv_continuous 3 1 0

