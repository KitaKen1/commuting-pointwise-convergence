  rw [(floorObservable_time_integral F N u v hu hv).2]
  rfl

/-- All four cell coefficients form a convex average on the phase square. -/
theorem complexPhaseCell_norm_le (a b c d : ℂ) (C u v : ℝ)
    (ha : ‖a‖ ≤ C) (hb : ‖b‖ ≤ C) (hc : ‖c‖ ≤ C) (hd : ‖d‖ ≤ C)
    (hu : u ∈ Icc (0 : ℝ) 1) (hv : v ∈ Icc (0 : ℝ) 1) :
    ‖complexPhaseCell a b c d u v‖ ≤ C := by
  rw [← (phaseStep_integral a b c d u v hu hv).2]
