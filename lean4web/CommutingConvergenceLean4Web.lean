/-! The native matrix probability-averaging inequality with a finite cost integral.
The proof integrates trace trials and uses square-root Jensen. Rank may vary;
support of the average is proved, not assumed. -/

open Matrix MeasureTheory
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator

namespace CommutingConvergence

variable {n Ω : Type*} [Fintype n] [DecidableEq n] [MeasurableSpace Ω]

/-- The first slot of the real trace pairing as a continuous real linear map. -/
noncomputable def matrixTracePairCLM (X : Matrix n n ℂ) : Matrix n n ℂ →L[ℝ] ℝ :=
  (show Matrix n n ℂ →ₗ[ℝ] ℝ from
    { toFun := fun K ↦ matrixTracePair K X
      map_add' := fun K L ↦ matrixTracePair_add_left K L X
      map_smul' := fun c K ↦ matrixTracePair_smul_left c K X }).toContinuousLinearMap

/-- The Sylvester quadratic form is linear in its base matrix. -/
noncomputable def matrixSylvesterQuadraticCLM (X : Matrix n n ℂ) : Matrix n n ℂ →L[ℝ] ℝ :=
  (show Matrix n n ℂ →ₗ[ℝ] ℝ from
    { toFun := fun A ↦ matrixSylvesterQuadratic A X
      map_add' := by
        intro A B
        have h : (A + B) * X + X * (A + B) = (A * X + X * A) + (B * X + X * B) := by
          noncomm_ring
        change matrixTracePair X ((A + B) * X + X * (A + B)) = _
        rw [h, matrixTracePair_add_right]
        rfl
      map_smul' := by
        intro c A
        simp [matrixSylvesterQuadratic, ← smul_add, matrixTracePair_smul_right] }).toContinuousLinearMap

theorem integrable_matrixTracePair (μ : Measure Ω) (K : Ω → Matrix n n ℂ)
    (hK : Integrable K μ) (X : Matrix n n ℂ) :
    Integrable (fun ω ↦ matrixTracePair (K ω) X) μ :=
  (matrixTracePairCLM X).integrable_comp hK

theorem integral_matrixTracePair (μ : Measure Ω) (K : Ω → Matrix n n ℂ)
    (hK : Integrable K μ) (X : Matrix n n ℂ) :
    (∫ ω, matrixTracePair (K ω) X ∂μ) = matrixTracePair (∫ ω, K ω ∂μ) X :=
  (matrixTracePairCLM X).integral_comp_comm hK

theorem integrable_matrixSylvesterQuadratic (μ : Measure Ω) (A : Ω → Matrix n n ℂ)
    (hA : Integrable A μ) (X : Matrix n n ℂ) :
    Integrable (fun ω ↦ matrixSylvesterQuadratic (A ω) X) μ :=
  (matrixSylvesterQuadraticCLM X).integrable_comp hA

theorem integral_matrixSylvesterQuadratic (μ : Measure Ω) (A : Ω → Matrix n n ℂ)
    (hA : Integrable A μ) (X : Matrix n n ℂ) :
    (∫ ω, matrixSylvesterQuadratic (A ω) X ∂μ) =
      matrixSylvesterQuadratic (∫ ω, A ω ∂μ) X :=
  (matrixSylvesterQuadraticCLM X).integral_comp_comm hA

theorem integrable_matrixSylvesterTrial (μ : Measure Ω) (A K : Ω → Matrix n n ℂ)
    (hA : Integrable A μ) (hK : Integrable K μ) (X : Matrix n n ℂ) :
    Integrable (fun ω ↦ matrixSylvesterTrial (A ω) (K ω) X) μ :=
  (((integrable_matrixTracePair μ K hK X).const_mul 2).sub
    (integrable_matrixSylvesterQuadratic μ A hA X)).const_mul (3 / 2)

theorem integral_matrixSylvesterTrial (μ : Measure Ω) (A K : Ω → Matrix n n ℂ)
    (hA : Integrable A μ) (hK : Integrable K μ) (X : Matrix n n ℂ) :
    (∫ ω, matrixSylvesterTrial (A ω) (K ω) X ∂μ) =
      matrixSylvesterTrial (∫ ω, A ω ∂μ) (∫ ω, K ω ∂μ) X := by
  simp only [matrixSylvesterTrial, integral_const_mul,
    integral_sub ((integrable_matrixTracePair μ K hK X).const_mul 2)
      (integrable_matrixSylvesterQuadratic μ A hA X),
    integral_matrixTracePair μ K hK X, integral_matrixSylvesterQuadratic μ A hA X]

/-- The supported Gram cost has the same variational characterization at its square root. -/
theorem gramSylvesterCost_le_iff (P K : Matrix n n ℂ) (hP : P.PosSemidef)
    (hK : MatrixSupportedOn P K) (b : ℝ) :
    gramSylvesterCost P K ≤ b ↔ ∀ X, matrixSylvesterTrial (CFC.sqrt P) K X ≤ b :=
  spectralSylvesterCost_le_iff _ (CFC.sqrt_nonneg P).posSemidef K
    ((matrixSupportedOn_sqrt_iff P K hP).mpr hK) b

/-- Square-root Jensen reverses the trial penalty in the direction needed for averaging. -/
theorem matrixSylvesterTrial_sqrt_integral_le (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P K : Ω → Matrix n n ℂ) (hP : ∀ᵐ ω ∂μ, (P ω).PosSemidef)
    (hPi : Integrable P μ) (hKi : Integrable K μ) (X : Matrix n n ℂ) :
    matrixSylvesterTrial (CFC.sqrt (∫ ω, P ω ∂μ)) (∫ ω, K ω ∂μ) X ≤
      ∫ ω, matrixSylvesterTrial (CFC.sqrt (P ω)) (K ω) X ∂μ := by
  have hSi := integrable_operator_sqrt μ P (hP.mono fun _ h ↦ h.nonneg) hPi
  rw [integral_matrixSylvesterTrial μ _ K hSi hKi X]
  unfold matrixSylvesterTrial
  gcongr
  exact matrixSylvesterQuadratic_mono _ _ X
    (matrix_integral_sqrt_le_sqrt_integral μ P hP hPi)

/-- Native matrix cost averaging. The cost integral is finite in this theorem;
there is no common-rank, common-support, or positive spectral-gap hypothesis. -/
theorem gramSylvesterCost_integral_le (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P K : Ω → Matrix n n ℂ) (hP : ∀ᵐ ω ∂μ, (P ω).PosSemidef)
    (hPi : Integrable P μ) (hKi : Integrable K μ)
    (hK : ∀ᵐ ω ∂μ, MatrixSupportedOn (P ω) (K ω))
    (hcost : Integrable (fun ω ↦ gramSylvesterCost (P ω) (K ω)) μ) :
    gramSylvesterCost (∫ ω, P ω ∂μ) (∫ ω, K ω ∂μ) ≤
      ∫ ω, gramSylvesterCost (P ω) (K ω) ∂μ := by
  rw [gramSylvesterCost_le_iff _ _ (matrix_integral_posSemidef μ P hP)
    (matrixSupportedOn_integral μ P K hP hPi hKi hK)]
  intro X
  have hSi := integrable_operator_sqrt μ P (hP.mono fun _ h ↦ h.nonneg) hPi
  apply (matrixSylvesterTrial_sqrt_integral_le μ P K hP hPi hKi X).trans
  apply integral_mono_ae (integrable_matrixSylvesterTrial μ _ K hSi hKi X) hcost
  filter_upwards [hP, hK] with ω hPω hKω
  exact matrixSylvesterTrial_le_cost _ (CFC.sqrt_nonneg (P ω)).posSemidef (K ω)
    ((matrixSupportedOn_sqrt_iff (P ω) (K ω) hPω).mpr hKω) X

end CommutingConvergence
end OriginalModule121


