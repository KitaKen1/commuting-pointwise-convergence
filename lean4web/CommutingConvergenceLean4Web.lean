section OriginalModule28
set_option autoImplicit false
/-! Construct finite-valued rectangle-algebra selectors, rather than assuming a
selector approximation. Priority patching keeps each label unchanged and bounds
the disagreement set by the union of the approximated fiber errors. -/
open MeasureTheory Set Filter
open scoped ENNReal symmDiff Topology
namespace CommutingConvergence
noncomputable section

def finiteLabelPatch {X κ : Type*} (labels : List κ) (A : κ → Set X) (q0 : κ) (x : X) : κ := by
  classical
  exact labels.foldr (fun q r ↦ if x ∈ A q then q else r) q0

theorem finiteLabelPatch_fiber_mem_algebra {X κ : Type*} (labels : List κ)
    (A : κ → Set X) (q0 : κ) (C : Set (Set X)) (hC : IsSetAlgebra C)
    (hA : ∀ q ∈ labels, A q ∈ C) :
    ∀ q, (finiteLabelPatch labels A q0) ⁻¹' {q} ∈ C := by
  classical
  induction labels with
  | nil =>
    intro q
    have he : (finiteLabelPatch [] A q0) ⁻¹' {q} = if q0 = q then univ else ∅ := by
      ext x
      by_cases hq : q0 = q <;> simp [finiteLabelPatch, hq]
    rw [he]
    split
    · exact hC.univ_mem
    · exact hC.empty_mem
  | cons i labels ih =>
    have hi := hA i (by simp)
    have ht := ih (fun q hq ↦ hA q (by simp [hq]))
    intro q
    have he : (finiteLabelPatch (i :: labels) A q0) ⁻¹' {q} =
        if i = q then A i ∪ ((A i)ᶜ ∩ (finiteLabelPatch labels A q0) ⁻¹' {q})
        else (A i)ᶜ ∩ (finiteLabelPatch labels A q0) ⁻¹' {q} := by
      ext x
      by_cases hq : i = q
      · subst q
        by_cases hx : x ∈ A i <;> simp [finiteLabelPatch, hx]
      · by_cases hx : x ∈ A i <;> simp [finiteLabelPatch, hx, hq]
    rw [he]
    split
    · exact hC.union_mem hi (hC.inter_mem (hC.compl_mem hi) (ht q))
    · exact hC.inter_mem (hC.compl_mem hi) (ht q)

theorem finiteLabelPatch_measurable {X κ : Type*} [MeasurableSpace X] [MeasurableSpace κ]
    (labels : List κ) (A : κ → Set X) (q0 : κ)
    (hA : ∀ q ∈ labels, MeasurableSet (A q)) :
    Measurable (finiteLabelPatch labels A q0) := by
  classical
  induction labels with
  | nil => exact measurable_const
  | cons i labels ih =>
    exact Measurable.ite (hA i (by simp)) measurable_const
      (ih (fun q hq ↦ hA q (by simp [hq])))

theorem finiteLabelPatch_eq_of_membership {X κ : Type*} (labels : List κ)
    (A : κ → Set X) (q0 q : κ) (x : X) (hq : q ∈ labels)
    (hA : ∀ i ∈ labels, x ∈ A i ↔ q = i) :
    finiteLabelPatch labels A q0 x = q := by
  classical
  induction labels with
  | nil => simp at hq
  | cons i labels ih =>
    by_cases hi : q = i
    · have hx := (hA i (by simp)).mpr hi
      simp [finiteLabelPatch, hx, hi]
    · have hx := (hA i (by simp)).not.mpr hi
      have ht : q ∈ labels := (List.mem_cons.mp hq).resolve_left hi
      simpa [finiteLabelPatch, hx] using ih ht (fun j hj ↦ hA j (by simp [hj]))

theorem plane_finite_label_exists_rectangle_algebra_approx {κ : Type*}
    [Fintype κ] [Nonempty κ] [MeasurableSpace κ] [MeasurableSingletonClass κ]
    (μ : Measure (ℝ × ℝ)) [IsFiniteMeasure μ] (select : ℝ × ℝ → κ)
    (hs : Measurable select) (ε : ℝ) (hε : 0 < ε) :
    ∃ g : ℝ × ℝ → κ, Measurable g ∧
      (∀ q, g ⁻¹' {q} ∈ planeRectangleAlgebra) ∧ μ {x | g x ≠ select x} < ENNReal.ofReal ε := by
  classical
  let δ : ℝ := ε / ((Fintype.card κ : ℝ) + 1)
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hex (q : κ) := plane_measurableSet_exists_rectangle_algebra_approx
    μ (select ⁻¹' {q}) (hs (measurableSet_singleton q)) (ENNReal.ofReal δ) (by positivity)
  choose A hA herror using hex
  let labels := (Finset.univ : Finset κ).toList
  let q0 : κ := Classical.arbitrary κ
  let g := finiteLabelPatch labels A q0
  have hAg : ∀ q ∈ labels, A q ∈ planeRectangleAlgebra := fun q _ ↦ hA q
