  simp only [gaussianScorePolynomial_two, Polynomial.eval_sub, Polynomial.eval_pow,
    Polynomial.eval_X, Polynomial.eval_C, gaussianHeatScore, zero_sub, div_one, inv_one,
    standardEulerKernel, pow_zero, mul_one, ← gaussianHeatDensity_unit_eq_pdf]
  ring

theorem standardEuler_odd_eq_gaussian_derivative (x : ℝ) :
    standardEulerKernel 1 x = iteratedDeriv 3 (gaussianHeatDensity 1 0) x := by
  rw [gaussianHeatDensity_center_third_deriv]
  simp only [gaussianHeatScore, zero_sub, div_one, inv_one, standardEulerKernel,
    pow_one, ← gaussianHeatDensity_unit_eq_pdf]
  ring

