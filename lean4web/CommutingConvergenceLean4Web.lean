  have h1 : 0 ≤ (Iic p).indicator f x := Set.indicator_nonneg (fun x _ ↦ hf x) _
  have h2 : 0 ≤ (Ioi p).indicator f (x - h) := Set.indicator_nonneg (fun x _ ↦ hf x) _
