This does not cover two arbitrary commuting transformations. -/
theorem ae_doubleAverage_diagonal_l3 (T : X → X) (hT : MeasurePreserving T μ μ)
    (f g : X → ℂ) (hf : MemLp f 3 μ) (hg : MemLp g 3 μ) :
    ∀ᵐ x ∂μ, ∃ L : ℂ,
      Tendsto (fun N ↦ doubleAverage T T f g N x) atTop (𝓝 L) := by
  have hf2 : MemLp f 2 μ := hf.mono_exponent (by norm_num)
  have hg2 : MemLp g 2 μ := hg.mono_exponent (by norm_num)
  have hprod : Integrable (fun x ↦ f x * g x) μ := hf2.integrable_mul hg2
  simpa only [doubleAverage] using ae_complex_birkhoff μ T hT (fun x ↦ f x * g x) hprod

