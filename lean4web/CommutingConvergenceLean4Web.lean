    (hFi : Integrable (fun p : ℝ × ℝ ↦ F p.1 p.2 (d - p.1 - p.2)))
    (hG : AEStronglyMeasurable (fun p : ℝ × ℝ ↦ G p.1 p.2 (d - p.1 - p.2)) volume)
    (hB : ∀ s ∈ Ioo (d - 1) (d + 1), ∀ p : ℝ × ℝ, |G p.1 p.2 (s - p.1 - p.2)| ≤ B p)
    (hBi : Integrable B)
    (hD : ∀ x y z, HasDerivAt (F x y) (G x y z) z) :
    Integrable (fun p : ℝ × ℝ ↦ G p.1 p.2 (d - p.1 - p.2)) ∧
    HasDerivAt (fun s ↦ ∫ p : ℝ × ℝ, F p.1 p.2 (s - p.1 - p.2))
