  have he : Tendsto e atTop (𝓝[≠] 0) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨tendsto_one_div_add_atTop_nhds_zero_nat, Eventually.of_forall fun n ↦ ?_⟩
    change e n ≠ 0
    dsimp [e]
    positivity
