namespace CommutingConvergence

variable {n : Type*} [Fintype n] [DecidableEq n]

theorem kernel_completion_mul_complement (P E : Matrix n n ℂ)
    (hEE : E * E = E) (hPE : P * E = 0) : (P + E) * (1 - E) = P := by
  simp only [Matrix.add_mul, Matrix.mul_sub, Matrix.mul_one, hPE, hEE, zero_add,
    add_sub_cancel_right]

/-- The completed matrix identifies the original kernel with the complementary block. -/
theorem kernel_completion_mulVec_zero_iff (P E : Matrix n n ℂ)
    (hEE : E * E = E) (hPE : P * E = 0) (hQ : (P + E).PosDef) (x : n → ℂ) :
    P *ᵥ x = 0 ↔ (1 - E) *ᵥ x = 0 := by
  have hinj := Matrix.mulVec_injective_iff_isUnit.mpr hQ.isUnit
  constructor
  · intro hx
    apply hinj
    rw [Matrix.mulVec_mulVec, kernel_completion_mul_complement P E hEE hPE,
      hx, Matrix.mulVec_zero]
  · intro hx
    rw [← kernel_completion_mul_complement P E hEE hPE, ← Matrix.mulVec_mulVec,
      hx, Matrix.mulVec_zero]

/-- A matrix that annihilates the kernel block on both sides is supported on P. -/
theorem matrixSupportedOn_of_kernel_completion (P K E : Matrix n n ℂ)
    (hE : E.IsHermitian) (hEE : E * E = E) (hPE : P * E = 0)
    (hQ : (P + E).PosDef) (hKE : K * E = 0) (hEK : E * K = 0) :
    MatrixSupportedOn P K := by
  have hKE' : Kᴴ * E = 0 := by
    have h := congrArg Matrix.conjTranspose hEK
    simpa only [Matrix.conjTranspose_mul, hE.eq, Matrix.conjTranspose_zero] using h
  have h1 : K * (1 - E) = K := by rw [Matrix.mul_sub, Matrix.mul_one, hKE, sub_zero]
  have h2 : Kᴴ * (1 - E) = Kᴴ := by rw [Matrix.mul_sub, Matrix.mul_one, hKE', sub_zero]
  intro x hx
  have he := (kernel_completion_mulVec_zero_iff P E hEE hPE hQ x).mp hx
  constructor
  · rw [← h1, ← Matrix.mulVec_mulVec, he, Matrix.mulVec_zero]
  · rw [← h2, ← Matrix.mulVec_mulVec, he, Matrix.mulVec_zero]

/-- The full supported Sylvester solution, not just its scalar cost, survives completion. -/
