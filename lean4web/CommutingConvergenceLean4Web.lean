theorem ae_bilinear_endpoint_tendsto_zero (T S : X → X)
    (hT : MeasurePreserving T μ μ) (hS : MeasurePreserving S μ μ)
    (f g : X → ℂ) (hf : MemLp f ∞ μ) (hg : MemLp g ∞ μ) :
    ∀ᵐ x ∂μ, Tendsto (fun N ↦
      (f (T^[N] x) * g (S^[N] x) - f x * g x) / (N : ℂ)) atTop (𝓝 0) := by
  have hfb := ae_all_iterate_bound μ T hT f _ (ae_le_lpNorm_exponent_top hf)
  have hgb := ae_all_iterate_bound μ S hS g _ (ae_le_lpNorm_exponent_top hg)
  filter_upwards [hfb, hgb] with x hfx hgx
  have hbounded (n : ℕ) : ‖f (T^[n] x) * g (S^[n] x)‖ ≤
