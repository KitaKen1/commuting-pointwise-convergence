    2 * (Real.sqrt (2 * Real.pi))⁻¹ = Real.sqrt (2 / Real.pi) := by
  rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.sqrt_div (by norm_num : (0:ℝ) ≤ 2)]
  have h2 : Real.sqrt 2 ≠ 0 := by positivity
  have hp : Real.sqrt Real.pi ≠ 0 := by positivity
  have hs := Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 2)
  field_simp
  nlinarith

/-- The precise uniform constant appearing in the saved paper. -/
theorem gaussian_grid_mass_le_paper_constant (h σ p a : ℝ) (N : ℕ)
    (hh : 0 ≤ h) (hσ : 0 < σ) (hmesh : h ^ 2 ≤ σ) :
    ∑ i ∈ Finset.range N, h * gaussianHeatDensity σ (a + h * i) p ≤
      1 + Real.sqrt (2 / Real.pi) := by
  have he := gaussian_grid_mass_le_uniform h σ p a N hh hσ hmesh
  rw [← gaussian_two_peaks_constant]
  have hc : 0 ≤ (Real.sqrt (2 * Real.pi))⁻¹ := by positivity
  linarith

end
end CommutingConvergence
end OriginalModule6


