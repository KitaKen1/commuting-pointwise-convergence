        intro w z
        simp only [densityGram, Pi.add_apply, Complex.ofReal_add]
        rw [← Matrix.diagonal_add, Matrix.mul_add, Matrix.add_mul]
      map_smul' := by
        intro c w
        have hd : Matrix.diagonal (fun i ↦ ((c • w) i : ℂ)) =
            c • Matrix.diagonal (fun i ↦ (w i : ℂ)) := by
          rw [← Matrix.diagonal_smul]
          congr 1
          funext i
          simp [Complex.real_smul, smul_eq_mul]
        rw [densityGram, hd, Matrix.mul_smul, Matrix.smul_mul]
