  · exact Eventually.of_forall hF
  · exact hFi
  · exact hG
  · exact Eventually.of_forall fun p s hs ↦ by simpa only [Real.norm_eq_abs] using hB s hs p
  · exact hBi
  · apply Eventually.of_forall
    intro p s _
    have hd := (hD p.1 p.2 (s - p.1 - p.2)).comp s
      (((hasDerivAt_id s).sub_const p.1).sub_const p.2)
    simpa only [mul_one, Function.comp_def, id_eq] using hd

theorem abs_le_offset_window (d s : ℝ) (hs : s ∈ Ioo (d - 1) (d + 1)) :
    |s| ≤ |d| + 1 := by
  rcases hs with ⟨hl, hr⟩
  apply abs_le.mpr
  constructor <;> linarith [le_abs_self d, neg_abs_le d]

