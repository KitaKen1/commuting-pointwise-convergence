    gaussianUniformDecay hi x * gaussianUniformDecay hi y ≤
      gaussianPlaneOffsetFactor hi D * gaussianPlaneDecay hi x y :=
  gaussianUniformDecay_pair_le_plane hi x y y D hhi (by nlinarith [sq_nonneg x, sq_nonneg y, sq_nonneg D])

