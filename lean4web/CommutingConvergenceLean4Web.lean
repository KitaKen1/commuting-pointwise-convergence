theorem interval_endpoint_gap_lower (a s t : ℝ) (hst : s < t) (ha : a ∉ Ioo s t) :
    a ≤ s ↔ a < t := by
  constructor
  · intro h
    exact h.trans_lt hst
  · intro h
    by_contra hn
    exact ha ⟨lt_of_not_ge hn,h⟩

theorem interval_endpoint_gap_upper (b s t : ℝ) (hst : s < t) (hb : b ∉ Ioo s t) :
    s < b ↔ t ≤ b := by
  constructor
  · intro h
    by_contra hn
    exact hb ⟨h,lt_of_not_ge hn⟩
  · intro h
    exact hst.trans_le h

