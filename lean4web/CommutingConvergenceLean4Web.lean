  simp only [matrixTracePair, Matrix.conjTranspose_add, Matrix.conjTranspose_mul,
    hA.eq, Matrix.add_mul, Matrix.mul_add, Matrix.trace_add, Complex.add_re]
  rw [Matrix.mul_assoc Xᴴ A Y, Matrix.mul_assoc A Xᴴ Y,
    Matrix.trace_mul_comm A (Xᴴ * Y)]
  simp only [Matrix.mul_assoc]

