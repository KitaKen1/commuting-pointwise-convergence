    (heq : CFC.sqrt P * X + X * CFC.sqrt P = K) :
    gramSylvesterCost P K = (3 / 2 : ℝ) * (Matrix.trace (Kᴴ * X)).re :=
  spectralSylvesterCost_eq_of_solution _ (CFC.sqrt_nonneg P).posSemidef K X
