noncomputable def standardGaussian : Measure ℝ := gaussianReal 0 1

/-- The polynomial multiplying the standard Gaussian density in the proposed kernel. -/
noncomputable def kernelMultiplier (t : ℝ) : ℝ := 4 / 3 + t / 2 - t ^ 2 / 3

theorem gaussian_even_moment (n : ℕ) :
    (∫ x, x ^ (2 * n) ∂standardGaussian) = ((2 * n - 1 : ℕ)‼ : ℝ) := by
  simpa [standardGaussian, centralMoment, Pi.sub_apply, Pi.pow_apply]
