    (Matrix.trace (A ^ 3)).re = ∑ i, hA.eigenvalues i ^ 3 := by
  have hdiag : unitaryConj (star hA.eigenvectorUnitary) A =
      Matrix.diagonal (fun i ↦ (hA.eigenvalues i : ℂ)) :=
    hA.conjStarAlgAut_star_eigenvectorUnitary
  have h := trace_unitaryConj (star hA.eigenvectorUnitary) (A ^ 3)
  rw [map_pow, hdiag, Matrix.diagonal_pow, Matrix.trace_diagonal] at h
  have hr := congrArg Complex.re h.symm
  simpa only [Complex.re_sum, Pi.pow_apply, ← Complex.ofReal_pow, Complex.ofReal_re] using hr

