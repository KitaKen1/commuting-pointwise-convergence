        iteratedDeriv n (gaussianHeatDensity τ x) y) =
        iteratedDeriv n (gaussianHeatDensity (σ + τ) a) := funext ih
    rw [he] at h
    simpa only [iteratedDeriv_succ] using h.deriv.symm

