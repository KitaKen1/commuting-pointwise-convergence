    (hf : ∀ i ∈ s, 0 ≤ f i) (hg : ∀ i ∈ s, 0 ≤ g i) (hk : ∀ i ∈ s, 0 ≤ k i) :
    (∑ i ∈ s, f i*g i*k i) ≤
      finiteCubicRootSum s f*finiteCubicRootSum s g*finiteCubicRootSum s k := by
  have hpq : Real.HolderConjugate 3 (3/2) := by
    rw [Real.holderConjugate_iff]
    norm_num
  have hpqr : Real.HolderTriple 3 3 (3/2) := by constructor <;> norm_num
  have he := Real.inner_le_Lp_mul_Lq_of_nonneg s hpq hf (fun i hi ↦ mul_nonneg (hg i hi) (hk i hi))
  have he' := Real.Lr_rpow_le_Lp_mul_Lq_of_nonneg s hpqr hg hk
  norm_num only at he he'
  simp only [Real.rpow_ofNat] at he he'
  have hG : 0 ≤ ∑ i ∈ s, g i^3 := Finset.sum_nonneg fun i hi ↦ pow_nonneg (hg i hi) 3
  have hK : 0 ≤ ∑ i ∈ s, k i^3 := Finset.sum_nonneg fun i hi ↦ pow_nonneg (hk i hi) 3
  have he'' := Real.rpow_le_rpow
