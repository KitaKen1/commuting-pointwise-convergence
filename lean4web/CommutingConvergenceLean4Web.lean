theorem cubic_trace_diagonal_upper_bound (a : n→ℝ) (D : Matrix n n ℂ) (hD : D.IsHermitian) :
    ‖Matrix.trace ((D*realDiagonal a)^3)‖ ≤ ‖D‖*
      ((5/2:ℝ)*cubicDiagonalMass (fun i ↦ |a i|) D+
       (9/2:ℝ)*cubicUpperMass (fun i ↦ |a i|) D) := by
  let A : n→ℝ := fun i ↦ |a i|^3*‖D i i‖^2
  let E : n→ℝ := fun i ↦ |a i| *∑ j ∈ Finset.univ.filter (i < ·),(a j)^2*‖D i j‖^2
  have hsumE : (∑ i,E i)=cubicUpperMass (fun i ↦ |a i|) D := by
    simp only [E,cubicUpperMass,sq_abs,Finset.mul_sum,mul_assoc]
  rw [cubic_trace_smallest_index_cases]
  calc
    _ ≤ ∑ i,‖cubicTripleTerm a D i+cubicOnceTerm a D i+cubicTwiceTerm a D i‖ := norm_sum_le _ _
    _ ≤ ∑ i,((5/2:ℝ)*‖D‖*A i+(9/2:ℝ)*‖D‖*E i) := by
      apply Finset.sum_le_sum
      intro i _
      have hn := (norm_add_le (cubicTripleTerm a D i+cubicOnceTerm a D i)
        (cubicTwiceTerm a D i)).trans
        (add_le_add (norm_add_le (cubicTripleTerm a D i) (cubicOnceTerm a D i)) le_rfl)
      have hg := cubicTripleTerm_norm_le a D i
      have ho := cubicOnceTerm_norm_le a D hD i
      have ht := cubicTwiceTerm_norm_le a D hD i
      change ‖cubicTripleTerm a D i‖≤‖D‖*A i at hg
      change ‖cubicOnceTerm a D i‖≤3*‖D‖*E i at ho
      change ‖cubicTwiceTerm a D i‖≤(3/2:ℝ)*‖D‖*(A i+E i) at ht
      linarith
    _ = _ := by
      simp only [Finset.sum_add_distrib,←Finset.mul_sum,hsumE]
      change (5/2:ℝ)*‖D‖*cubicDiagonalMass (fun i ↦ |a i|) D+
        (9/2:ℝ)*‖D‖*cubicUpperMass (fun i ↦ |a i|) D=_
      ring


theorem ordered_cubic_trace_bound (a : n→ℝ) (D : Matrix n n ℂ)
    (ha : Antitone (fun i ↦ |a i|)) (hD : D.IsHermitian) :
    ‖Matrix.trace ((D*realDiagonal a)^3)‖ ≤ 5*‖D‖*cubicSpectralQ (fun i ↦ |a i|) D := by
  have hAE := cubicSpectralQ_ordered_lower (fun i ↦ |a i|) (fun i ↦ abs_nonneg _) ha D hD
  have hE := cubicUpperMass_nonneg (fun i ↦ |a i|) (fun i ↦ abs_nonneg _) D
