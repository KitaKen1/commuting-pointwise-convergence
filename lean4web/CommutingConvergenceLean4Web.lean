      simp only [rectangularUnitaryCoordinates, Matrix.conjTranspose_mul,
        ← Matrix.star_eq_conjTranspose, ← Unitary.coe_star, star_star, Matrix.mul_assoc]
    _ = _ := by
      rw [Unitary.mul_star_self_of_mem U.prop]
