    obtain ⟨C0, hC0, h0⟩ := gaussianHeatDensity_iteratedDeriv_bounded 0 1 0 (by norm_num)
    obtain ⟨C2, hC2, h2⟩ := gaussianHeatDensity_iteratedDeriv_bounded 2 1 0 (by norm_num)
