-- Source: CommutingConvergence.Targets
section OriginalModule273
set_option autoImplicit false
/-! Precise goals, not declarations asserting the open conjecture. -/
open MeasureTheory Filter
open scoped BigOperators Topology ENNReal

namespace CommutingConvergence

variable {X : Type*}

/-- The one-sided double Cesàro average. At `N = 0` it is zero. -/
noncomputable def doubleAverage (T S : X → X) (f g : X → ℂ) (N : ℕ) (x : X) : ℂ :=
  (N : ℂ)⁻¹ * ∑ n ∈ Finset.range N, f (T^[n] x) * g (S^[n] x)

variable [MeasurableSpace X] (μ : Measure X)

/-- Quantifiers for the original target (`p = ∞`) and the stronger claimed target (`p = 3`).
No convergence theorem is asserted by this definition. -/
def PointwiseTarget (p : ℝ≥0∞) : Prop :=
  ∀ (T S : X ≃ᵐ X), MeasurePreserving T μ μ → MeasurePreserving S μ μ →
    Function.Commute (T : X → X) (S : X → X) →
    ∀ (f g : X → ℂ), MemLp f p μ → MemLp g p μ →
      ∀ᵐ x ∂μ, ∃ L : ℂ,
        Tendsto (fun N ↦ doubleAverage T S f g N x) atTop (𝓝 L)

/-- On a finite measure space, a proof for `L³` would solve the original `L∞` target. -/
theorem bounded_target_of_l3 [IsFiniteMeasure μ]
    (h : PointwiseTarget μ 3) : PointwiseTarget μ ∞ := by
  intro T S hT hS hTS f g hf hg
  exact h T S hT hS hTS f g (hf.mono_exponent le_top) (hg.mono_exponent le_top)

omit [MeasurableSpace X] in
@[simp] theorem doubleAverage_zero (T S : X → X) (f g : X → ℂ) (x : X) :
    doubleAverage T S f g 0 x = 0 := by
  simp [doubleAverage]

omit [MeasurableSpace X] in
@[simp] theorem doubleAverage_one (T S : X → X) (f g : X → ℂ) (x : X) :
    doubleAverage T S f g 1 x = f x * g x := by
  simp [doubleAverage]

end CommutingConvergence
end OriginalModule273


