/-! Probability averaging for the square root in the matrix input M1.
The result includes singular matrices and does not require a uniform spectral gap.
We reuse mathlib's operator concavity and prove its Bochner-integral consequence. -/

open MeasureTheory Set
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator

namespace CommutingConvergence

variable {Ω A : Type*} [MeasurableSpace Ω] [CStarAlgebra A]
  [PartialOrder A] [StarOrderedRing A]

/-- Square roots of integrable positive operators are integrable on a finite measure space.
The continuous map `sqrt ∘ abs` avoids measurability difficulties at the boundary of the cone. -/
theorem integrable_operator_sqrt (μ : Measure Ω) [IsFiniteMeasure μ]
    (T : Ω → A) (hT : ∀ᵐ ω ∂μ, 0 ≤ T ω) (hTi : Integrable T μ) :
    Integrable (fun ω ↦ CFC.sqrt (T ω)) μ := by
  have hc : Continuous (fun a : A ↦ CFC.sqrt (CFC.abs a)) :=
    CFC.continuousOn_sqrt.comp_continuous CFC.continuous_abs (fun a ↦ CFC.abs_nonneg a)
  have hm : AEStronglyMeasurable (fun ω ↦ CFC.sqrt (T ω)) μ :=
    (hc.comp_aestronglyMeasurable hTi.aestronglyMeasurable).congr
      (hT.mono fun ω hω ↦ by dsimp; rw [CFC.abs_of_nonneg _ hω])
  refine (hTi.norm.add (integrable_const (1 : ℝ))).mono' hm ?_
  filter_upwards [hT] with ω hω
  rw [CFC.norm_sqrt _ hω]
  change Real.sqrt ‖T ω‖ ≤ ‖T ω‖ + 1
  apply (Real.sqrt_le_left (by positivity)).mpr
  nlinarith [norm_nonneg (T ω), sq_nonneg ‖T ω‖]

/-- The hypograph of the operator square root on the positive cone is closed.
This permits vector-valued Jensen without reducing to an eigenbasis depending on the point. -/
theorem isClosed_sqrt_hypograph :
    IsClosed {p : A × A | 0 ≤ p.1 ∧ p.2 ≤ CFC.sqrt p.1} := by
  apply (isClosed_le continuous_const continuous_fst).isClosed_le
  · exact continuous_snd.continuousOn
  · exact CFC.continuousOn_sqrt.comp continuous_fst.continuousOn (fun _ h ↦ h)

/-- Operator Jensen for a probability integral. Both integrability hypotheses are explicit;
there is no invertibility or fixed-rank hypothesis. -/
theorem integral_sqrt_le_sqrt_integral (μ : Measure Ω) [IsProbabilityMeasure μ]
    (T : Ω → A) (hT : ∀ᵐ ω ∂μ, 0 ≤ T ω)
    (hTi : Integrable T μ) (hSi : Integrable (fun ω ↦ CFC.sqrt (T ω)) μ) :
    (∫ ω, CFC.sqrt (T ω) ∂μ) ≤ CFC.sqrt (∫ ω, T ω ∂μ) := by
  have h := CFC.concaveOn_sqrt.convex_hypograph.integral_mem
    (isClosed_sqrt_hypograph (A := A))
    (hT.mono fun ω hω ↦ show (T ω, CFC.sqrt (T ω)) ∈
      {p : A × A | p.1 ∈ Ici 0 ∧ p.2 ≤ CFC.sqrt p.1} from ⟨hω, le_rfl⟩)
