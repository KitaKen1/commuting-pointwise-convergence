    matrixTracePair K (X + Y) = matrixTracePair K X + matrixTracePair K Y := by
  simp [matrixTracePair, Matrix.mul_add]

theorem matrixTracePair_sub_left (K L X : Matrix n n ℂ) :
    matrixTracePair (K - L) X = matrixTracePair K X - matrixTracePair L X := by
  simp [matrixTracePair, Matrix.sub_mul]

theorem matrixTracePair_sub_right (K X Y : Matrix n n ℂ) :
    matrixTracePair K (X - Y) = matrixTracePair K X - matrixTracePair K Y := by
  simp [matrixTracePair, Matrix.mul_sub]

theorem matrixTracePair_smul_left (c : ℝ) (K X : Matrix n n ℂ) :
    matrixTracePair (c • K) X = c * matrixTracePair K X := by
  simp [matrixTracePair]

theorem matrixTracePair_smul_right (c : ℝ) (K X : Matrix n n ℂ) :
    matrixTracePair K (c • X) = c * matrixTracePair K X := by
  simp [matrixTracePair]

