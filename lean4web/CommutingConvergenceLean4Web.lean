    (∫ x, x ^ 0 * kernelMultiplier x ∂standardGaussian) = 1 ∧
    (∫ x, x ^ 1 * kernelMultiplier x ∂standardGaussian) = 1 / 2 ∧
    (∫ x, x ^ 2 * kernelMultiplier x ∂standardGaussian) = 1 / 3 := by
  have h0 := gaussian_even_moment 0
  have h1 := gaussian_odd_moment 0
