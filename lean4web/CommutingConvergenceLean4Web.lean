/-! Normalize columns of a rectangular matrix with diagonal Gram. Zero columns remain zero.
The resulting contraction supplies the compressed insertion without a full SVD construction. -/

open Matrix
open scoped ComplexOrder Matrix.Norms.L2Operator

namespace CommutingConvergence

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

noncomputable def normalizedGramColumns (B : Matrix m n ℂ) (a : n → ℝ) : Matrix m n ℂ :=
  B * Matrix.diagonal (fun i ↦ (((a i)⁻¹ : ℝ) : ℂ))

omit [DecidableEq m] in
/-- The normalized Gram is the orthogonal projection onto the nonzero columns. -/
theorem normalizedGramColumns_gram (B : Matrix m n ℂ) (a : n → ℝ)
    (hgram : Bᴴ * B = Matrix.diagonal (fun i ↦ (a i : ℂ) ^ 2)) :
    (normalizedGramColumns B a)ᴴ * normalizedGramColumns B a =
      Matrix.diagonal (fun i ↦ if a i = 0 then (0 : ℂ) else 1) := by
  classical
  have hD : (Matrix.diagonal (fun i ↦ (((a i)⁻¹ : ℝ) : ℂ))).IsHermitian :=
    Matrix.isHermitian_diagonal_iff.mpr fun i ↦ by simp [IsSelfAdjoint]
  unfold normalizedGramColumns
  rw [Matrix.conjTranspose_mul, hD.eq, Matrix.mul_assoc,
    ← Matrix.mul_assoc Bᴴ B, hgram, ← Matrix.mul_assoc,
    Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
  congr 1
  funext i
  by_cases hi : a i = 0
  · simp [hi]
  · have hic : (a i : ℂ) ≠ 0 := by exact_mod_cast hi
    simp [hi, Complex.ofReal_inv, hic, pow_two]

omit [DecidableEq m] in
/-- No positive lower bound on the nonzero column lengths is required. -/
theorem normalizedGramColumns_norm_le_one (B : Matrix m n ℂ) (a : n → ℝ)
    (hgram : Bᴴ * B = Matrix.diagonal (fun i ↦ (a i : ℂ) ^ 2)) :
    ‖normalizedGramColumns B a‖ ≤ 1 := by
  have hp : ‖(normalizedGramColumns B a)ᴴ * normalizedGramColumns B a‖ ≤ 1 := by
    rw [normalizedGramColumns_gram B a hgram, Matrix.l2_opNorm_diagonal]
    apply (pi_norm_le_iff_of_nonneg (by norm_num : (0 : ℝ) ≤ 1)).mpr
    intro i
    split_ifs <;> simp
  rw [Matrix.l2_opNorm_conjTranspose_mul_self] at hp
  nlinarith [norm_nonneg (normalizedGramColumns B a)]

omit [DecidableEq m] in
/-- Multiplying the normalized columns by their lengths recovers the original matrix. -/
theorem normalizedGramColumns_reconstruct (B : Matrix m n ℂ) (a : n → ℝ)
    (hgram : Bᴴ * B = Matrix.diagonal (fun i ↦ (a i : ℂ) ^ 2)) :
    normalizedGramColumns B a * Matrix.diagonal (fun i ↦ (a i : ℂ)) = B := by
  ext i j
  simp only [normalizedGramColumns, Matrix.mul_diagonal]
  by_cases hj : a j = 0
  · have hzero : (Bᴴ * B) *ᵥ Pi.single j 1 = 0 := by rw [hgram]; simp [hj]
    have hz : B *ᵥ Pi.single j 1 = 0 :=
      (Matrix.conjTranspose_mul_self_mulVec_eq_zero B (Pi.single j 1)).mp hzero
    have he := congrFun hz i
    have hb : B i j = 0 := by simpa using he
    simp [hj, hb]
  · have hjc : (a j : ℂ) ≠ 0 := by exact_mod_cast hj
    simp [Complex.ofReal_inv, hjc]

/-- Compression by a rectangular contraction cannot increase the insertion norm. -/
theorem rectangular_compression_norm_le (U : Matrix m n ℂ) (hU : ‖U‖ ≤ 1)
    (L : Matrix m m ℂ) : ‖Uᴴ * L * U‖ ≤ ‖L‖ := by
  calc
    _ ≤ (‖U‖ * ‖L‖) * ‖U‖ := by
      calc
        _ ≤ ‖Uᴴ * L‖ * ‖U‖ := Matrix.l2_opNorm_mul _ _
        _ ≤ (‖Uᴴ‖ * ‖L‖) * ‖U‖ :=
          mul_le_mul_of_nonneg_right (Matrix.l2_opNorm_mul _ _) (norm_nonneg _)
        _ = _ := by rw [Matrix.l2_opNorm_conjTranspose]
    _ ≤ (1 * ‖L‖) * 1 := by gcongr
    _ = _ := by ring

/-- The 3/4 inequality for any rectangular matrix whose Gram is diagonal. -/
theorem diagonal_gram_insertion_bound (B : Matrix m n ℂ) (a : n → ℝ)
    (ha : ∀ i, 0 ≤ a i) (hgram : Bᴴ * B = Matrix.diagonal (fun i ↦ (a i : ℂ) ^ 2))
    (L : Matrix m m ℂ) :
    diagonalHessianCost a (Bᴴ * L * B) ≤ (3 / 4 : ℝ) * ‖L‖ ^ 2 * ∑ i, a i ^ 3 := by
  let U := normalizedGramColumns B a
  let D := Matrix.diagonal (fun i ↦ (a i : ℂ))
  have hD : D.IsHermitian := Matrix.isHermitian_diagonal_iff.mpr fun i ↦ by
    simp [IsSelfAdjoint]
  have hB : U * D = B := normalizedGramColumns_reconstruct B a hgram
  have hnorm : ‖Uᴴ * L * U‖ ≤ ‖L‖ :=
    rectangular_compression_norm_le U (normalizedGramColumns_norm_le_one B a hgram) L
  have he : Bᴴ * L * B = D * (Uᴴ * L * U) * D := by
    calc
      _ = (U * D)ᴴ * L * (U * D) := congrArg (fun Q ↦ Qᴴ * L * Q) hB.symm
      _ = _ := by rw [Matrix.conjTranspose_mul, hD.eq]; simp only [Matrix.mul_assoc]
  rw [he]
  calc
    _ ≤ (3 / 4 : ℝ) * ‖Uᴴ * L * U‖ ^ 2 * ∑ i, a i ^ 3 := diagonal_insertion_bound a ha _
    _ ≤ _ := by
      have hs : 0 ≤ ∑ i, a i ^ 3 := Finset.sum_nonneg fun i _ ↦ pow_nonneg (ha i) _
      gcongr

end CommutingConvergence
end OriginalModule55


