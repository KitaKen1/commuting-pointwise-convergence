  simp only [integerOrbit, zpow_natCast, Equiv.Perm.coe_pow, MeasurableEquiv.coe_toEquiv]

theorem measurable_integerOrbit (T : X ≃ᵐ X) (n : ℤ) : Measurable (integerOrbit T n) := by
  cases n with
  | ofNat n => simpa only [Int.ofNat_eq_natCast, integerOrbit_natCast] using T.measurable.iterate n
  | negSucc n =>
    simp only [integerOrbit, zpow_negSucc, ← inv_pow, Equiv.Perm.coe_pow]
    change Measurable (T.symm^[n+1])
    exact T.symm.measurable.iterate (n+1)

theorem measurable_integerOrbit_joint (T : X ≃ᵐ X) :
    Measurable (fun p : ℤ × X ↦ integerOrbit T p.1 p.2) :=
  measurable_from_prod_countable_right (measurable_integerOrbit T)

theorem measurePreserving_integerOrbit (T : X ≃ᵐ X) (μ : Measure X)
    (hT : MeasurePreserving T μ μ) (n : ℤ) : MeasurePreserving (integerOrbit T n) μ μ := by
  cases n with
  | ofNat n => simpa only [Int.ofNat_eq_natCast, integerOrbit_natCast] using hT.iterate n
  | negSucc n =>
    simp only [integerOrbit, zpow_negSucc, ← inv_pow, Equiv.Perm.coe_pow]
    change MeasurePreserving (T.symm^[n+1]) μ μ
    exact (hT.symm T).iterate (n+1)

theorem integerOrbit_commute (T S : X ≃ᵐ X)
    (h : Function.Commute (T : X → X) (S : X → X)) (m n : ℤ) :
    Function.Commute (integerOrbit T m) (integerOrbit S n) := by
  have hc : Commute T.toEquiv S.toEquiv := Equiv.ext h
  intro x
  exact congrArg (fun e : Equiv.Perm X ↦ e x) (hc.zpow_zpow m n).eq

