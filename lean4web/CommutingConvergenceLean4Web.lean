theorem matrix_sqrt_add_projection (P E : Matrix n n ℂ)
    (hP : P.PosSemidef) (hE : E.PosSemidef) (hEE : E * E = E) (hPE : P * E = 0) :
    CFC.sqrt (P + E) = CFC.sqrt P + E := by
  obtain ⟨hAE, hEA⟩ := matrix_sqrt_annihilate P E hP hE.isHermitian hPE
  apply (CFC.sqrt_eq_iff _ _ (add_nonneg hP.nonneg hE.nonneg)
    (add_nonneg (CFC.sqrt_nonneg P) hE.nonneg)).mpr
  simp only [Matrix.add_mul, Matrix.mul_add, hAE, hEA, hEE,
    CFC.sqrt_mul_sqrt_self P hP.nonneg, add_zero, zero_add]

theorem matrix_cube_add_projection (A E : Matrix n n ℂ)
    (hEE : E * E = E) (hAE : A * E = 0) (hEA : E * A = 0) :
    (A + E) ^ 3 = A ^ 3 + E := by
  have h2 : (A + E) ^ 2 = A ^ 2 + E := by
    simp only [pow_two, Matrix.add_mul, Matrix.mul_add, hAE, hEA, hEE, add_zero, zero_add]
  have hAE2 : A ^ 2 * E = 0 := by rw [pow_two, Matrix.mul_assoc, hAE, Matrix.mul_zero]
  rw [show 3 = 2 + 1 from rfl, pow_succ, h2]
