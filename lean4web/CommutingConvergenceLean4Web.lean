open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator Topology

namespace CommutingConvergence

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

noncomputable section

@[instance_reducible] local instance : AddCommGroup (Matrix n n ℂ) :=
  (inferInstance : NormedAddCommGroup (Matrix n n ℂ)).toAddCommGroup
@[instance_reducible] local instance : Module ℝ (Matrix n n ℂ) :=
  (inferInstance : NormedSpace ℝ (Matrix n n ℂ)).toModule
@[instance_reducible] local instance : TopologicalSpace (Matrix n n ℂ) :=
  (inferInstance : MetricSpace (Matrix n n ℂ)).toPseudoMetricSpace.toUniformSpace.toTopologicalSpace

/-- The column Gram of a fixed rectangular matrix with time-dependent row weights. -/
def rowScaleGram (R : Matrix m n ℂ) (d : ℝ → m → ℂ) (t : ℝ) : Matrix n n ℂ :=
  (Matrix.diagonal (d t) * R)ᴴ * (Matrix.diagonal (d t) * R)

