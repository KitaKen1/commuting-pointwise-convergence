  have hxQ : Q *ᵥ (x ∘ Sum.inr) = 0 := by
    funext i
    simpa [Matrix.fromBlocks_mulVec, Function.comp_def] using congrFun hx (Sum.inr i)
  obtain ⟨hAx, hAx'⟩ := hA _ hxP
