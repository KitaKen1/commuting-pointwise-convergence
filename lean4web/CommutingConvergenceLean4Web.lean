    ∫ u, gaussianHeatDensity σ u p = 1 := by
  exact integral_gaussianPDFReal_eq_one p (v := ⟨σ, hσ.le⟩) (by
    intro h
    have he : σ = 0 := congrArg (fun x : NNReal ↦ (x : ℝ)) h
    linarith)

