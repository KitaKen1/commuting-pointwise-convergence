open Matrix Unitary
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator
namespace CommutingConvergence
noncomputable section
variable {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]
  [DecidableEq m] [DecidableEq n] [DecidableEq p]

theorem complex_unit_phase_exists (w : ℂ) : ∃ z : ℂ, ‖z‖ = 1 ∧ z*w = (‖w‖:ℂ) := by
  by_cases hw : w=0
  · exact ⟨1,by simp,by simp [hw]⟩
  · refine ⟨(‖w‖:ℂ)/w,?_,div_mul_cancel₀ _ hw⟩
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _),
      div_self (norm_ne_zero_iff.mpr hw)]

theorem complex_conj_mul_of_unit_norm (z : ℂ) (hz : ‖z‖=1) : star z*z=1 := by
  rw [Complex.star_def, ←Complex.normSq_eq_conj_mul_self, Complex.normSq_eq_norm_sq, hz]
  norm_num

def phaseDiagonalUnitary {q : Type*} [Fintype q] [DecidableEq q]
    (a : q → ℂ) (ha : ∀ i, ‖a i‖=1) : Matrix.unitaryGroup q ℂ :=
  ⟨Matrix.diagonal a, Matrix.mem_unitaryGroup_iff'.mpr (by
    rw [Matrix.star_eq_conjTranspose, Matrix.diagonal_conjTranspose, Matrix.diagonal_mul_diagonal]
    convert (Matrix.diagonal_one : Matrix.diagonal (fun _ : q ↦ (1:ℂ)) = 1) using 1
    congr 1
    funext i
    exact complex_conj_mul_of_unit_norm (a i) (ha i))⟩

def leftPhaseUnitary (z : ℂ) (hz : ‖z‖=1) : Matrix.unitaryGroup (n⊕p) ℂ :=
  phaseDiagonalUnitary (Sum.elim (fun _ ↦ z) (fun _ ↦ 1)) (by intro i; cases i <;> simp [hz])

def rightPhaseUnitary (z : ℂ) (hz : ‖z‖=1) : Matrix.unitaryGroup (n⊕p) ℂ :=
  phaseDiagonalUnitary (Sum.elim (fun _ ↦ 1) (fun _ ↦ z)) (by intro i; cases i <;> simp [hz])

omit [Fintype m] [DecidableEq m] in
theorem fromCols_left_phase (A : Matrix m n ℂ) (B : Matrix m p ℂ)
    (z : ℂ) (hz : ‖z‖=1) :
    Matrix.fromCols (z•A) B = Matrix.fromCols A B * (leftPhaseUnitary (n:=n) (p:=p) z hz : Matrix (n⊕p) (n⊕p) ℂ) := by
  ext i j
  cases j <;> simp [leftPhaseUnitary,phaseDiagonalUnitary,Matrix.mul_diagonal,
    Matrix.fromCols,Matrix.smul_apply,smul_eq_mul,mul_comm]

omit [Fintype m] [DecidableEq m] in
theorem fromCols_right_phase (A : Matrix m n ℂ) (B : Matrix m p ℂ)
    (z : ℂ) (hz : ‖z‖=1) :
    Matrix.fromCols A (z•B) = Matrix.fromCols A B * (rightPhaseUnitary (n:=n) (p:=p) z hz : Matrix (n⊕p) (n⊕p) ℂ) := by
  ext i j
  cases j <;> simp [rightPhaseUnitary,phaseDiagonalUnitary,Matrix.mul_diagonal,
    Matrix.fromCols,Matrix.smul_apply,smul_eq_mul,mul_comm]

def rowInsertionCost {q : Type*} [Fintype q] [DecidableEq q]
    (R : Matrix m q ℂ) (D : Matrix m m ℂ) : ℝ := gramSylvesterCost (Rᴴ*R) (Rᴴ*D*R)

omit [DecidableEq m] in
theorem rowInsertionCost_right_unitary {q : Type*} [Fintype q] [DecidableEq q]
    (R : Matrix m q ℂ) (D : Matrix m m ℂ) (U : Matrix.unitaryGroup q ℂ) :
    rowInsertionCost (R*(U:Matrix q q ℂ)) D = rowInsertionCost R D :=
  gramSylvesterCost_right_unitary R D U

def cyclicStarCost (A : Matrix m n ℂ) (B : Matrix n p ℂ) (C : Matrix p m ℂ)
    (D₀ : Matrix m m ℂ) (D₁ : Matrix n n ℂ) (D₂ : Matrix p p ℂ) : ℝ :=
  rowInsertionCost (Matrix.fromCols A Cᴴ) D₀ +
    rowInsertionCost (Matrix.fromCols B Aᴴ) D₁ +
    rowInsertionCost (Matrix.fromCols C Bᴴ) D₂

theorem cyclicStarCost_phase (A : Matrix m n ℂ) (B : Matrix n p ℂ) (C : Matrix p m ℂ)
    (D₀ : Matrix m m ℂ) (D₁ : Matrix n n ℂ) (D₂ : Matrix p p ℂ)
    (z : ℂ) (hz : ‖z‖=1) :
    cyclicStarCost (z•A) B C D₀ D₁ D₂ = cyclicStarCost A B C D₀ D₁ D₂ := by
  unfold cyclicStarCost
  rw [fromCols_left_phase A Cᴴ z hz, rowInsertionCost_right_unitary]
  have hstar : (z•A)ᴴ = star z • Aᴴ := by
    simp [Matrix.conjTranspose_smul]
  rw [hstar, fromCols_right_phase B Aᴴ (star z) (by simpa using hz), rowInsertionCost_right_unitary]

