/-! Abel summation transports prefix bounds to decreasing nonnegative weights.
This prepares the Gaussian radial-shell comparison without a dyadic tail expansion. -/

namespace CommutingConvergence

theorem finite_decreasing_weight_comparison (q g w : ℕ → ℝ) (K : ℝ) (N : ℕ)
    (hw : ∀ i, 0 ≤ w i) (hanti : Antitone w)
    (hp : ∀ n ≤ N, (∑ i ∈ Finset.range n, q i) ≤ K*∑ i ∈ Finset.range n, g i) :
    (∑ i ∈ Finset.range N, w i*q i) ≤ K*∑ i ∈ Finset.range N, w i*g i := by
  let d := fun i ↦ q i-K*g i
  have hd (n : ℕ) (hn : n ≤ N) : (∑ i ∈ Finset.range n, d i) ≤ 0 := by
    dsimp only [d]
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
    exact sub_nonpos.2 (hp n hn)
  have hlast : w (N-1)*(∑ i ∈ Finset.range N, d i) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (hw _) (hd N le_rfl)
  have hsum : 0 ≤ ∑ i ∈ Finset.range (N-1),
      (w (i+1)-w i)*(∑ k ∈ Finset.range (i+1), d k) := by
    apply Finset.sum_nonneg
    intro i hi
    apply mul_nonneg_of_nonpos_of_nonpos
    · exact sub_nonpos.2 (hanti (by omega))
    · exact hd (i+1) (by have := Finset.mem_range.1 hi; omega)
  have he := Finset.sum_range_by_parts w d N
  simp only [smul_eq_mul] at he
  have hb : (∑ i ∈ Finset.range N, w i*d i) ≤ 0 := by rw [he]; linarith
  dsimp only [d] at hb
  simp only [mul_sub, mul_left_comm (w _) K, Finset.sum_sub_distrib,
    ← Finset.mul_sum] at hb
  exact sub_nonpos.1 hb

theorem finite_decreasing_weight_prefix_bound (q w : ℕ → ℝ) (K : ℝ) (N : ℕ)
    (hw : ∀ i, 0 ≤ w i) (hanti : Antitone w)
    (hp : ∀ n ≤ N, (∑ i ∈ Finset.range n, q i) ≤ K*(n : ℝ)) :
    (∑ i ∈ Finset.range N, w i*q i) ≤ K*∑ i ∈ Finset.range N, w i := by
  simpa using finite_decreasing_weight_comparison q (fun _ ↦ 1) w K N hw hanti
    (fun n hn ↦ by simpa using hp n hn)

theorem gaussian_integer_radial_weights_antitone (h σ : ℝ) (hh : 0 ≤ h) (hσ : 0 < σ) :
    Antitone (fun N : ℕ ↦ h*gaussianHeatDensity σ (h*N) 0) := by
