    (√(2 * π * v))⁻¹ *
        ((2 * v)⁻¹ ^ (-((n : ℝ) + 1) / 2) * Gamma (((n : ℝ) + 1) / 2)) =
      (2 * v) ^ ((n : ℝ) / 2) * Gamma (((n : ℝ) + 1) / 2) / √π := by
  have hv₂ : 0 < 2 * v := mul_pos two_pos hv
  have hradicand : 2 * π * v = π * (2 * v) := by ring
