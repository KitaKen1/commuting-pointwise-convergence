-- Source: CommutingConvergence.PlaneRectangleAlgebra
section OriginalModule1
set_option autoImplicit false
/-! Finite Boolean combinations of half-open plane rectangles generate the Borel
sigma algebra. Any measurable set admits actual approximation in any finite measure.
Unbounded strips and the whole plane are permitted; bounded inputs localize them later. -/
open MeasureTheory MeasurableSpace Set
open scoped ENNReal symmDiff
namespace CommutingConvergence
noncomputable section

def realIntervalGenerators : Set (Set ℝ) :=
  {s | s = univ ∨ ∃ a b : ℝ, a ≤ b ∧ Ioc a b = s}

def planeRectangleGenerators : Set (Set (ℝ × ℝ)) :=
  image2 (· ×ˢ ·) realIntervalGenerators realIntervalGenerators

def planeRectangleAlgebra : Set (Set (ℝ × ℝ)) :=
  generateSetAlgebra planeRectangleGenerators

theorem realIntervalGenerators_measurable {s : Set ℝ} (hs : s ∈ realIntervalGenerators) :
    MeasurableSet s := by
  rcases hs with rfl | ⟨a, b, _, rfl⟩
  · exact MeasurableSet.univ
  · exact measurableSet_Ioc

theorem realIntervalGenerators_generateFrom :
    generateFrom realIntervalGenerators = (inferInstance : MeasurableSpace ℝ) := by
  apply le_antisymm
  · exact generateFrom_le fun _ hs ↦ realIntervalGenerators_measurable hs
  · change borel ℝ ≤ generateFrom realIntervalGenerators
    rw [borel_eq_generateFrom_Ioc_le]
    apply generateFrom_mono
    intro s hs
    exact Or.inr hs

theorem planeRectangleAlgebra_measurable {s : Set (ℝ × ℝ)}
    (hs : s ∈ planeRectangleAlgebra) : MeasurableSet s := by
  induction hs with
  | base s hs =>
    rcases hs with ⟨u, hu, v, hv, rfl⟩
    exact (realIntervalGenerators_measurable hu).prod (realIntervalGenerators_measurable hv)
  | empty => exact MeasurableSet.empty
  | compl s _ ih => exact ih.compl
  | union s t _ _ ihs iht => exact ihs.union iht

theorem planeRectangleAlgebra_generateFrom :
    generateFrom planeRectangleAlgebra = (inferInstance : MeasurableSpace (ℝ × ℝ)) := by
  have hc : IsCountablySpanning realIntervalGenerators :=
    ⟨fun _ ↦ univ, fun _ ↦ Or.inl rfl, iUnion_const _⟩
  change generateFrom (generateSetAlgebra planeRectangleGenerators) = _
  rw [generateFrom_generateSetAlgebra_eq]
  exact generateFrom_eq_prod realIntervalGenerators_generateFrom
    realIntervalGenerators_generateFrom hc hc

theorem plane_measurableSet_exists_rectangle_algebra_approx
    (μ : Measure (ℝ × ℝ)) [IsFiniteMeasure μ] (s : Set (ℝ × ℝ))
    (hs : MeasurableSet s) (ε : ℝ≥0∞) (hε : 0 < ε) :
    ∃ t ∈ planeRectangleAlgebra, μ (t ∆ s) < ε := by
  have ha : IsSetAlgebra planeRectangleAlgebra := isSetAlgebra_generateSetAlgebra
  refine exists_measure_symmDiff_lt_of_generateFrom_isSetRing ha.isSetRing
    (μ := μ) ?_ planeRectangleAlgebra_generateFrom.symm hs hε
  refine ⟨{univ}, countable_singleton _, ?_, ?_⟩
  · simpa using ha.univ_mem
  · simp

end
end CommutingConvergence
end OriginalModule1


-- Source: CommutingConvergence.IntegerStepFunction
section OriginalModule2
set_option autoImplicit false
/-! Integer sequences as functions constant on disjoint unit cells.
The integral/series correspondence is exact, including infinite values. -/

open MeasureTheory Set
open scoped ENNReal
namespace CommutingConvergence
noncomputable section

def integerUnitCell (j : ℤ) : Set ℝ := Ico (j : ℝ) ((j : ℝ)+1)

def integerStep (f : ℤ → ℝ≥0∞) (x : ℝ) : ℝ≥0∞ := f ⌊x⌋

theorem integerUnitCell_measurable (j : ℤ) : MeasurableSet (integerUnitCell j) :=
  measurableSet_Ico

theorem integerUnitCell_mem_iff_floor (j : ℤ) (x : ℝ) :
    x ∈ integerUnitCell j ↔ ⌊x⌋ = j := by
  exact Int.floor_eq_iff.symm

theorem integerUnitCell_volume (j : ℤ) : volume (integerUnitCell j) = 1 := by
  simp [integerUnitCell, Real.volume_Ico]

theorem integerUnitCell_iUnion : (⋃ j : ℤ, integerUnitCell j) = univ := by
  apply Set.eq_univ_of_forall
  intro x
  exact mem_iUnion.2 ⟨⌊x⌋, (integerUnitCell_mem_iff_floor _ _).2 rfl⟩

theorem integerUnitCell_pairwise_disjoint : Pairwise (fun i j ↦
    Disjoint (integerUnitCell i) (integerUnitCell j)) := by
  intro i j hij
  apply Set.disjoint_left.2
  intro x hi hj
  exact hij ((integerUnitCell_mem_iff_floor i x).1 hi |>.symm.trans
    ((integerUnitCell_mem_iff_floor j x).1 hj))

theorem integerStep_measurable (f : ℤ → ℝ≥0∞) : Measurable (integerStep f) := by
  exact (measurable_of_countable f).comp Int.measurable_floor

theorem integerStep_eq_on_cell (f : ℤ → ℝ≥0∞) (j : ℤ) {x : ℝ}
    (hx : x ∈ integerUnitCell j) : integerStep f x = f j := by
  unfold integerStep
  rw [(integerUnitCell_mem_iff_floor j x).1 hx]

theorem integerStep_lintegral_cell (f : ℤ → ℝ≥0∞) (j : ℤ) :
    ∫⁻ x in integerUnitCell j, integerStep f x = f j := by
  rw [setLIntegral_congr_fun (integerUnitCell_measurable j)
    (fun x hx ↦ integerStep_eq_on_cell f j hx), setLIntegral_const, integerUnitCell_volume,
    mul_one]

theorem integerStep_lintegral (f : ℤ → ℝ≥0∞) :
    ∫⁻ x, integerStep f x = ∑' j, f j := by
  calc _ = ∫⁻ x in ⋃ j : ℤ, integerUnitCell j, integerStep f x := by
         rw [integerUnitCell_iUnion, Measure.restrict_univ]
       _ = ∑' j, ∫⁻ x in integerUnitCell j, integerStep f x :=
         lintegral_iUnion integerUnitCell_measurable integerUnitCell_pairwise_disjoint _
       _ = ∑' j, f j := tsum_congr (integerStep_lintegral_cell f)

theorem integerStep_lintegral_rpow (f : ℤ → ℝ≥0∞) (p : ℝ) :
    ∫⁻ x, integerStep f x ^ p = ∑' j, f j ^ p := by
  exact integerStep_lintegral (fun j ↦ f j ^ p)

theorem integerStep_lintegral_finite_cells (f : ℤ → ℝ≥0∞) (s : Finset ℤ) :
    ∫⁻ x in ⋃ j ∈ s, integerUnitCell j, integerStep f x = ∑ j ∈ s, f j := by
  rw [lintegral_biUnion_finset (fun i _ j _ hij ↦ integerUnitCell_pairwise_disjoint hij)
    (fun j _ ↦ integerUnitCell_measurable j)]
  exact Finset.sum_congr rfl (fun j _ ↦ integerStep_lintegral_cell f j)

end
end CommutingConvergence
end OriginalModule2


-- Source: CommutingConvergence.LatticeCellGeometry
section OriginalModule3
set_option autoImplicit false
/-! Disjoint scaled lattice cells with their exact plane volume. -/
open MeasureTheory Set
namespace CommutingConvergence
noncomputable section

def latticeRealCell (h : ℝ) (i : ℤ) : Set ℝ := Ico (h*(i:ℝ)) (h*((i:ℝ)+1))

def latticePlaneCell (h : ℝ) (q : ℤ × ℤ) : Set (ℝ × ℝ) :=
  latticeRealCell h q.1 ×ˢ latticeRealCell h q.2

theorem latticeRealCell_measurable (h : ℝ) (i : ℤ) : MeasurableSet (latticeRealCell h i) :=
  measurableSet_Ico

theorem latticeRealCell_mem_iff_floor (h : ℝ) (hh : 0 < h) (i : ℤ) (x : ℝ) :
    x ∈ latticeRealCell h i ↔ ⌊x/h⌋ = i := by
  rw [Int.floor_eq_iff]
  change h*(i:ℝ) ≤ x ∧ x < h*((i:ℝ)+1) ↔ (i:ℝ) ≤ x/h ∧ x/h < (i:ℝ)+1
  constructor
  · intro hx
    exact ⟨(le_div_iff₀ hh).mpr (by simpa [mul_comm] using hx.1),
      (div_lt_iff₀ hh).mpr (by simpa [mul_comm] using hx.2)⟩
  · intro hx
    exact ⟨by simpa [mul_comm] using (le_div_iff₀ hh).mp hx.1,
      by simpa [mul_comm] using (div_lt_iff₀ hh).mp hx.2⟩

theorem latticeRealCell_volume (h : ℝ) (i : ℤ) :
    volume (latticeRealCell h i) = ENNReal.ofReal h := by
  rw [latticeRealCell, Real.volume_Ico]
  congr 1
  ring

theorem latticePlaneCell_measurable (h : ℝ) (q : ℤ × ℤ) : MeasurableSet (latticePlaneCell h q) :=
  (latticeRealCell_measurable h q.1).prod (latticeRealCell_measurable h q.2)

theorem latticePlaneCell_mem_iff_floor (h : ℝ) (hh : 0 < h) (q : ℤ × ℤ) (x : ℝ × ℝ) :
    x ∈ latticePlaneCell h q ↔ (⌊x.1/h⌋, ⌊x.2/h⌋) = q := by
  rcases q with ⟨i,j⟩
  simp only [latticePlaneCell, mem_prod, latticeRealCell_mem_iff_floor h hh,
    Prod.mk.injEq]

theorem latticePlaneCell_volume (h : ℝ) (hh : 0 ≤ h) (q : ℤ × ℤ) :
    volume (latticePlaneCell h q) = ENNReal.ofReal (h^2) := by
  rw [latticePlaneCell, MeasureTheory.Measure.volume_eq_prod,
    MeasureTheory.Measure.prod_prod, latticeRealCell_volume, latticeRealCell_volume,
    ← ENNReal.ofReal_mul hh]
  congr 1
  ring

theorem latticePlaneCell_pairwise_disjoint (h : ℝ) (hh : 0 < h) :
    Pairwise (fun q r : ℤ × ℤ ↦ Disjoint (latticePlaneCell h q) (latticePlaneCell h r)) := by
  intro q r hqr
  apply Set.disjoint_left.mpr
  intro x hxq hxr
  exact hqr (((latticePlaneCell_mem_iff_floor h hh q x).mp hxq).symm.trans
    ((latticePlaneCell_mem_iff_floor h hh r x).mp hxr))

end
end CommutingConvergence
end OriginalModule3


-- Source: CommutingConvergence.GaussianDensityCalculus
section OriginalModule4
set_option autoImplicit false
/-! Actual center and positive-variance derivatives of the normalized Gaussian.
The variance is a real variable so its ordinary derivative is available; the
normalization agrees exactly with mathlib's real Gaussian density. -/

open Filter Set ProbabilityTheory
open scoped Topology

namespace CommutingConvergence

noncomputable section

noncomputable def gaussianHeatDensity (σ u p : ℝ) : ℝ :=
  (Real.sqrt (2 * Real.pi * σ))⁻¹ * Real.exp (-(u - p) ^ 2 / (2 * σ))

def gaussianHeatScore (σ u p : ℝ) : ℝ := (u - p) / σ

def gaussianHeatAcceleration (σ u p : ℝ) : ℝ :=
  gaussianHeatScore σ u p ^ 2 - σ⁻¹

theorem gaussianHeatDensity_eq_gaussianPDFReal (σ : NNReal) (u p : ℝ) :
    gaussianHeatDensity σ u p = gaussianPDFReal p σ u := rfl

theorem gaussianHeatDensity_pos (σ u p : ℝ) (hσ : 0 < σ) :
    0 < gaussianHeatDensity σ u p := by
  unfold gaussianHeatDensity
  positivity

theorem gaussianHeatDensity_nonneg (σ u p : ℝ) :
    0 ≤ gaussianHeatDensity σ u p := by
  unfold gaussianHeatDensity
  positivity

theorem gaussianHeatDensity_center_hasDerivAt (σ u p : ℝ) :
    HasDerivAt (gaussianHeatDensity σ u)
      (gaussianHeatScore σ u p * gaussianHeatDensity σ u p) p := by
  have h := (((((hasDerivAt_const p u).sub (hasDerivAt_id p)).pow 2).neg.div_const
    (2 * σ)).exp).const_mul (Real.sqrt (2 * Real.pi * σ))⁻¹
  convert! h using 1
  dsimp [gaussianHeatDensity, gaussianHeatScore]
  norm_num
  ring

theorem gaussianHeatDensity_center_deriv (σ u p : ℝ) :
    deriv (gaussianHeatDensity σ u) p =
      gaussianHeatScore σ u p * gaussianHeatDensity σ u p :=
  (gaussianHeatDensity_center_hasDerivAt σ u p).deriv

theorem gaussianHeatScore_center_hasDerivAt (σ u p : ℝ) :
    HasDerivAt (gaussianHeatScore σ u) (-σ⁻¹) p := by
  convert! ((hasDerivAt_const p u).sub (hasDerivAt_id p)).div_const σ using 1
  ring

theorem gaussianHeatDensity_center_deriv_hasDerivAt (σ u p : ℝ) :
    HasDerivAt (deriv (gaussianHeatDensity σ u))
      (gaussianHeatAcceleration σ u p * gaussianHeatDensity σ u p) p := by
  have h := (gaussianHeatScore_center_hasDerivAt σ u p).mul
    (gaussianHeatDensity_center_hasDerivAt σ u p)
  have he : deriv (gaussianHeatDensity σ u) =
      fun q ↦ gaussianHeatScore σ u q * gaussianHeatDensity σ u q :=
    funext (gaussianHeatDensity_center_deriv σ u)
  rw [he]
  convert! h using 1
  simp only [gaussianHeatAcceleration]
  ring

theorem gaussianHeatDensity_center_second_deriv (σ u p : ℝ) :
    deriv (deriv (gaussianHeatDensity σ u)) p =
      gaussianHeatAcceleration σ u p * gaussianHeatDensity σ u p :=
  (gaussianHeatDensity_center_deriv_hasDerivAt σ u p).deriv

/-- The normalization contributes the negative reciprocal-variance term. -/
theorem gaussianHeatNormalization_hasDerivAt (σ : ℝ) (hσ : 0 < σ) :
    HasDerivAt (fun τ : ℝ ↦ (Real.sqrt (2 * Real.pi * τ))⁻¹)
      (-(1 / (2 * σ)) * (Real.sqrt (2 * Real.pi * σ))⁻¹) σ := by
  have hp : 0 < 2 * Real.pi * σ := by positivity
  have hs : Real.sqrt (2 * Real.pi * σ) ≠ 0 := (Real.sqrt_pos.mpr hp).ne'
  have h := (((hasDerivAt_id σ).const_mul (2 * Real.pi)).sqrt hp.ne').inv hs
  convert! h using 1
  dsimp
  have hsq := Real.sq_sqrt (show 0 ≤ 2 * σ * Real.pi by positivity)
  field_simp [hs, hσ.ne']
  nlinarith [hsq]

theorem gaussianHeatDensity_variance_hasDerivAt (σ u p : ℝ) (hσ : 0 < σ) :
    HasDerivAt (fun τ ↦ gaussianHeatDensity τ u p)
      ((1 / 2 : ℝ) * gaussianHeatAcceleration σ u p * gaussianHeatDensity σ u p) σ := by
  have hx := (((hasDerivAt_const σ (-(u - p) ^ 2)).div
    ((hasDerivAt_id σ).const_mul 2) (by positivity : 2 * σ ≠ 0)).exp)
  have h := (gaussianHeatNormalization_hasDerivAt σ hσ).mul hx
  convert! h using 1
  dsimp [gaussianHeatDensity, gaussianHeatAcceleration, gaussianHeatScore]
  field_simp
  ring

theorem gaussianHeatDensity_variance_deriv (σ u p : ℝ) (hσ : 0 < σ) :
    deriv (fun τ ↦ gaussianHeatDensity τ u p) σ =
      (1 / 2 : ℝ) * gaussianHeatAcceleration σ u p * gaussianHeatDensity σ u p :=
  (gaussianHeatDensity_variance_hasDerivAt σ u p hσ).deriv

/-- The heat equation is an identity of actual ordinary derivatives. -/
theorem gaussianHeatDensity_heat_eq (σ u p : ℝ) (hσ : 0 < σ) :
    2 * deriv (fun τ ↦ gaussianHeatDensity τ u p) σ =
      deriv (deriv (gaussianHeatDensity σ u)) p := by
  rw [gaussianHeatDensity_variance_deriv σ u p hσ,
    gaussianHeatDensity_center_second_deriv]
  ring

end

end CommutingConvergence
end OriginalModule4


-- Source: CommutingConvergence.UnimodalGridMass
section OriginalModule5
set_option autoImplicit false
/-! A nonnegative unimodal density has a uniform grid-mass bound.
Shift its decreasing half by one mesh width and fill the gap at peak height.
This avoids choosing a nearest lattice point or splitting an integer range. -/

open Set MeasureTheory

namespace CommutingConvergence

noncomputable section

noncomputable def unimodalMeshEnvelope (f : ℝ → ℝ) (p h M x : ℝ) : ℝ :=
  (Iic p).indicator f x + (Ioi p).indicator f (x - h) +
    (Ioc p (p + h)).indicator (fun _ ↦ M) x

theorem unimodalMeshEnvelope_nonneg (f : ℝ → ℝ) (p h M x : ℝ)
    (hf : ∀ x, 0 ≤ f x) (hM : 0 ≤ M) :
    0 ≤ unimodalMeshEnvelope f p h M x := by
  unfold unimodalMeshEnvelope
  exact add_nonneg (add_nonneg (Set.indicator_nonneg (fun x _ ↦ hf x) _)
    (Set.indicator_nonneg (fun x _ ↦ hf x) _)) (Set.indicator_nonneg (fun _ _ ↦ hM) _)

theorem unimodalMeshEnvelope_integrable (f : ℝ → ℝ) (p h M : ℝ)
    (hf : Integrable f) : Integrable (unimodalMeshEnvelope f p h M) := by
  have hL := hf.indicator (s := Iic p) measurableSet_Iic
  have hR := (hf.indicator (s := Ioi p) measurableSet_Ioi).comp_sub_right h
  have hP : Integrable ((Ioc p (p + h)).indicator (fun _ : ℝ ↦ M)) := by
    rw [integrable_indicator_iff measurableSet_Ioc]
    exact integrableOn_const (hs := by simp)
  exact (hL.add hR).add hP

theorem unimodalMeshEnvelope_integral (f : ℝ → ℝ) (p h M : ℝ)
    (hf : Integrable f) (hh : 0 ≤ h) :
    ∫ x, unimodalMeshEnvelope f p h M x = (∫ x, f x) + h * M := by
  have hL := hf.indicator (s := Iic p) measurableSet_Iic
  have hR := (hf.indicator (s := Ioi p) measurableSet_Ioi).comp_sub_right h
  have hP : Integrable ((Ioc p (p + h)).indicator (fun _ : ℝ ↦ M)) := by
    rw [integrable_indicator_iff measurableSet_Ioc]
    exact integrableOn_const (hs := by simp)
  have hLR : Integrable (fun x ↦ (Iic p).indicator f x +
      (Ioi p).indicator f (x - h)) := hL.add hR
  unfold unimodalMeshEnvelope
