/-! Complete a positive semidefinite matrix only on its kernel. Supported
directions annihilate the added orthogonal projection. This keeps every
calculus statement in the original matrix space, without compression types. -/

open Matrix Unitary Filter Set
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator Topology

namespace CommutingConvergence

variable {n : Type*} [Fintype n] [DecidableEq n]

omit [DecidableEq n] in
/-- A supported direction kills every matrix whose columns lie in the base kernel. -/
theorem matrixSupportedOn_mul_zero (P K E : Matrix n n ℂ)
    (hK : MatrixSupportedOn P K) (hPE : P * E = 0) :
    K * E = 0 ∧ Kᴴ * E = 0 := by
  have hc (j : n) : P *ᵥ (fun i ↦ E i j) = 0 := by
    ext i
    exact congrFun (congrFun hPE i) j
  constructor
  · ext i j
    exact congrFun (hK _ (hc j)).1 i
  · ext i j
    exact congrFun (hK _ (hc j)).2 i

omit [DecidableEq n] in
/-- For a Hermitian kernel matrix, support gives annihilation on both sides. -/
theorem matrixSupportedOn_annihilate (P K E : Matrix n n ℂ)
    (hK : MatrixSupportedOn P K) (hPE : P * E = 0) (hE : E.IsHermitian) :
    K * E = 0 ∧ E * K = 0 := by
  obtain ⟨h1, h2⟩ := matrixSupportedOn_mul_zero P K E hK hPE
  refine ⟨h1, ?_⟩
  have h := congrArg Matrix.conjTranspose h2
  simpa only [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose,
    hE.eq, Matrix.conjTranspose_zero] using h

theorem unitaryConj_posDef (U : Matrix.unitaryGroup n ℂ) (P : Matrix n n ℂ)
    (hP : P.PosDef) : (unitaryConj U P).PosDef := by
  exact (Matrix.IsUnit.posDef_star_right_conjugate_iff (Unitary.isUnit_coe (U := U))).mpr hP

/-- Adding the orthogonal kernel projection gives a positive definite matrix,
including the zero base and the empty index type. -/
theorem exists_kernel_completion (P : Matrix n n ℂ) (hP : P.PosSemidef) :
    ∃ E : Matrix n n ℂ, E.PosSemidef ∧ E * E = E ∧ P * E = 0 ∧ (P + E).PosDef := by
  classical
  let U := hP.isHermitian.eigenvectorUnitary
  let a := hP.isHermitian.eigenvalues
  let e : n → ℝ := fun i ↦ if a i = 0 then 1 else 0
  let D := Matrix.diagonal (fun i ↦ (e i : ℂ))
  let E := unitaryConj U D
  have hD : D.PosSemidef := by
    apply Matrix.posSemidef_diagonal_iff.mpr
    intro i
    dsimp [e]
    split_ifs <;> norm_num
  have hDD : D * D = D := by
    rw [Matrix.diagonal_mul_diagonal]
    congr 1
    funext i
    dsimp [e]
    split_ifs <;> norm_num
  have hdiag : P = unitaryConj U (Matrix.diagonal (fun i ↦ (a i : ℂ))) :=
    hP.isHermitian.spectral_theorem
  have hPE : P * E = 0 := by
    rw [hdiag]
    change unitaryConj U (Matrix.diagonal (fun i ↦ (a i : ℂ))) * unitaryConj U D = 0
    rw [← map_mul, Matrix.diagonal_mul_diagonal]
    have hz : (fun i ↦ (a i : ℂ) * (e i : ℂ)) = 0 := by
      funext i
      dsimp [e]
      split_ifs with hi <;> simp [hi]
    rw [hz]
    have hzD : Matrix.diagonal (0 : n → ℂ) = 0 := by ext i j; simp [Matrix.diagonal_apply]
    rw [hzD, map_zero]
  have hPD : (Matrix.diagonal (fun i ↦ ((a i + e i : ℝ) : ℂ))).PosDef := by
    apply Matrix.posDef_diagonal_iff.mpr
    intro i
    have ha := hP.eigenvalues_nonneg i
