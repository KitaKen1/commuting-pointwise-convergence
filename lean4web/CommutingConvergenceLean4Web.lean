  change |rectangularCubicEnergy (Matrix.fromCols A₁ B) - rectangularCubicEnergy (Matrix.fromCols A₀ B)| ≤ _ at he
  simp only [Fintype.sum_sum_type, Matrix.sub_apply, Matrix.fromCols_apply_inl,
