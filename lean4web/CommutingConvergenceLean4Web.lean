  rw [gaussianHeatDensity_iteratedDeriv, gaussianHeatDensity_iteratedDeriv]
  have hs : gaussianHeatScore σ u p = -gaussianHeatScore σ p u := by
    unfold gaussianHeatScore; ring
  rw [hs, gaussianScorePolynomial_eval_neg, gaussianHeatDensity_symm σ u p]
  ring

