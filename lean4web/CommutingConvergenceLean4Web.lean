    intro x y hy
    have hyb : |y - b| < 1 := by simpa only [Metric.mem_ball, Real.dist_eq] using hy
    have hyK : |y| ≤ |b| + 1 := by
      have htri := abs_add_le b (y - b)
      have hid : b + (y - b) = y := by ring
      rw [hid] at htri
      linarith
