theorem gaussian_grid_mass_le_uniform (h σ p a : ℝ) (N : ℕ)
    (hh : 0 ≤ h) (hσ : 0 < σ) (hmesh : h ^ 2 ≤ σ) :
    ∑ i ∈ Finset.range N, h * gaussianHeatDensity σ (a + h * i) p ≤
      1 + (Real.sqrt (2 * Real.pi))⁻¹ := by
  exact (gaussian_grid_mass_le_one_add_peak h σ p a N hh hσ).trans
    (add_le_add_right (gaussian_mesh_peak_le h σ hh hσ hmesh) 1)

