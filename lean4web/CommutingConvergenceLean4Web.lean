  have ht₁ : (∑ i,∑ j,∑ k,if j=k then if j < i then w i j k else 0 else 0) = ∑ i,∑ j,∑ k,T i j k := by
    rw [finite_triple_sum_rotate]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro k _
    exact congrArg (fun z : ℂ ↦ if i=j then if i < k then z else 0 else 0) (hw k i j)
  have ht₂ : (∑ i,∑ j,∑ k,if k=i then if k < j then w i j k else 0 else 0) = ∑ i,∑ j,∑ k,T i j k := by
    calc
      _ = ∑ i,∑ j,∑ k,T k i j := by
        apply Finset.sum_congr rfl
        intro i _
        apply Finset.sum_congr rfl
        intro j _
        apply Finset.sum_congr rfl
        intro k _
        exact congrArg (fun z : ℂ ↦ if k=i then if k < j then z else 0 else 0) (hw k i j).symm
      _ = _ := (finite_triple_sum_rotate T).symm
  have hd : (∑ i,∑ j,∑ k,if i=j then if j=k then w i j k else 0 else 0)=∑ i,w i i i := by
    simp
  have ho : (∑ i,∑ j,∑ k,O i j k) =
      ∑ i,∑ j ∈ Finset.univ.filter (i < ·),∑ k ∈ Finset.univ.filter (i < ·),w i j k := by
    simp only [O,Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    by_cases hij : i < j <;> simp [hij]
  have ht : (∑ i,∑ j,∑ k,T i j k)=∑ i,∑ j ∈ Finset.univ.filter (i < ·),w i i j := by
    simp [T,Finset.sum_filter]
  calc
    _ = ∑ i,∑ j,∑ k,((if i=j then if j=k then w i j k else 0 else 0)+
        (if i < j then if i < k then w i j k else 0 else 0)+
        (if j < k then if j < i then w i j k else 0 else 0)+
        (if k < i then if k < j then w i j k else 0 else 0)+
        (if i=j then if i < k then w i j k else 0 else 0)+
        (if j=k then if j < i then w i j k else 0 else 0)+
        (if k=i then if k < j then w i j k else 0 else 0)) :=
      Finset.sum_congr rfl fun i _ ↦ Finset.sum_congr rfl fun j _ ↦ Finset.sum_congr rfl fun k _ ↦ hs i j k
