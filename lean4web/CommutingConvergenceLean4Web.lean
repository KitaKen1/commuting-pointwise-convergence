      K*(2*n+1:ℕ)) :
    (∑ k ∈ Finset.Icc (j-(N:ℤ)) (j+(N:ℤ)), W k*q k) ≤
      K*∑ k ∈ Finset.Icc (j-(N:ℤ)) (j+(N:ℤ)), W k := by
  have he := finite_decreasing_weight_comparison (integerRadialShell q j)
    (integerRadialShell (fun _ ↦ 1) j) w K (N+1) hw hanti (by
      intro n hn
      cases n with
      | zero => simp
      | succ n =>
        rw [integer_radial_shell_sum, integer_radial_shell_count]
        exact hprefix n (by omega))
  rw [integer_weighted_radial_shell_sum q W w j N hp hm,
    integer_weighted_radial_shell_sum (fun _ ↦ 1) W w j N hp hm] at he
  simpa using he

theorem integer_block_sum_range (q : ℤ → ℝ) (j : ℤ) (N : ℕ) :
    (∑ k ∈ Finset.Icc (j-(N:ℤ)) (j+(N:ℤ)), q k) =
