/-! Intrinsic supported cost and the sharp 3/4 bound for arbitrary rectangular Gram insertions.
The remaining analytic identification is that this cost is the trace-power Hessian. -/

open Matrix Unitary
open scoped NNReal ComplexOrder MatrixOrder Matrix.Norms.L2Operator

namespace CommutingConvergence

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

/-- Intrinsic supported quadratic cost, with the positive square root as the Sylvester variable. -/
noncomputable def gramSylvesterCost (P K : Matrix n n ℂ) : ℝ :=
  spectralSylvesterCost (CFC.sqrt P) (CFC.sqrt_nonneg P).posSemidef.isHermitian K

/-- The energy used here is the cube of the positive square root. -/
noncomputable def gramRootEnergy (P : Matrix n n ℂ) : ℝ :=
  (Matrix.trace ((CFC.sqrt P) ^ 3)).re

