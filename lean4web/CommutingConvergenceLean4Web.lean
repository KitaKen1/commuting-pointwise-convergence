          (R ^ 2 * (n + 1 : ℕ)) * ((n.factorial : ℝ) * R ^ n) :=
        add_le_add (mul_le_mul_of_nonneg_right hx (by positivity))
          (mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right hv (Nat.cast_nonneg _)) (by positivity))
      _ = 2 * ((n + 1).factorial : ℝ) * R ^ (n + 2) := by
        simp only [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one,
          pow_succ]
