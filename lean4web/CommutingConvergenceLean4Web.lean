  have hDs := (matrixSupportedOn_sqrt_iff Q D hQ).mpr hD
  have hX : MatrixSupportedOn P X := (matrixSupportedOn_sqrt_iff P X hP).mp
    (spectralSylvesterSolve_supported _ _ A hAs)
  have hY : MatrixSupportedOn Q Y := (matrixSupportedOn_sqrt_iff Q Y hQ).mp
    (spectralSylvesterSolve_supported _ _ D hDs)
  have heX : CFC.sqrt P * X + X * CFC.sqrt P = A :=
    spectralSylvesterSolve_spec _ (CFC.sqrt_nonneg P).posSemidef A hAs
  have heY : CFC.sqrt Q * Y + Y * CFC.sqrt Q = D :=
    spectralSylvesterSolve_spec _ (CFC.sqrt_nonneg Q).posSemidef D hDs
  rw [gramSylvesterCost_eq_of_solution _ (twoBlockDiagonal_posSemidef P Q hP hQ)
    _ (Matrix.fromBlocks X 0 0 Y) (matrixSupportedOn_blockDiagonal P X Q Y hX hY)
    (by simp [matrix_sqrt_twoBlockDiagonal P Q hP hQ, Matrix.fromBlocks_multiply,
