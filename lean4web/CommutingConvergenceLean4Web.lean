/-! The first derivative of the trace-root energy and the derivative of its gradient
at positive definite bases. The singular fixed-support extension is a separate step. -/

open Matrix Filter Set
open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator Topology RightActions

namespace CommutingConvergence

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Real trace with the same matrix norm used by the root and Sylvester maps. -/
noncomputable def matrixRealTraceCLM : Matrix n n ℂ →L[ℝ] ℝ :=
  Complex.reCLM.comp (Matrix.traceLinearMap n ℝ ℂ).toContinuousLinearMap

/-- Multiplication and trace as one continuous linear map into the dual space. -/
noncomputable def matrixGradientOperator :
    Matrix n n ℂ →L[ℝ] (Matrix n n ℂ →L[ℝ] ℝ) :=
  (3 / 2 : ℝ) •
    ((ContinuousLinearMap.compL ℝ (Matrix n n ℂ) (Matrix n n ℂ) ℝ matrixRealTraceCLM).comp
      (ContinuousLinearMap.mul ℝ (Matrix n n ℂ)))

noncomputable def matrixEnergyGradientCLM (P : Matrix n n ℂ) :
    Matrix n n ℂ →L[ℝ] ℝ := matrixGradientOperator (CFC.sqrt P)

noncomputable def matrixEnergyHessianCLM (P : Matrix n n ℂ) :
    Matrix n n ℂ →L[ℝ] (Matrix n n ℂ →L[ℝ] ℝ) :=
  matrixGradientOperator.comp
    (spectralSylvesterCLM (CFC.sqrt P) (CFC.sqrt_nonneg P).posSemidef.isHermitian)

theorem matrixEnergyGradientCLM_apply (P K : Matrix n n ℂ) :
    matrixEnergyGradientCLM P K = (3 / 2 : ℝ) * (Matrix.trace (CFC.sqrt P * K)).re := rfl

theorem matrixEnergyHessianCLM_apply (P K L : Matrix n n ℂ) :
    matrixEnergyHessianCLM P K L = (3 / 2 : ℝ) *
      (Matrix.trace (spectralSylvesterCLM (CFC.sqrt P)
        (CFC.sqrt_nonneg P).posSemidef.isHermitian K * L)).re := rfl

/-- The cubic-root energy can be differentiated as `trace (P * sqrt P)` on the cone. -/
theorem gramRootEnergy_eq_trace_mul_sqrt (P : Matrix n n ℂ) (hP : P.PosSemidef) :
    gramRootEnergy P = (Matrix.trace (P * CFC.sqrt P)).re := by
  unfold gramRootEnergy
  rw [show (CFC.sqrt P) ^ 3 = P * CFC.sqrt P by
    rw [show 3 = 2 + 1 from rfl, pow_succ, pow_two, CFC.sqrt_mul_sqrt_self P hP.nonneg]]

