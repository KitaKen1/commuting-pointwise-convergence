section OriginalModule95
set_option autoImplicit false
/-! Exact pointwise Gaussian products and their convolution integrals.
Completing the square reduces every integral to an already normalized density. -/

open MeasureTheory
namespace CommutingConvergence
noncomputable section

/-- The precision-weighted center and harmonic variance complete the square. -/
theorem gaussian_completed_square (σ τ a b x : ℝ) (hσ : 0 < σ) (hτ : 0 < τ) :
    -(a-x)^2/(2*σ) - (b-x)^2/(2*τ) =
      -(a-b)^2/(2*(σ+τ)) - (((τ*a+σ*b)/(σ+τ))-x)^2/(2*(σ*τ/(σ+τ))) := by
  have hs : σ + τ ≠ 0 := (add_pos hσ hτ).ne'
  field_simp [hσ.ne', hτ.ne', hs]
  ring

theorem gaussian_product_normalization (σ τ : ℝ) (hσ : 0 < σ) (hτ : 0 < τ) :
    (Real.sqrt (2*Real.pi*σ))⁻¹ * (Real.sqrt (2*Real.pi*τ))⁻¹ =
      (Real.sqrt (2*Real.pi*(σ+τ)))⁻¹ * (Real.sqrt (2*Real.pi*(σ*τ/(σ+τ))))⁻¹ := by
  have hs : σ + τ ≠ 0 := (add_pos hσ hτ).ne'
  have he : (2*Real.pi*σ)*(2*Real.pi*τ) =
      (2*Real.pi*(σ+τ))*(2*Real.pi*(σ*τ/(σ+τ))) := by
    field_simp [hs]
  rw [← mul_inv, ← Real.sqrt_mul (by positivity : 0 ≤ 2*Real.pi*σ),
    ← mul_inv, ← Real.sqrt_mul (by positivity : 0 ≤ 2*Real.pi*(σ+τ)), he]

/-- A product of two densities equals a constant times one normalized density. -/
theorem gaussianHeatDensity_product (σ τ a b x : ℝ) (hσ : 0 < σ) (hτ : 0 < τ) :
    gaussianHeatDensity σ a x * gaussianHeatDensity τ b x =
      gaussianHeatDensity (σ+τ) a b *
        gaussianHeatDensity (σ*τ/(σ+τ)) ((τ*a+σ*b)/(σ+τ)) x := by
  unfold gaussianHeatDensity
  calc
    _ = ((Real.sqrt (2*Real.pi*σ))⁻¹ * (Real.sqrt (2*Real.pi*τ))⁻¹) *
        Real.exp (-(a-x)^2/(2*σ) - (b-x)^2/(2*τ)) := by
      simp only [sub_eq_add_neg, neg_div, Real.exp_add]
      ring
    _ = ((Real.sqrt (2*Real.pi*(σ+τ)))⁻¹ *
        (Real.sqrt (2*Real.pi*(σ*τ/(σ+τ))))⁻¹) *
        Real.exp (-(a-b)^2/(2*(σ+τ)) - (((τ*a+σ*b)/(σ+τ))-x)^2/(2*(σ*τ/(σ+τ)))) := by
      rw [gaussian_product_normalization σ τ hσ hτ, gaussian_completed_square σ τ a b x hσ hτ]
    _ = _ := by
      simp only [sub_eq_add_neg, neg_div, Real.exp_add]
      ring

theorem gaussianHeatDensity_product_integrable (σ τ a b : ℝ) (hσ : 0 < σ) (hτ : 0 < τ) :
    Integrable (fun x ↦ gaussianHeatDensity σ a x * gaussianHeatDensity τ b x) := by
  have hv : 0 ≤ σ*τ/(σ+τ) := by positivity
  simpa only [gaussianHeatDensity_product σ τ a b _ hσ hτ] using
    (gaussianHeatDensity_center_integrable (σ*τ/(σ+τ)) ((τ*a+σ*b)/(σ+τ)) hv).const_mul
      (gaussianHeatDensity (σ+τ) a b)

theorem gaussianHeatDensity_product_integral (σ τ a b : ℝ) (hσ : 0 < σ) (hτ : 0 < τ) :
    (∫ x, gaussianHeatDensity σ a x * gaussianHeatDensity τ b x) =
      gaussianHeatDensity (σ+τ) a b := by
  simp_rw [gaussianHeatDensity_product σ τ a b _ hσ hτ]
  rw [integral_const_mul, gaussianHeatDensity_center_integral _ _ (by positivity), mul_one]

theorem gaussianHeatDensity_convolution_integrable (σ τ a b : ℝ) (hσ : 0 < σ) (hτ : 0 < τ) :
    Integrable (fun x ↦ gaussianHeatDensity σ a x * gaussianHeatDensity τ x b) := by
  simpa only [gaussianHeatDensity_symm τ _ b] using
    gaussianHeatDensity_product_integrable σ τ a b hσ hτ

theorem gaussianHeatDensity_convolution (σ τ a b : ℝ) (hσ : 0 < σ) (hτ : 0 < τ) :
    (∫ x, gaussianHeatDensity σ a x * gaussianHeatDensity τ x b) =
      gaussianHeatDensity (σ+τ) a b := by
  simpa only [gaussianHeatDensity_symm τ _ b] using
    gaussianHeatDensity_product_integral σ τ a b hσ hτ

end
end CommutingConvergence
