/-! Four fixed unit phases suffice for sublinear chain budgets: the loss is
only a factor two, with no dense phase set or approximation error. -/
open MeasureTheory
namespace CommutingConvergence
noncomputable section

def fourPhase (q : Fin 4) : ℂ :=
  if q = 0 then 1 else if q = 1 then -1 else if q = 2 then Complex.I else -Complex.I

def fourPhaseChoice (z : ℂ) : Fin 4 :=
  if |z.im| ≤ |z.re| then (if 0 ≤ z.re then 0 else 1)
  else (if 0 ≤ z.im then 3 else 2)

theorem fourPhase_norm (q : Fin 4) : ‖fourPhase q‖ = 1 := by
  fin_cases q <;> simp [fourPhase]

theorem measurable_fourPhaseChoice : Measurable fourPhaseChoice := by
  unfold fourPhaseChoice
  apply Measurable.ite (measurableSet_le (by fun_prop) (by fun_prop))
  · exact Measurable.ite (measurableSet_le measurable_const (by fun_prop))
      measurable_const measurable_const
  · exact Measurable.ite (measurableSet_le measurable_const (by fun_prop))
      measurable_const measurable_const

theorem fourPhaseChoice_re_eq (z : ℂ) :
    (fourPhase (fourPhaseChoice z) * z).re = max |z.re| |z.im| := by
  by_cases h : |z.im| ≤ |z.re|
  · rw [max_eq_left h]
    by_cases hr : 0 ≤ z.re
    · rw [fourPhaseChoice, ite_eq_left h, ite_eq_left hr]
      simp [fourPhase, abs_of_nonneg hr]
    · rw [fourPhaseChoice, ite_eq_left h, ite_eq_right hr]
      simp [fourPhase, abs_of_neg (lt_of_not_ge hr)]
  · rw [max_eq_right (le_of_not_ge h)]
    by_cases hi : 0 ≤ z.im
    · rw [fourPhaseChoice, ite_eq_right h, ite_eq_left hi]
      simp [fourPhase, abs_of_nonneg hi]
    · rw [fourPhaseChoice, ite_eq_right h, ite_eq_right hi]
      simp [fourPhase, abs_of_neg (lt_of_not_ge hi)]

theorem fourPhaseChoice_re_nonneg (z : ℂ) : 0 ≤ (fourPhase (fourPhaseChoice z) * z).re := by
  rw [fourPhaseChoice_re_eq]
  exact (abs_nonneg _).trans (le_max_left _ _)

theorem norm_le_two_fourPhaseChoice_re (z : ℂ) :
    ‖z‖ ≤ 2 * (fourPhase (fourPhaseChoice z) * z).re := by
  rw [fourPhaseChoice_re_eq]
  have hr := le_max_left |z.re| |z.im|
  have hi := le_max_right |z.re| |z.im|
  have hz := Complex.norm_le_abs_re_add_abs_im z
  linarith

theorem exists_fourPhase_re_norm_bound (z : ℂ) :
    ∃ q : Fin 4, 0 ≤ (fourPhase q * z).re ∧ ‖z‖ ≤ 2 * (fourPhase q * z).re :=
  ⟨fourPhaseChoice z, fourPhaseChoice_re_nonneg z, norm_le_two_fourPhaseChoice_re z⟩

end
