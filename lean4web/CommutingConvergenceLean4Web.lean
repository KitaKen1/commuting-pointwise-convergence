    |(gaussianScorePolynomial v n).eval x| ≤
      (n.factorial : ℝ) * (1 + |x| + |v|) ^ n := by
  let R := 1 + |x| + |v|
  have hr : 1 ≤ R := by dsimp [R]; linarith [abs_nonneg x, abs_nonneg v]
  have hr0 : 0 ≤ R := le_trans (by norm_num) hr
  have hx : |x| ≤ R := by dsimp [R]; linarith [abs_nonneg v]
  have hv : |v| ≤ R ^ 2 := by
    have hv1 : |v| ≤ R := by dsimp [R]; linarith [abs_nonneg x]
    nlinarith
  change |(gaussianScorePolynomial v n).eval x| ≤ (n.factorial : ℝ) * R ^ n
  induction n using Nat.twoStepInduction with
  | zero => simp [gaussianScorePolynomial_zero]
  | one => simpa [gaussianScorePolynomial_one] using hx
  | more n ih0 ih1 =>
    have hc : 2 * ((n + 1).factorial : ℝ) ≤ ((n + 2).factorial : ℝ) := by
      have hf : (n + 2).factorial = (n + 2) * (n + 1).factorial :=
        Nat.factorial_succ (n + 1)
      rw [hf, Nat.cast_mul]
      exact mul_le_mul_of_nonneg_right
        (by exact_mod_cast (show 2 ≤ n + 2 by omega)) (Nat.cast_nonneg _)
    rw [gaussianScorePolynomial_eval_add_two]
