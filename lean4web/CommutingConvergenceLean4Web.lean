    CFC.sqrt_mul_sqrt_self _ (Matrix.posSemidef_conjTranspose_mul_self R).nonneg
  have hsqB : B * B = R * Rᴴ :=
    CFC.sqrt_mul_sqrt_self _ (Matrix.posSemidef_self_mul_conjTranspose R).nonneg
