    ℝ × (ℝ × ℝ) → ℂ :=
  latticeTripleExtension (latticeBoxIndices R n) (latticeBoxIndices R n)
    (latticeBoxIndices R n) (reciprocalLatticeMesh n)
    (fun i j k ↦ F (reciprocalLatticeMesh n*(i:ℝ),
      (reciprocalLatticeMesh n*(j:ℝ), reciprocalLatticeMesh n*(k:ℝ))))

