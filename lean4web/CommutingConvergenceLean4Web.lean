  by_cases hx : x ≤ p
  · have hcmp := hL (hux.trans hx) hx hux
    rw [indicator_of_mem (show x ∈ Iic p from hx)] 
    linarith
  · by_cases hx' : p < x - h
    · have hcmp := hR (le_of_lt hx') (by change p ≤ u; linarith) (by linarith : x - h ≤ u)
      rw [indicator_of_mem (show x - h ∈ Ioi p from hx')]
      linarith
    · have hc : x ∈ Ioc p (p + h) := by constructor <;> linarith
      rw [indicator_of_mem hc]
      linarith [hM u]

/-- A finite grid of any length and origin, with no lattice alignment assumption. -/
theorem unimodal_grid_mass_le (f : ℝ → ℝ) (p h M a : ℝ) (N : ℕ)
    (hi : Integrable f) (hf : ∀ x, 0 ≤ f x) (hM : ∀ x, f x ≤ M)
