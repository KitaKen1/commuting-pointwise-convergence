positive compact variance intervals. No sharp Hermite constants are required. -/

open Polynomial

namespace CommutingConvergence

noncomputable section

theorem gaussianScorePolynomial_add_two (v : ℝ) (n : ℕ) :
    gaussianScorePolynomial v (n + 2) = X * gaussianScorePolynomial v (n + 1) -
      C v * ((n + 1) • gaussianScorePolynomial v n) := by
  rw [show n + 2 = (n + 1) + 1 by omega, gaussianScorePolynomial_succ,
    gaussianScorePolynomial_derivative_succ]

theorem gaussianScorePolynomial_eval_add_two (v x : ℝ) (n : ℕ) :
    (gaussianScorePolynomial v (n + 2)).eval x =
      x * (gaussianScorePolynomial v (n + 1)).eval x -
        v * (n + 1 : ℕ) * (gaussianScorePolynomial v n).eval x := by
  rw [gaussianScorePolynomial_add_two]
  simp [nsmul_eq_mul, mul_assoc]

