/-! Exact finite centered shells and Abel comparison on the integer lattice. -/
namespace CommutingConvergence

def integerRadialShell (q : ℤ → ℝ) (j : ℤ) : ℕ → ℝ
  | 0 => q j
  | n+1 => q (j+(n+1:ℕ)) + q (j-(n+1:ℕ))

theorem integer_block_succ (j : ℤ) (N : ℕ) :
    Finset.Icc (j-(N+1:ℕ)) (j+(N+1:ℕ)) =
      insert (j-(N+1:ℕ)) (insert (j+(N+1:ℕ)) (Finset.Icc (j-(N:ℤ)) (j+(N:ℤ)))) := by
  ext k
  simp only [Finset.mem_Icc, Finset.mem_insert]
  omega

theorem integer_radial_shell_sum (q : ℤ → ℝ) (j : ℤ) (N : ℕ) :
    (∑ n ∈ Finset.range (N+1), integerRadialShell q j n) =
      ∑ k ∈ Finset.Icc (j-(N:ℤ)) (j+(N:ℤ)), q k := by
  induction N with
  | zero => simp [integerRadialShell]
  | succ N ih =>
    rw [Finset.sum_range_succ, ih, integer_block_succ]
    rw [Finset.sum_insert (by simp only [Finset.mem_insert, Finset.mem_Icc]; omega),
      Finset.sum_insert (by simp only [Finset.mem_Icc]; omega)]
    simp only [integerRadialShell]
    ring

theorem integer_radial_shell_count (j : ℤ) (N : ℕ) :
    (∑ n ∈ Finset.range (N+1), integerRadialShell (fun _ ↦ 1) j n) = (2*N+1:ℕ) := by
  rw [integer_radial_shell_sum]
  have ht : j+(N:ℤ)+1-(j-(N:ℤ)) = ((2*N+1:ℕ):ℤ) := by push_cast; ring
  have hcard : (Finset.Icc (j-(N:ℤ)) (j+(N:ℤ))).card = 2*N+1 := by
    rw [Int.card_Icc, ht, Int.toNat_natCast]
  simpa using congrArg (fun n : ℕ ↦ (n:ℝ)) hcard

theorem integer_weighted_radial_shell_sum (q W : ℤ → ℝ) (w : ℕ → ℝ) (j : ℤ) (N : ℕ)
    (hp : ∀ n : ℕ, W (j+(n:ℤ)) = w n) (hm : ∀ n : ℕ, W (j-(n:ℤ)) = w n) :
    (∑ n ∈ Finset.range (N+1), w n*integerRadialShell q j n) =
      ∑ k ∈ Finset.Icc (j-(N:ℤ)) (j+(N:ℤ)), W k*q k := by
  rw [← integer_radial_shell_sum]
  apply Finset.sum_congr rfl
  intro n _
  cases n with
  | zero => simpa [integerRadialShell] using congrArg (fun z ↦ z*q j) (hp 0).symm
  | succ n => simp only [integerRadialShell, hp, hm, mul_add]

theorem integer_decreasing_radial_comparison (q W : ℤ → ℝ) (w : ℕ → ℝ)
    (j : ℤ) (N : ℕ) (K : ℝ) (hw : ∀ n, 0 ≤ w n) (hanti : Antitone w)
    (hp : ∀ n : ℕ, W (j+(n:ℤ)) = w n) (hm : ∀ n : ℕ, W (j-(n:ℤ)) = w n)
