/-- The imported real Birkhoff theorem yields complex convergence by its two coordinates. -/
theorem ae_complex_birkhoff (T : X → X) (hT : MeasurePreserving T μ μ)
    (f : X → ℂ) (hf : Integrable f μ) :
    ∀ᵐ x ∂μ, ∃ L : ℂ,
      Tendsto (fun N : ℕ ↦ (N : ℂ)⁻¹ * ∑ n ∈ Finset.range N, f (T^[n] x)) atTop (𝓝 L) := by
  have hr := LeanPool.PointwiseBirkhoff.birkhoffErgodicTheorem' μ hT hf.re
  have hi := LeanPool.PointwiseBirkhoff.birkhoffErgodicTheorem' μ hT hf.im
  filter_upwards [hr, hi] with x hxr hxi
  refine ⟨(LeanPool.PointwiseBirkhoff.invCondexp μ T (fun y ↦ (f y).re) x : ℂ) +
    (LeanPool.PointwiseBirkhoff.invCondexp μ T (fun y ↦ (f y).im) x : ℂ) * Complex.I, ?_⟩
  have hh := hxr.ofReal.add (hxi.ofReal.mul_const Complex.I)
  convert hh using 1
  · funext N
    apply Complex.ext <;> simp [birkhoffAverage, birkhoffSum, Complex.mul_re, Complex.mul_im]

