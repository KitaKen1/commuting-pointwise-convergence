  have hc : 0 < Real.sqrt (2 * Real.pi) := by positivity
  have hd : 0 < Real.sqrt (2 * Real.pi * σ) := by positivity
  have hs := Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left hmesh
    (show 0 ≤ 2 * Real.pi by positivity))
  rw [Real.sqrt_mul (by positivity : 0 ≤ 2 * Real.pi), Real.sqrt_sq hh] at hs
