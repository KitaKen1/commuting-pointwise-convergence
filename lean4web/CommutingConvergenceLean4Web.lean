  have hright : N * (1 - E) = N := by rw [Matrix.mul_sub, Matrix.mul_one, hNE, sub_zero]
  have he : (1 - E) * E = 0 := by rw [Matrix.sub_mul, Matrix.one_mul, hEE, sub_self]
