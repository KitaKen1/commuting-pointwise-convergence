    _ ≤ |gaussianHeatScore σ u p ^ 2| + |σ⁻¹| := abs_sub _ _
    _ = gaussianHeatScore σ u p ^ 2 + σ⁻¹ := by
      rw [abs_of_nonneg (sq_nonneg _), abs_of_pos (inv_pos.mpr hp)]
