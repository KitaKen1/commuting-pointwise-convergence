  1 + (K + |p|) / lo + lo⁻¹

def gaussianHigherDerivativeEnvelope (n : ℕ) (lo hi K p : ℝ) : ℝ :=
  (n.factorial : ℝ) * gaussianHigherScoreRadius lo K p ^ n *
    gaussianUniformCoefficient lo K * gaussianUniformDecay hi p

