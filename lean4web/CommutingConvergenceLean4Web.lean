    Continuous (fun X : Matrix n n ℂ ↦ matrixSylvesterTrial A K X) := by
  have hlin : Continuous (fun X : Matrix n n ℂ ↦ matrixTracePair K X) := by
    have he : (fun X : Matrix n n ℂ ↦ matrixTracePair K X) = matrixTracePairCLM K := by
      funext X
      exact matrixTracePair_comm K X
    rw [he]
    exact (matrixTracePairCLM K).continuous
  have hm : Continuous (fun X : Matrix n n ℂ ↦ A * X + X * A) :=
    (continuous_const.mul continuous_id).add (continuous_id.mul continuous_const)
  have hq : Continuous (fun X : Matrix n n ℂ ↦ star X * (A * X + X * A)) :=
    continuous_id.star.mul hm
