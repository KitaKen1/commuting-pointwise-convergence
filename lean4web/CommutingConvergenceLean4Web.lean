/-! Exact finite trace identities for three independently weighted vertices.
Each square root occurs twice around the cycle, so the final kernel carries
one density per vertex. The complex edge arrays retain all their phases. -/

open Matrix
open scoped BigOperators

namespace CommutingConvergence
noncomputable section

variable {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]
  [DecidableEq m] [DecidableEq n] [DecidableEq p]

def vertexRootMatrix (w : m → ℝ) : Matrix m m ℂ :=
  Matrix.diagonal (fun i ↦ (Real.sqrt (w i) : ℂ))

def vertexWeightedEdge (w : m → ℝ) (v : n → ℝ) (A : Matrix m n ℂ) : Matrix m n ℂ :=
  vertexRootMatrix w * A * vertexRootMatrix v

theorem vertexWeightedEdge_apply (w : m → ℝ) (v : n → ℝ)
    (A : Matrix m n ℂ) (i : m) (j : n) :
    vertexWeightedEdge w v A i j =
      (Real.sqrt (w i) : ℂ) * A i j * (Real.sqrt (v j) : ℂ) := by
  simp [vertexWeightedEdge, vertexRootMatrix, Matrix.diagonal_mul, Matrix.mul_diagonal]

theorem vertexWeightedEdge_cyclic_product
    (w₀ : m → ℝ) (w₁ : n → ℝ) (w₂ : p → ℝ)
    (A : Matrix m n ℂ) (B : Matrix n p ℂ) (C : Matrix p m ℂ)
    (h₀ : ∀ i, 0 ≤ w₀ i) (h₁ : ∀ j, 0 ≤ w₁ j) (h₂ : ∀ k, 0 ≤ w₂ k)
    (i : m) (j : n) (k : p) :
    vertexWeightedEdge w₀ w₁ A i j * vertexWeightedEdge w₁ w₂ B j k *
      vertexWeightedEdge w₂ w₀ C k i =
        ((w₀ i * w₁ j * w₂ k : ℝ) : ℂ) * (A i j * B j k * C k i) := by
  simp only [vertexWeightedEdge_apply, Complex.ofReal_mul]
  have hs₀ : (Real.sqrt (w₀ i) : ℂ) ^ 2 = (w₀ i : ℂ) := by
    exact_mod_cast Real.sq_sqrt (h₀ i)
  have hs₁ : (Real.sqrt (w₁ j) : ℂ) ^ 2 = (w₁ j : ℂ) := by
    exact_mod_cast Real.sq_sqrt (h₁ j)
  have hs₂ : (Real.sqrt (w₂ k) : ℂ) ^ 2 = (w₂ k : ℂ) := by
    exact_mod_cast Real.sq_sqrt (h₂ k)
  calc
    _ = (Real.sqrt (w₀ i) : ℂ) ^ 2 * (Real.sqrt (w₁ j) : ℂ) ^ 2 *
        (Real.sqrt (w₂ k) : ℂ) ^ 2 * (A i j * B j k * C k i) := by ring
    _ = _ := by rw [hs₀, hs₁, hs₂]

theorem vertexWeightedEdge_inserted_trace
    (w₀ : m → ℝ) (w₁ : n → ℝ) (w₂ : p → ℝ)
    (A : Matrix m n ℂ) (B : Matrix n p ℂ) (C : Matrix p m ℂ)
    (d : m → ℂ) (e : n → ℂ) (f : p → ℂ)
    (h₀ : ∀ i, 0 ≤ w₀ i) (h₁ : ∀ j, 0 ≤ w₁ j) (h₂ : ∀ k, 0 ≤ w₂ k) :
    Matrix.trace ((Matrix.diagonal d * vertexWeightedEdge w₀ w₁ A) *
      (Matrix.diagonal e * vertexWeightedEdge w₁ w₂ B) *
      (Matrix.diagonal f * vertexWeightedEdge w₂ w₀ C)) =
      ∑ i, ∑ j, ∑ k, (d i * e j * f k) *
        ((w₀ i * w₁ j * w₂ k : ℝ) : ℂ) * (A i j * B j k * C k i) := by
  rw [rectangular_inserted_cyclic_trace_eq_sum]
  simp_rw [vertexWeightedEdge_cyclic_product w₀ w₁ w₂ A B C h₀ h₁ h₂]
  simp only [mul_assoc]

end
end CommutingConvergence
end OriginalModule36


