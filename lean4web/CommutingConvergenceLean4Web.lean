    (n : ℕ) (σ τ a b : ℝ) (hσ : 0 < σ) (hτ : 0 < τ) :
    (∫ x, gaussianHeatDensity σ a x *
      iteratedDeriv n (gaussianHeatDensity τ x) b) =
      iteratedDeriv n (gaussianHeatDensity (σ + τ) a) b := by
