  have ha' : a l ∉ Ioo s r := fun h ↦ ha l hl ⟨h.1,h.2.trans hrt⟩
  have hb' : b l ∉ Ioo s r := fun h ↦ hb l hl ⟨h.1,h.2.trans hrt⟩
