      gramSylvesterCost P A + gramSylvesterCost Q D := by
  let X := spectralSylvesterSolve (CFC.sqrt P) (CFC.sqrt_nonneg P).posSemidef.isHermitian A
  let Y := spectralSylvesterSolve (CFC.sqrt Q) (CFC.sqrt_nonneg Q).posSemidef.isHermitian D
