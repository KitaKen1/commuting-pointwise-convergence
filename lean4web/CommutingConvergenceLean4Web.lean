open scoped ComplexOrder MatrixOrder Matrix.Norms.L2Operator

namespace CommutingConvergence

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

noncomputable def rectangularUnitaryCoordinates (U : Matrix.unitaryGroup m ℂ)
    (V : Matrix.unitaryGroup n ℂ) (R : Matrix m n ℂ) : Matrix m n ℂ :=
  (star U : Matrix m m ℂ) * R * (V : Matrix n n ℂ)

