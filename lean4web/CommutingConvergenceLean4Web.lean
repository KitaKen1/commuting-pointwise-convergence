    (hP : ∀ᵐ ω ∂μ, (P ω).PosSemidef) (hPi : Integrable P μ)
    (hKi : Integrable K μ) (hK : ∀ᵐ ω ∂μ, MatrixSupportedOn (P ω) (K ω)) :
    MatrixSupportedOn (∫ ω, P ω ∂μ) (∫ ω, K ω ∂μ) := by
