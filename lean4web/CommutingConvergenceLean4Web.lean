/-- Approximation is only needed eventually in the averaging parameter. -/
theorem cauchySeq_of_eventual_approximation {E : Type*} [PseudoMetricSpace E]
    (a : ℕ → E)
    (h : ∀ ε : ℝ, 0 < ε → ∃ b : ℕ → E, CauchySeq b ∧
      ∀ᶠ n in atTop, dist (a n) (b n) ≤ ε) : CauchySeq a := by
  rw [Metric.cauchySeq_iff]
  intro ε hε
  obtain ⟨b, hb, hab⟩ := h (ε / 3) (by linarith)
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hb (ε / 3) (by linarith)
  obtain ⟨M, hM⟩ := eventually_atTop.mp hab
  refine ⟨max N M, fun m hm n hn ↦ ?_⟩
  have h1 := hM m (le_trans (le_max_right _ _) hm)
  have h2 := hM n (le_trans (le_max_right _ _) hn)
  have h3 := hN m (le_trans (le_max_left _ _) hm) n (le_trans (le_max_left _ _) hn)
  have h4 := dist_triangle (a m) (b m) (a n)
  have h5 := dist_triangle (b m) (b n) (a n)
  rw [dist_comm (b n) (a n)] at h5
  linarith

/-- A convergent error bound for each approximant suffices when its limit tends to zero. -/
theorem cauchySeq_of_asymptotic_approximation {E : Type*} [PseudoMetricSpace E]
    (a : ℕ → E) (b : ℕ → ℕ → E) (error : ℕ → ℕ → ℝ) (δ : ℕ → ℝ)
    (hb : ∀ k, CauchySeq (b k)) (hδ : Tendsto δ atTop (𝓝 0))
    (herr : ∀ k, Tendsto (error k) atTop (𝓝 (δ k)))
    (hbound : ∀ k n, dist (a n) (b k n) ≤ error k n) : CauchySeq a := by
  apply cauchySeq_of_eventual_approximation
  intro ε hε
  obtain ⟨k, hk⟩ := (hδ.eventually_lt_const hε).exists
  exact ⟨b k, hb k, ((herr k).eventually_lt_const hk).mono
    (fun n hn ↦ (hbound k n).trans hn.le)⟩

end CommutingConvergence
