theorem spectralSylvesterCost_insertion (A : Matrix n n ℂ) (hA : A.PosSemidef)
    (C : Matrix n n ℂ) :
    spectralSylvesterCost A hA.isHermitian (A * C * A) ≤
      (3 / 4 : ℝ) * ‖C‖ ^ 2 * (Matrix.trace (A ^ 3)).re := by
  have hdiag : unitaryConj (star hA.isHermitian.eigenvectorUnitary) A =
      Matrix.diagonal (fun i ↦ (hA.isHermitian.eigenvalues i : ℂ)) :=
    hA.isHermitian.conjStarAlgAut_star_eigenvectorUnitary
  unfold spectralSylvesterCost
  rw [map_mul, map_mul, hdiag, trace_cube_eq_sum_eigenvalues_cube A hA.isHermitian]
  simpa only [norm_unitaryConj] using diagonal_insertion_bound _ hA.eigenvalues_nonneg
    (unitaryConj (star hA.isHermitian.eigenvectorUnitary) C)

end CommutingConvergence
end OriginalModule56


