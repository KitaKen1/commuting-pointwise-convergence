theorem inserted_cyclic_trace_phase (A : Matrix m n ℂ) (B : Matrix n p ℂ)
    (C : Matrix p m ℂ) (D₀ : Matrix m m ℂ) (D₁ : Matrix n n ℂ) (D₂ : Matrix p p ℂ)
