namespace CommutingConvergence

variable {E : Type*} [PseudoMetricSpace E]

theorem cauchySeq_of_uniform_approximation (a : ℕ → E)
    (h : ∀ ε : ℝ, 0 < ε → ∃ b : ℕ → E, CauchySeq b ∧
      ∀ n, dist (a n) (b n) ≤ ε) : CauchySeq a := by
  rw [Metric.cauchySeq_iff]
  intro ε hε
  obtain ⟨b, hb, hab⟩ := h (ε / 3) (by linarith)
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hb (ε / 3) (by linarith)
  refine ⟨N, fun m hm n hn ↦ ?_⟩
  have htri := dist_triangle (a m) (b m) (a n)
  have htri' := dist_triangle (b m) (b n) (a n)
  have hlast : dist (b n) (a n) ≤ ε / 3 := by simpa [dist_comm] using hab n
  have hmiddle := hN m hm n hn
  have hfirst := hab m
  linarith

