    (hlo : 0 < lo) (hσ : lo ≤ σ) :
    |gaussianHeatAcceleration σ u p| ≤ ((|u| + |p|) / lo) ^ 2 + lo⁻¹ := by
  have hp : 0 < σ := lt_of_lt_of_le hlo hσ
  have hs := gaussianHeatScore_abs_le_lower σ lo u p hlo hσ
  have hn : 0 ≤ (|u| + |p|) / lo := by positivity
  have hsq : gaussianHeatScore σ u p ^ 2 ≤ ((|u| + |p|) / lo) ^ 2 := by
    have h := mul_self_le_mul_self (abs_nonneg (gaussianHeatScore σ u p)) hs
