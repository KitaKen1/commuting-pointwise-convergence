variable {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]
  [DecidableEq m] [DecidableEq n] [DecidableEq p]

theorem twoBlockGram_inserted_diagonal_lower (A : Matrix m n ℂ) (B : Matrix m p ℂ)
    (N : Matrix m m ℂ) :
    gramSylvesterCost (Aᴴ * A) (Aᴴ * N * A) +
      gramSylvesterCost (Bᴴ * B) (Bᴴ * N * B) ≤
    gramSylvesterCost (Matrix.fromBlocks (Aᴴ * A) 0 0 (Bᴴ * B))
      ((Matrix.fromCols A B)ᴴ * N * Matrix.fromCols A B) := by
  have hK : MatrixSupportedOn (Matrix.fromBlocks (Aᴴ * A) 0 0 (Bᴴ * B))
      ((Matrix.fromCols A B)ᴴ * N * Matrix.fromCols A B) := by
    intro x hx
    apply matrixSupportedOn_of_le _ _ _
      (Matrix.posSemidef_conjTranspose_mul_self (Matrix.fromCols A B))
      (twoBlockGram_le_two_blockDiagonal A B) (inserted_gram_supported _ N) x
    simp [Matrix.smul_mulVec, hx]
  have he : (Matrix.fromCols A B)ᴴ * N * Matrix.fromCols A B =
      Matrix.fromBlocks (Aᴴ * N * A) (Aᴴ * N * B) (Bᴴ * N * A) (Bᴴ * N * B) := by
    simp [Matrix.conjTranspose_fromCols_eq_fromRows_conjTranspose,
      Matrix.fromRows_mul]
  rw [he] at hK ⊢
  exact gramSylvesterCost_blockDiagonal_lower _ _ _ _ _ _
    (Matrix.posSemidef_conjTranspose_mul_self A)
    (Matrix.posSemidef_conjTranspose_mul_self B)
    (inserted_gram_supported A N) (inserted_gram_supported B N) hK

theorem twoBlockGram_cost_comparison (A : Matrix m n ℂ) (B : Matrix m p ℂ)
    (N : Matrix m m ℂ) :
    gramSylvesterCost (Aᴴ * A) (Aᴴ * N * A) +
      gramSylvesterCost (Bᴴ * B) (Bᴴ * N * B) ≤
    Real.sqrt 2 * gramSylvesterCost ((Matrix.fromCols A B)ᴴ * Matrix.fromCols A B)
      ((Matrix.fromCols A B)ᴴ * N * Matrix.fromCols A B) := by
  have hs : 0 < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)
  have h := twoBlockGram_row_cost_order A B N
  have hd := twoBlockGram_inserted_diagonal_lower A B N
  have he := (inv_mul_le_iff₀ hs).mp h
  exact hd.trans (by simpa only [mul_comm] using he)

/-- The paper's neighbor inequality with the actual two larger neighboring row Grams. -/
theorem neighbor_gram_cost_comparison (A : Matrix m n ℂ) (B : Matrix m p ℂ)
    (N : Matrix m m ℂ) (S : Matrix n n ℂ) (U : Matrix p p ℂ)
    (hS : S.PosSemidef) (hU : U.PosSemidef) (hAS : Aᴴ * A ≤ S) (hBU : Bᴴ * B ≤ U) :
    gramSylvesterCost S (Aᴴ * N * A) + gramSylvesterCost U (Bᴴ * N * B) ≤
    Real.sqrt 2 * gramSylvesterCost ((Matrix.fromCols A B)ᴴ * Matrix.fromCols A B)
      ((Matrix.fromCols A B)ᴴ * N * Matrix.fromCols A B) := by
  exact (add_le_add
    (gramSylvesterCost_antitone _ S _ (Matrix.posSemidef_conjTranspose_mul_self A)
      hS hAS (inserted_gram_supported A N))
    (gramSylvesterCost_antitone _ U _ (Matrix.posSemidef_conjTranspose_mul_self B)
      hU hBU (inserted_gram_supported B N))).trans (twoBlockGram_cost_comparison A B N)

omit [DecidableEq n] [DecidableEq p] in
theorem twoBlock_column_cost_le_single_left (A : Matrix m n ℂ) (B : Matrix m p ℂ)
    (N : Matrix n n ℂ) :
    gramSylvesterCost (A * Aᴴ + B * Bᴴ) (A * N * Aᴴ) ≤
      gramSylvesterCost (A * Aᴴ) (A * N * Aᴴ) := by
  have hA := Matrix.posSemidef_self_mul_conjTranspose A
  have hB := Matrix.posSemidef_self_mul_conjTranspose B
