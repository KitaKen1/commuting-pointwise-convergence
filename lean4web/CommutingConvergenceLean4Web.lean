  change ‖WithLp.toLp 2 (B*ᵥ(fun i ↦ x (Sum.inr i)))‖^2≤(‖B‖*‖x₁‖)^2 at h₁
  have hc₀ : ‖WithLp.toLp 2 (A*ᵥ(fun i ↦ x (Sum.inl i)))‖^2≤
