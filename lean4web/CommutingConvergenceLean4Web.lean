          (|v| * (n + 1 : ℕ)) * ((n.factorial : ℝ) * R ^ n) :=
        add_le_add (mul_le_mul_of_nonneg_left ih1 (abs_nonneg _))
          (mul_le_mul_of_nonneg_left ih0 (by positivity))
