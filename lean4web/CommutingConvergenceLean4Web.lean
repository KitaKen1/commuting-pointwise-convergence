/-- One scalar square estimate controls all derivative prefactors. -/
theorem gaussianPlanePolynomial_controls_score (lo K x y s : ℝ) (hlo : 0 < lo)
    (hs : 0 ≤ s) (hb : s ≤ (K + |x| + |y|) / lo) :
    s ^ 2 ≤ gaussianPlanePolynomial lo K x y ∧
    s ^ 2 + lo⁻¹ ≤ gaussianPlanePolynomial lo K x y ∧
    (3 / 2 : ℝ) * s ≤ 3 * gaussianPlanePolynomial lo K x y ∧
    (3 / 4 : ℝ) * (s ^ 2 + lo⁻¹) ≤ 3 * gaussianPlanePolynomial lo K x y ∧
    (9 / 4 : ℝ) * s ^ 2 + (3 / 2 : ℝ) * lo⁻¹ ≤ 3 * gaussianPlanePolynomial lo K x y := by
  have hsq := mul_self_le_mul_self hs hb
  have hi : 0 ≤ lo⁻¹ := inv_nonneg.mpr hlo.le
  unfold gaussianPlanePolynomial
  constructor
  · nlinarith only [hsq, hi]
  constructor
  · nlinarith only [hsq]
  constructor
  · nlinarith only [hsq, hi, sq_nonneg (s - 1)]
  constructor
  · nlinarith only [hsq, hi, sq_nonneg s]
  · nlinarith only [hsq, hi, sq_nonneg s]

