  have heP : gaussianWeightedColumnEnergy R h σ u = gaussianWeightedEnergy Rᴴ h σ u :=
    funext fun q ↦ gaussianWeightedColumnEnergy_eq_adjoint R h σ u q hh.le
  have heV : (fun τ ↦ gaussianWeightedColumnEnergy R h τ u p) =
      fun τ ↦ gaussianWeightedEnergy Rᴴ h τ u p :=
    funext fun τ ↦ gaussianWeightedColumnEnergy_eq_adjoint R h τ u p hh.le
  rw [heP, heV]
