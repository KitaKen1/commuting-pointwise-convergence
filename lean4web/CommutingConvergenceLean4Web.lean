  exact (add_le_add (add_le_add a₁ b₁) c₁).trans_eq (by unfold gaussianNarrowThreeStarRowIntegral; ring)

theorem gaussianInsertedCyclicTrace_plane_norm_le (a b c : ℕ)
    (ha : 1 ≤ a) (hb : 1 ≤ b) (hc : 1 ≤ c) (h L : ℝ)
