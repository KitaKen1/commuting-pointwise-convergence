def cyclicStarRotate : n⊕(p⊕m) ≃ m⊕(n⊕p) where
  toFun | .inl i => .inr (.inl i) | .inr (.inl i) => .inr (.inr i) | .inr (.inr i) => .inl i
  invFun | .inl i => .inr (.inr i) | .inr (.inl i) => .inl i | .inr (.inr i) => .inr (.inl i)
  left_inv := by intro i; rcases i with i | (i | i) <;> rfl
  right_inv := by intro i; rcases i with i | (i | i) <;> rfl

def cyclicStarRotateTwice : p⊕(m⊕n) ≃ m⊕(n⊕p) where
  toFun | .inl i => .inr (.inr i) | .inr (.inl i) => .inl i | .inr (.inr i) => .inr (.inl i)
  invFun | .inl i => .inr (.inl i) | .inr (.inl i) => .inr (.inr i) | .inr (.inr i) => .inl i
  left_inv := by intro i; rcases i with i | (i | i) <;> rfl
  right_inv := by intro i; rcases i with i | (i | i) <;> rfl

omit [Fintype m] [Fintype n] [Fintype p] [DecidableEq m] [DecidableEq n] [DecidableEq p] in
theorem cyclicBlockInsertion_rotate (D₀ : Matrix m m ℂ) (D₁ : Matrix n n ℂ) (D₂ : Matrix p p ℂ) :
