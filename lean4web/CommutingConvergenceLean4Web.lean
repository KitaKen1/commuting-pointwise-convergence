theorem weighted_kernel_moment (k : ℕ) :
    (∫ x, x ^ k * kernelMultiplier x ∂standardGaussian) =
      (4 / 3) * (∫ x, x ^ k ∂standardGaussian) +
      (1 / 2) * (∫ x, x ^ (k + 1) ∂standardGaussian) -
      (1 / 3) * (∫ x, x ^ (k + 2) ∂standardGaussian) := by
  have heq : (fun x : ℝ ↦ x ^ k * kernelMultiplier x) =
      (fun x : ℝ ↦ (4 / 3) * x ^ k + (1 / 2) * x ^ (k + 1) -
        (1 / 3) * x ^ (k + 2)) := by
    funext x
    simp only [kernelMultiplier, pow_add]
