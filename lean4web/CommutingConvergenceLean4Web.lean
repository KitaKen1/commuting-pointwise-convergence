theorem unimodalMeshEnvelope_dominates (f : ℝ → ℝ) (p h M u x : ℝ)
    (hf : ∀ x, 0 ≤ f x) (hM : ∀ x, f x ≤ M)
    (hL : MonotoneOn f (Iic p)) (hR : AntitoneOn f (Ici p))
