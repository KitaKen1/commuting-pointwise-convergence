  rw [trace_rpow_rectangular_grams_eq,
    densityGram_eq_rowScaleGram Rᴴ (gaussianDensityWeights h σ u p) hw]
  simp only [rowScaleGram, Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose,
    Matrix.diagonal_conjTranspose, hs, Matrix.mul_assoc]

/-- The original column-Gram energy has the same actual heat derivative as the adjoint row Gram. -/
theorem gaussianWeightedColumnEnergy_heat_eq (R : Matrix m n ℂ) (h σ : ℝ)
    (u : n → ℝ) (p : ℝ) (hh : 0 < h) (hσ : 0 < σ) :
    2 * deriv (fun τ ↦ gaussianWeightedColumnEnergy R h τ u p) σ =
      deriv (deriv (gaussianWeightedColumnEnergy R h σ u)) p -
